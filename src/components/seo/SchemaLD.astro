---
import { siteConfig, getFaqItems } from '../../data/siteConfig';
import locations from '../../data/locations.json';
import products from '../../data/products.json';

export interface Props {
  city?: string;
  url?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  url = Astro.url?.href || siteConfig.siteUrl,
} = Astro.props;

const baseUrl = siteConfig.siteUrl.replace(/\/$/, '');
const cleanUrl = url.replace(/\/$/, '') || baseUrl;
const isAreaPage = cleanUrl.includes('/area/');
const faqItems = getFaqItems(city);

const areaServedList = Array.from(
  new Set([
    city,
    'Tangerang',
    'Tangerang Selatan',
    'BSD & Serpong',
    'DKI Jakarta',
    'Jakarta Barat',
    'Jakarta Selatan',
    'Jakarta Pusat',
    'Jakarta Utara',
    'Jakarta Timur',
    'Surabaya',
    'Gresik',
    'Sidoarjo',
    'Bekasi & Cikarang',
    'Depok & Bogor',
    ...locations.map((loc) => loc.cityName),
  ])
).map((cityName) => ({
  '@type': 'City',
  name: cityName,
}));

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${baseUrl}/#website`,
  name: siteConfig.businessName,
  alternateName: [
    'Central Scaffolding',
    'Sewa Scaffolding & Beli Scaffolding SNI',
    'Central Scaffolding Indonesia',
    'Pusat Sewa Scaffolding Tangerang Jakarta Surabaya',
  ],
  url: baseUrl,
  inLanguage: 'id-ID',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${cleanUrl}/#breadcrumb`,
  itemListElement: isAreaPage
    ? [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Beranda',
          item: baseUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: `Sewa & Beli Scaffolding ${city}`,
          item: cleanUrl,
        },
      ]
    : [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Beranda Central Scaffolding',
          item: baseUrl,
        },
      ],
};

const offerCatalogSchema = {
  '@type': 'OfferCatalog',
  name: `Katalog Layanan Sewa & Beli Scaffolding Standar SNI — ${city}`,
  itemListElement: [
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: `Layanan Sewa Scaffolding Set Lengkap 1,90m & 1,70m (${city})`,
        description: `Jasa sewa perancah besi Main Frame 1,90m & 1,70m, Cross Brace 2,20m, dan Join Pin di ${city}. Ready stok 10.000+ set, kirim cepat 1-3 jam, bisa bayar COD di lokasi proyek.`,
        provider: {
          '@id': `${baseUrl}/#organization`,
        },
      },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: `Layanan Sewa Aksesoris & Pijakan Kerja Scaffolding K3 (${city})`,
        description: `Rental Catwalk (bordes pijakan anti-slip), Tangga Scaffolding (Stairs), Roda Caster Heavy Duty dengan rem, U-Head Jack, dan Jackbase di ${city}.`,
        provider: {
          '@id': `${baseUrl}/#organization`,
        },
      },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: `Penjualan Scaffolding Baru Standar SNI & K3 Kemnaker (${city})`,
        description: `Tempat beli scaffolding baru pipa baja tebal ${siteConfig.stats.pipeThickness} berstandar SNI langsung dari gudang pusat di ${city}.`,
        provider: {
          '@id': `${baseUrl}/#organization`,
        },
      },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: `Penjualan Scaffolding Bekas / Second Rekondisi Berkualitas (${city})`,
        description: `Tempat beli scaffolding second siap pakai, kokoh, presisi, dan hemat biaya untuk proyek konstruksi di ${city}.`,
        provider: {
          '@id': `${baseUrl}/#organization`,
        },
      },
    },
    ...products.map((item) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: `Sewa & Pengadaan ${item.name} (${city})`,
        description: `${item.description} Tersedia opsi sewa dan beli baru/second. Spesifikasi: ${item.specs.dimensions}, ${item.specs.pipeDiameter}, ${item.specs.thickness}.`,
        image: `${baseUrl}${item.imageUrl}`,
        provider: {
          '@id': `${baseUrl}/#organization`,
        },
      },
    })),
  ],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${baseUrl}/#organization`,
  name: `${siteConfig.businessName} — Pusat Sewa Scaffolding & Beli Scaffolding ${city}`,
  description: siteConfig.tagline,
  slogan: 'Pusat Sewa Scaffolding, Beli & Jual Scaffolding Standar SNI — Ready 10.000+ Set Siap Kirim 1-3 Jam',
  knowsAbout: [
    'Scaffolding',
    'Sewa Scaffolding',
    'Beli Scaffolding',
    'Jual Scaffolding',
    'Rental Scaffolding',
    'Steger Besi Standar SNI',
    'Main Frame Scaffolding 1,90m & 1,70m',
  ],
  hasMap: siteConfig.warehouseAddress.gmapsUrl,
  url: cleanUrl,
  telephone: `+${siteConfig.whatsappNumber}`,
  email: siteConfig.email,
  priceRange: 'Rp',
  image: [
    `${baseUrl}/og-banner.jpg`,
    `${baseUrl}${siteConfig.images.heroTruck.split('?')[0]}`,
    `${baseUrl}${siteConfig.images.logo}`,
  ],
  logo: `${baseUrl}${siteConfig.images.logo}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.warehouseAddress.street,
    addressLocality: siteConfig.warehouseAddress.district,
    addressRegion: `${siteConfig.warehouseAddress.city}, ${siteConfig.warehouseAddress.province}`,
    postalCode: siteConfig.warehouseAddress.postalCode,
    addressCountry: siteConfig.warehouseAddress.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteConfig.warehouseAddress.coordinates.latitude,
    longitude: siteConfig.warehouseAddress.coordinates.longitude,
  },
  areaServed: areaServedList,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
        'Sunday',
      ],
      opens: '07:00',
      closes: '18:00',
    },
  ],
  hasOfferCatalog: offerCatalogSchema,
  sameAs: [
    siteConfig.social.instagram,
    siteConfig.social.tokopedia,
  ],
};

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const structuredData = [
  websiteSchema,
  breadcrumbSchema,
  localBusinessSchema,
  faqPageSchema,
];
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(structuredData)}
/>
