---
import { siteConfig, getFaqItems } from '../../data/siteConfig';
import locations from '../../data/locations.json';

export interface Props {
  city?: string;
  url?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  url = Astro.url?.href || siteConfig.siteUrl,
} = Astro.props;

const baseUrl = siteConfig.siteUrl.replace(/\/$/, '');
const cleanUrl = url.replace(/\/$/, '') || baseUrl;
const isAreaPage = cleanUrl.includes('/area/');
const faqItems = getFaqItems(city);

const areaServedList = Array.from(
  new Set([
    city,
    'Tangerang',
    'Tangerang Selatan',
    'BSD & Serpong',
    'DKI Jakarta',
    'Jakarta Barat',
    'Jakarta Selatan',
    'Jakarta Pusat',
    'Jakarta Utara',
    'Jakarta Timur',
    'Bekasi & Cikarang',
    'Depok & Bogor',
    ...locations.map((loc) => loc.cityName),
  ])
).map((cityName) => ({
  '@type': 'City',
  name: cityName,
}));

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${baseUrl}/#website`,
  name: siteConfig.businessName,
  alternateName: [
    'Central Scaffolding',
    'Sewa Scaffolding & Beli Scaffolding SNI',
    'Central Scaffolding Indonesia',
    'Pusat Sewa Scaffolding Tangerang & Jabodetabek',
  ],
  url: baseUrl,
  inLanguage: 'id-ID',
};

// Breadcrumbs are only valid according to Google Search Central when there are >= 2 items (hierarchy).
// Single-item breadcrumbs on root homepage trigger rich results invalidity.
const breadcrumbSchema = isAreaPage
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      '@id': `${cleanUrl}/#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Beranda',
          item: baseUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: `Sewa & Beli Scaffolding ${city}`,
          item: cleanUrl,
        },
      ],
    }
  : null;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${baseUrl}/#organization`,
  name: `${siteConfig.businessName} — Pusat Sewa Scaffolding & Beli Scaffolding ${city}`,
  description: siteConfig.tagline,
  slogan: 'Pusat Sewa Scaffolding, Beli & Jual Scaffolding Standar SNI — Ready 10.000+ Set Siap Kirim 1-3 Jam',
  knowsAbout: [
    'Scaffolding',
    'Sewa Scaffolding',
    'Beli Scaffolding',
    'Jual Scaffolding',
    'Rental Scaffolding',
    'Steger Besi Standar SNI',
    'Main Frame Scaffolding 1,90m & 1,70m',
    'Ladder Frame 0,90m',
    'Cross Brace 2,20m',
    'Catwalk Pijakan Steger',
    'Tangga Scaffolding (Stairs)',
    'Roda Scaffolding Caster Heavy Duty',
    'U-Head Jack & Jack Base',
  ],
  hasMap: siteConfig.warehouseAddress.gmapsUrl,
  url: cleanUrl,
  telephone: `+${siteConfig.whatsappNumber}`,
  email: siteConfig.email,
  priceRange: 'Rp',
  image: [
    `${baseUrl}/og-banner.jpg`,
    `${baseUrl}${siteConfig.images.heroTruck.split('?')[0]}`,
    `${baseUrl}${siteConfig.images.logo}`,
  ],
  logo: `${baseUrl}${siteConfig.images.logo}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.warehouseAddress.street,
    addressLocality: siteConfig.warehouseAddress.district,
    addressRegion: `${siteConfig.warehouseAddress.city}, ${siteConfig.warehouseAddress.province}`,
    postalCode: siteConfig.warehouseAddress.postalCode,
    addressCountry: siteConfig.warehouseAddress.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteConfig.warehouseAddress.coordinates.latitude,
    longitude: siteConfig.warehouseAddress.coordinates.longitude,
  },
  areaServed: areaServedList,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
        'Sunday',
      ],
      opens: '07:00',
      closes: '18:00',
    },
  ],
  sameAs: [
    siteConfig.social.instagram,
    siteConfig.social.tokopedia,
  ],
};

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const structuredData = [
  websiteSchema,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  localBusinessSchema,
  faqPageSchema,
];
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(structuredData)}
/>
