---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
}

const {
  city = siteConfig.warehouseAddress.city,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya harga & sewa/beli scaffolding untuk proyek di ${city}.`
);
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMessage}`;
---

<!-- Header / Navbar Ringkas & Elegan (Tema Merah Central Scaffolding) -->
<header>
  <nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-in-out navbar-default" id="navbar">
    <div class="container mx-auto px-4">
      <div class="flex items-center justify-between h-20">
        <!-- Logo -->
        <div class="flex-shrink-0">
          <a class="flex items-center space-x-3 group" href="/" title="Central Scaffolding Beranda">
            <!-- Logo Image / Badge Resmi -->
            <div class="w-12 h-12 flex items-center justify-center bg-white rounded-lg p-1.5 shadow-md flex-shrink-0 group-hover:scale-105 transition-transform">
              <img
                src="/images/logo-icon-transparent.png"
                alt="Central Scaffolding Logo"
                class="w-full h-full object-contain"
                width="48"
                height="48"
              />
            </div>
            <!-- Logo Text -->
            <div class="hidden sm:block">
              <span class="block text-lg font-montserrat font-bold text-white tracking-tight">
                CENTRAL SCAFFOLDING
              </span>
              <span class="block text-xs font-roboto text-red-400 font-medium -mt-0.5">
                Sewa &amp; Jual Scaffolding SNI
              </span>
            </div>
          </a>
        </div>

        <!-- Desktop Navigation Menu Ringkas (4 Menu Esensial) -->
        <div class="hidden lg:flex items-center space-x-8 font-montserrat">
          <a class="text-white hover:text-red-500 font-medium transition-colors duration-300 relative group text-base font-bold" href="#products">
            Produk
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-red-600 transition-all duration-300 group-hover:w-full"></span>
          </a>
          <a class="text-white hover:text-red-500 font-medium transition-colors duration-300 relative group text-base" href="#layanan-lokal">
            Area Layanan
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-red-600 transition-all duration-300 group-hover:w-full"></span>
          </a>
          <a class="text-white hover:text-red-500 font-medium transition-colors duration-300 relative group text-base" href="#about">
            Tentang Kami
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-red-600 transition-all duration-300 group-hover:w-full"></span>
          </a>
          <a class="text-white hover:text-red-500 font-medium transition-colors duration-300 relative group text-base" href="#contact">
            Kontak &amp; Gudang
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-red-600 transition-all duration-300 group-hover:w-full"></span>
          </a>
        </div>

        <!-- CTA Button & Mobile Menu Button -->
        <div class="flex items-center space-x-4 font-montserrat">
          <!-- CTA Button Merah Industrial -->
          <a
            class="hidden md:inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105 btn-hover shadow-md text-sm"
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-source="navbar_cta"
            data-wa-mode="SEWA & BELI"
            data-wa-city={city}
          >
            <i class="fab fa-whatsapp text-lg"></i>
            <span>Hubungi Kami</span>
          </a>

          <!-- Mobile Menu Button -->
          <button class="lg:hidden text-white p-2 focus:outline-none" id="mobile-menu-btn" aria-label="Toggle Menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu Drawer Ringkas -->
      <div class="lg:hidden hidden bg-black/95 backdrop-blur-md rounded-lg mt-2 p-5 mobile-menu-enter font-montserrat shadow-2xl border border-white/10" id="mobile-menu">
        <div class="flex flex-col space-y-4">
          <a class="text-white hover:text-red-500 font-medium py-2 transition-colors duration-300" href="#products">
            Produk Scaffolding
          </a>
          <a class="text-white hover:text-red-500 font-medium py-2 transition-colors duration-300" href="#layanan-lokal">
            Area Layanan
          </a>
          <a class="text-white hover:text-red-500 font-medium py-2 transition-colors duration-300" href="#about">
            Tentang Kami
          </a>
          <a class="text-white hover:text-red-500 font-medium py-2 transition-colors duration-300" href="#contact">
            Kontak &amp; Gudang
          </a>
          <hr class="border-gray-700 my-2" />
          <a
            class="flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white px-6 py-3.5 rounded-lg font-semibold text-center transition-all duration-300 btn-hover shadow-md"
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class="fab fa-whatsapp text-lg"></i>
            <span>Hubungi Kami</span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  // Navbar scroll background toggle
  const navbar = document.getElementById('navbar');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function checkScroll() {
    if (navbar) {
      if (window.scrollY > 40) {
        navbar.classList.add('navbar-scrolled');
        navbar.classList.remove('navbar-default');
      } else {
        navbar.classList.remove('navbar-scrolled');
        navbar.classList.add('navbar-default');
      }
    }
  }

  window.addEventListener('scroll', checkScroll);
  checkScroll();

  // Mobile menu toggle
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    // Close mobile menu on anchor click
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>
