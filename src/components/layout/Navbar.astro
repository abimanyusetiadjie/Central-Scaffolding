---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
}

const {
  city = siteConfig.warehouseAddress.city,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya harga & sewa/beli scaffolding untuk proyek di ${city}.`
);
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMessage}`;
---

<!-- Header / Navbar Ringkas & Elegan (Tema Merah Central Scaffolding) -->
<header>
  <nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-in-out navbar-default" id="navbar">
    <div class="container mx-auto px-4">
      <div class="flex items-center justify-between h-20">
        <!-- Logo -->
        <div class="flex-shrink-0">
          <a class="flex items-center space-x-3 group" href="/" title="Central Scaffolding Beranda">
            <!-- Logo Image / Badge Resmi -->
            <div class="w-12 h-12 flex items-center justify-center bg-white rounded-lg p-1.5 shadow-md flex-shrink-0 group-hover:scale-105 transition-transform">
              <picture class="w-full h-full flex items-center justify-center">
                <source srcset="/assets/img/logo-icon-transparent.webp" type="image/webp" />
                <img
                  src="/assets/img/logo-icon-transparent.png"
                  alt={`Logo resmi ${siteConfig.businessName} pusat sewa dan jual scaffolding SNI di ${city}`}
                  class="w-full h-full object-contain"
                  width="48"
                  height="48"
                  loading="eager"
                  decoding="async"
                />
              </picture>
            </div>
            <!-- Logo Text (Responsif Mobile & Desktop) -->
            <div class="flex flex-col">
              <span class="block text-sm sm:text-lg font-montserrat font-bold text-white tracking-tight leading-tight group-hover:text-red-400 transition-colors">
                CENTRAL SCAFFOLDING
              </span>
              <span class="block text-[10px] sm:text-xs font-roboto text-red-400 font-medium">
                Sewa &amp; Jual Scaffolding SNI
              </span>
            </div>
          </a>
        </div>

        <!-- Desktop Navigation Menu Ringkas (Hover Effect Responsif Saat Di-scroll) -->
        <div class="hidden lg:flex items-center space-x-2 font-montserrat">
          <a class="text-white hover:text-white hover:bg-white/10 px-3.5 py-2 rounded-lg font-medium transition-all duration-300 relative group text-base font-bold" href="#products">
            <span>Produk</span>
            <span class="absolute bottom-1 left-3.5 right-3.5 h-0.5 bg-red-600 transition-all duration-300 w-0 group-hover:w-[calc(100%-1.75rem)]"></span>
          </a>
          <a class="text-white hover:text-white hover:bg-white/10 px-3.5 py-2 rounded-lg font-medium transition-all duration-300 relative group text-base" href="#layanan-lokal">
            <span>Area Layanan</span>
            <span class="absolute bottom-1 left-3.5 right-3.5 h-0.5 bg-red-600 transition-all duration-300 w-0 group-hover:w-[calc(100%-1.75rem)]"></span>
          </a>
          <a class="text-white hover:text-white hover:bg-white/10 px-3.5 py-2 rounded-lg font-medium transition-all duration-300 relative group text-base" href="#about">
            <span>Tentang Kami</span>
            <span class="absolute bottom-1 left-3.5 right-3.5 h-0.5 bg-red-600 transition-all duration-300 w-0 group-hover:w-[calc(100%-1.75rem)]"></span>
          </a>
          <a class="text-white hover:text-white hover:bg-white/10 px-3.5 py-2 rounded-lg font-medium transition-all duration-300 relative group text-base" href="#contact">
            <span>Kontak &amp; Gudang</span>
            <span class="absolute bottom-1 left-3.5 right-3.5 h-0.5 bg-red-600 transition-all duration-300 w-0 group-hover:w-[calc(100%-1.75rem)]"></span>
          </a>
        </div>

        <!-- CTA Button & Mobile Menu Button -->
        <div class="flex items-center space-x-4 font-montserrat">
          <!-- CTA Button WhatsApp Hijau -->
          <a
            class="hidden md:inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105 btn-hover shadow-md text-sm active:scale-95"
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-source="navbar_cta"
            data-wa-mode="SEWA & BELI"
            data-wa-city={city}
          >
            <i class="fab fa-whatsapp text-lg"></i>
            <span>Hubungi Kami</span>
          </a>

          <!-- Mobile Menu Button -->
          <button class="lg:hidden text-white p-2 focus:outline-none hover:bg-white/10 rounded-lg transition-colors" id="mobile-menu-btn" aria-label="Toggle Menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu Drawer Ringkas -->
      <div class="lg:hidden hidden bg-black/95 backdrop-blur-md rounded-lg mt-2 p-5 mobile-menu-enter font-montserrat shadow-2xl border border-white/10" id="mobile-menu">
        <div class="flex flex-col space-y-4">
          <a class="text-white hover:text-red-400 font-medium py-2 px-3 rounded-md hover:bg-white/10 transition-colors duration-200" href="#products">
            Produk Scaffolding
          </a>
          <a class="text-white hover:text-red-400 font-medium py-2 px-3 rounded-md hover:bg-white/10 transition-colors duration-200" href="#layanan-lokal">
            Area Layanan
          </a>
          <a class="text-white hover:text-red-400 font-medium py-2 px-3 rounded-md hover:bg-white/10 transition-colors duration-200" href="#about">
            Tentang Kami
          </a>
          <a class="text-white hover:text-red-400 font-medium py-2 px-3 rounded-md hover:bg-white/10 transition-colors duration-200" href="#contact">
            Kontak &amp; Gudang
          </a>
          <hr class="border-gray-700 my-2" />
          <a
            class="flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white px-6 py-3.5 rounded-lg font-semibold text-center transition-all duration-300 btn-hover shadow-md"
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class="fab fa-whatsapp text-lg"></i>
            <span>Hubungi Kami</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll Progress Indicator Bar -->
    <div class="h-0.5 bg-red-600 w-0 transition-all duration-150 opacity-90" id="scroll-progress"></div>
  </nav>
</header>

<script>
  const navbar = document.getElementById('navbar');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const progressBar = document.getElementById('scroll-progress');

  function checkScroll() {
    if (navbar) {
      if (window.scrollY > 40) {
        navbar.classList.add('navbar-scrolled');
        navbar.classList.remove('navbar-default');
      } else {
        navbar.classList.remove('navbar-scrolled');
        navbar.classList.add('navbar-default');
      }
    }

    if (progressBar) {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      progressBar.style.width = scrolled + '%';
    }
  }

  window.addEventListener('scroll', checkScroll, { passive: true });
  checkScroll();

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>
