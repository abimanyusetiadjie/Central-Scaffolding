---
import { siteConfig } from '../../data/siteConfig';
import { MessageCircle } from 'lucide-react';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
}

const {
  city = siteConfig.warehouseAddress.city,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya harga & sewa/beli scaffolding untuk proyek di ${city}.`
);
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMessage}`;
---

<!-- HEADER / NAVBAR (SAMA PERSIS DENGAN PT SNI) -->
<header>
  <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 ease-in-out navbar-scrolled">
    <div class="container mx-auto px-4">
      <div class="flex items-center justify-between h-20">
        <!-- Logo -->
        <div class="flex-shrink-0">
          <a href="/" class="flex items-center space-x-3 group">
            <div class="w-11 h-11 bg-orange-600 rounded-lg flex items-center justify-center text-white font-montserrat font-black text-xl shadow-md shrink-0">
              CS
            </div>
            <div class="flex flex-col">
              <span class="block text-base sm:text-lg font-montserrat font-bold text-white tracking-tight">
                PT. CENTRAL SCAFFOLDING INDONESIA
              </span>
              <span class="text-[11px] font-roboto text-orange-400 font-medium">
                Sewa &amp; Jual Scaffolding {city}
              </span>
            </div>
          </a>
        </div>

        <!-- Desktop Navigation Menu (Montserrat) -->
        <div class="hidden lg:flex items-center space-x-8 font-montserrat">
          <a href="/" class="text-white hover:text-orange-500 font-semibold transition-colors duration-300 relative group text-base">
            Home
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-orange-500 transition-all duration-300 group-hover:w-full"></span>
          </a>
          <a href="#layanan-lokal" class="text-white hover:text-orange-500 font-medium transition-colors duration-300 relative group text-base">
            Layanan
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-orange-500 transition-all duration-300 group-hover:w-full"></span>
          </a>
          <a href="#about" class="text-white hover:text-orange-500 font-medium transition-colors duration-300 relative group text-base">
            Tentang Kami
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-orange-500 transition-all duration-300 group-hover:w-full"></span>
          </a>
          <a href="#products" class="text-white hover:text-orange-500 font-medium transition-colors duration-300 relative group text-base">
            Produk
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-orange-500 transition-all duration-300 group-hover:w-full"></span>
          </a>
          <a href="#projects" class="text-white hover:text-orange-500 font-medium transition-colors duration-300 relative group text-base">
            Proyek
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-orange-500 transition-all duration-300 group-hover:w-full"></span>
          </a>
          <a href="#contact" class="text-white hover:text-orange-500 font-medium transition-colors duration-300 relative group text-base">
            Kontak
            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-orange-500 transition-all duration-300 group-hover:w-full"></span>
          </a>
        </div>

        <!-- CTA Button & Mobile Menu Button -->
        <div class="flex items-center space-x-4 font-montserrat">
          <!-- CTA Button Oranye Khas PT SNI -->
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-orange-600 hover:bg-orange-700 text-white px-5 py-2.5 sm:px-6 sm:py-3 rounded-lg font-semibold text-sm transition-all duration-300 transform hover:scale-105 btn-hover shadow-md"
            data-wa-source="navbar_cta"
            data-wa-mode="SEWA & BELI"
            data-wa-city={city}
          >
            <MessageCircle className="w-4 h-4 fill-current shrink-0" />
            <span>Hubungi Kami</span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>