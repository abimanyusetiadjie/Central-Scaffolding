---
import { siteConfig } from '../../data/siteConfig';
import { Phone, MessageCircle } from 'lucide-react';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
}

const {
  city = siteConfig.warehouseAddress.city,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya ketersediaan & harga Sewa / Beli Scaffolding untuk proyek di ${city}.`
);
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMessage}`;
---

<!-- MAIN HEADER STICKY -->
<header class="sticky top-0 z-50 bg-[#1e3a8a] text-white border-b-4 border-[#00236f] shadow-md">
  <div class="h-20 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-3">
    <!-- Brand Logo & Name -->
    <a href="/" class="flex items-center gap-3 shrink-0 group">
      <img
        alt={`Logo ${siteConfig.businessName}`}
        class="h-11 sm:h-12 w-auto object-contain bg-white p-1 rounded-lg border-2 border-slate-200 shadow-sm"
        src={siteConfig.images.logo}
        width="168"
        height="48"
        loading="eager"
      />
      <div class="flex flex-col">
        <span class="text-base sm:text-xl md:text-2xl font-extrabold uppercase tracking-tight text-white leading-none">
          {siteConfig.businessName.toUpperCase()}
        </span>
        <span class="text-[10px] sm:text-xs uppercase tracking-wider text-green-300 font-bold mt-1">
          SEWA &amp; JUAL SCAFFOLDING SNI // {city.toUpperCase()}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden xl:flex items-center gap-6 font-bold text-sm uppercase text-slate-100" aria-label="Navigasi Utama">
      <a class="hover:text-[#FACC15] transition-colors" href="/">BERANDA</a>
      <a class="hover:text-[#FACC15] transition-colors" href="#sewa-atau-beli">SEWA &amp; BELI</a>
      <a class="hover:text-[#FACC15] transition-colors" href="#paket-hemat">PAKET HEMAT</a>
      <a class="hover:text-[#FACC15] transition-colors" href="#katalog-produk">KATALOG PRODUK</a>
      <a class="hover:text-[#FACC15] transition-colors" href="#lokasi-gudang">LOKASI GUDANG</a>
      <a class="hover:text-[#FACC15] transition-colors" href="#faq">FAQ</a>
    </nav>

    <!-- Header Action Buttons -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <!-- WhatsApp (Hidden on small mobile, visible sm+) -->
      <a
        class="hidden sm:inline-flex items-center gap-2 bg-[#16A34A] hover:bg-[#15803D] text-white px-3.5 py-2.5 rounded-lg border-2 border-green-800 shadow-sm font-bold text-sm transition-all"
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-source="navbar_cta"
        data-wa-mode="SEWA & BELI"
        data-wa-city={city}
      >
        <MessageCircle className="w-5 h-5 shrink-0" />
        <span class="hidden md:inline">WHATSAPP 24 JAM</span>
        <span class="md:hidden">WA 24 JAM</span>
      </a>

      <!-- Telepon Gudang (Shortened on mobile to avoid overflow) -->
      <a
        class="min-h-[44px] inline-flex items-center gap-2 bg-[#FACC15] hover:bg-[#EAB308] text-slate-900 font-bold px-3.5 sm:px-4 py-2.5 rounded-lg border-2 border-yellow-700 shadow-sm text-sm uppercase transition-all"
        href={`tel:${siteConfig.phone}`}
        aria-label={`Telepon Gudang: ${siteConfig.phoneDisplay}`}
      >
        <Phone className="w-5 h-5 shrink-0 text-slate-900" />
        <span class="hidden md:inline font-extrabold">{siteConfig.phoneDisplay}</span>
        <span class="md:hidden font-extrabold">TELEPON</span>
      </a>
    </div>
  </div>
</header>
