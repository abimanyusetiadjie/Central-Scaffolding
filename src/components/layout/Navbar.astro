---
import { siteConfig } from '../../data/siteConfig';
import { Phone, MessageCircle, Clock, MapPin } from 'lucide-react';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
}

const {
  city = siteConfig.warehouseAddress.city,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya harga & sewa/beli scaffolding untuk proyek di ${city}.`
);
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMessage}`;
---

<!-- TOP CONTACT BAR (GAYA PT SNI) -->
<div class="bg-gray-900 text-gray-300 py-2 px-4 text-xs font-roboto border-b border-gray-800">
  <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1.5 text-gray-300">
        <MapPin className="w-3.5 h-3.5 text-orange-500 shrink-0" />
        <span>Gudang Pusat: {siteConfig.warehouseAddress.district}, {siteConfig.warehouseAddress.city}</span>
      </span>
      <span class="hidden md:flex items-center gap-1.5 text-gray-400">
        <Clock className="w-3.5 h-3.5 text-orange-400 shrink-0" />
        Buka Setiap Hari: 07.00 - 18.00 WIB
      </span>
    </div>
    <div class="flex items-center gap-4 text-xs">
      <span class="text-orange-400 font-bold hidden sm:inline">
        ✓ Stok 10.000+ Set Siap Kirim ke {city}
      </span>
      <a href={`tel:${siteConfig.phone}`} class="hover:text-white flex items-center gap-1 text-white font-bold">
        <Phone className="w-3.5 h-3.5 text-orange-500" />
        <span>Hotline: {siteConfig.phoneDisplay}</span>
      </a>
    </div>
  </div>
</div>

<!-- NAVBAR UTAMA (GAYA PT SNI: BERSIH, TEGAS, ELEGAN) -->
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-200 shadow-sm">
  <div class="h-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 shrink-0">
      <div class="w-11 h-11 rounded-lg bg-orange-600 flex items-center justify-center text-white font-montserrat font-extrabold text-xl shadow-md">
        CS
      </div>
      <div class="flex flex-col">
        <span class="text-xl sm:text-2xl font-montserrat font-extrabold text-gray-900 tracking-tight leading-none">
          CENTRAL <span class="text-orange-600">SCAFFOLDING</span>
        </span>
        <span class="text-xs font-semibold text-gray-500 mt-1 tracking-normal font-roboto">
          Sewa &amp; Jual Scaffolding {city}
        </span>
      </div>
    </a>

    <!-- Navigation Menu (Montserrat) -->
    <nav class="hidden lg:flex items-center gap-7 font-montserrat font-bold text-sm text-gray-700" aria-label="Navigasi Utama">
      <a class="hover:text-orange-600 transition-colors" href="/">Beranda</a>
      <a class="hover:text-orange-600 transition-colors" href="#layanan">Layanan</a>
      <a class="hover:text-orange-600 transition-colors" href="#paket">Paket Sewa</a>
      <a class="hover:text-orange-600 transition-colors" href="#products">Produk</a>
      <a class="hover:text-orange-600 transition-colors" href="#cara-pesan">Cara Pesan</a>
      <a class="hover:text-orange-600 transition-colors" href="#lokasi-gudang">Lokasi Gudang</a>
      <a class="hover:text-orange-600 transition-colors" href="#faq">FAQ</a>
    </nav>

    <!-- Tombol WhatsApp Oranye Khas PT SNI -->
    <div class="flex items-center gap-3 shrink-0">
      <a
        class="inline-flex items-center gap-2 bg-orange-600 hover:bg-orange-700 text-white font-montserrat font-bold text-sm px-6 py-2.5 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 transform hover:scale-105 active:scale-95"
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-source="navbar_cta"
        data-wa-mode="SEWA & BELI"
        data-wa-city={city}
      >
        <MessageCircle className="w-4 h-4 fill-current shrink-0" />
        <span>WhatsApp</span>
      </a>
    </div>
  </div>
</header>