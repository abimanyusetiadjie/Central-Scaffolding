---
import { siteConfig } from '../../data/siteConfig';
import { Phone, MessageCircle, Clock, MapPin } from 'lucide-react';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
}

const {
  city = siteConfig.warehouseAddress.city,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya harga & sewa/beli scaffolding untuk proyek di ${city}.`
);
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMessage}`;
---

<!-- TOP CONTACT BAR (Clean Industrial Benchmark) -->
<div class="bg-slate-900 text-slate-300 py-1.5 px-4 text-xs font-medium border-b border-slate-800">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1.5">
        <MapPin className="w-3.5 h-3.5 text-blue-400" />
        <span class="hidden sm:inline">Gudang Pusat:</span> {siteConfig.warehouseAddress.district}, {siteConfig.warehouseAddress.city}
      </span>
      <span class="hidden md:flex items-center gap-1.5 text-slate-400">
        <Clock className="w-3.5 h-3.5 text-amber-400" />
        Buka Setiap Hari: 07.00 - 18.00 WIB
      </span>
    </div>
    <div class="flex items-center gap-4">
      <span class="text-emerald-400 font-semibold hidden sm:inline">
        ✓ Stok Siap Kirim Hari Ini
      </span>
      <a href={`tel:${siteConfig.phone}`} class="hover:text-white flex items-center gap-1 text-slate-200 font-bold">
        <Phone className="w-3.5 h-3.5 text-emerald-400" />
        <span>Hotline: {siteConfig.phoneDisplay}</span>
      </a>
    </div>
  </div>
</div>

<!-- MAIN NAVBAR (Clean White Industrial Header) -->
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm transition-all">
  <div class="h-20 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
    <!-- Brand Logo & Name -->
    <a href="/" class="flex items-center gap-3 shrink-0 group">
      <div class="w-11 h-11 rounded-lg bg-blue-900 flex items-center justify-center text-white shadow-sm border border-blue-950/20 font-extrabold text-xl">
        CS
      </div>
      <div class="flex flex-col">
        <span class="text-lg sm:text-xl font-extrabold text-slate-900 leading-tight group-hover:text-blue-900 transition-colors">
          {siteConfig.businessName}
        </span>
        <span class="text-xs font-semibold text-slate-500">
          Sewa &amp; Jual Scaffolding {city}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-7 font-semibold text-sm text-slate-600" aria-label="Navigasi Utama">
      <a class="hover:text-blue-900 transition-colors" href="/">Beranda</a>
      <a class="hover:text-blue-900 transition-colors" href="#sewa-atau-beli">Sewa &amp; Beli</a>
      <a class="hover:text-blue-900 transition-colors" href="#paket-hemat">Paket Hemat</a>
      <a class="hover:text-blue-900 transition-colors" href="#katalog-produk">Katalog Produk</a>
      <a class="hover:text-blue-900 transition-colors" href="#lokasi-gudang">Lokasi Gudang</a>
      <a class="hover:text-blue-900 transition-colors" href="#faq">FAQ</a>
    </nav>

    <!-- Header Action Button (Clean WhatsApp CTA) -->
    <div class="flex items-center gap-3 shrink-0">
      <a
        class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm px-4 py-2.5 rounded-lg shadow-sm transition-all active:scale-95"
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-source="navbar_cta"
        data-wa-mode="SEWA & BELI"
        data-wa-city={city}
      >
        <MessageCircle className="w-4 h-4 shrink-0" />
        <span>Chat WhatsApp</span>
      </a>
    </div>
  </div>
</header>