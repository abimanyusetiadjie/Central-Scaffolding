---
import { siteConfig } from '../../data/siteConfig';
import locations from '../../data/locations.json';
import { Phone, MessageCircle, CheckCircle2, ShieldCheck } from 'lucide-react';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, minta tolong info pengiriman scaffolding dan shareloc gudang untuk proyek di ${city}.`
);
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMessage}`;
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[#00236f] border-t-4 border-[#1e3a8a] text-white mt-12 pb-24 md:pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      <!-- Col 1: Brand Logo & Description -->
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-2 mb-1">
          <img
            alt={`Logo ${siteConfig.businessName}`}
            class="h-10 w-auto object-contain bg-white p-1 rounded-lg"
            src={siteConfig.images.logo}
            width="40"
            height="40"
            loading="lazy"
          />
          <span class="text-lg sm:text-xl uppercase text-white font-extrabold tracking-tight">
            {siteConfig.businessName}
          </span>
        </div>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-medium">
          Penyedia sewa scaffolding pipa baja, ladder frame, clamp, jack base, dan perlengkapan cor berstandar SNI &amp; K3 konstruksi tebal dan teruji kokoh.
        </p>
      </div>

      <!-- Col 2: Alamat Gudang Pusat -->
      <div class="flex flex-col gap-2 border-l-2 border-white/20 pl-4">
        <span class="text-sm sm:text-base uppercase text-[#FACC15] mb-1 font-bold">
          ALAMAT GUDANG PUSAT
        </span>
        <p class="text-sm sm:text-base text-white leading-relaxed">
          {siteConfig.warehouseAddress.street}, {siteConfig.warehouseAddress.district}, Kota {siteConfig.warehouseAddress.city}, {siteConfig.warehouseAddress.province}
        </p>
        <span class="text-xs text-green-400 mt-2 font-bold uppercase">
          AREA LAYANAN CEPAT:
        </span>
        <p class="text-xs sm:text-sm text-slate-300">
          Tangerang, Jakarta Barat, Jakarta Selatan, BSD Serpong, Cikupa Balaraja, Depok, Bekasi &amp; Banten
        </p>
      </div>

      <!-- Col 3: Jam Operasional -->
      <div class="flex flex-col gap-2 border-l-2 border-white/20 pl-4">
        <span class="text-sm sm:text-base uppercase text-[#FACC15] mb-1 font-bold">
          JAM OPERASIONAL &amp; BONGKAR
        </span>
        <div class="bg-[#1e3a8a] p-3 rounded-lg border border-blue-400/30">
          <p class="text-xs uppercase text-slate-300 font-bold">
            BUKA SETIAP HARI
          </p>
          <p class="text-lg sm:text-xl text-white font-extrabold mt-0.5">
            07.00 - 18.00 WIB
          </p>
        </div>
        <p class="text-xs text-slate-300 mt-1">
          Siap kirim armada pickup &amp; truk mandiri hari ini juga.
        </p>
      </div>

      <!-- Col 4: Hubungi Mandor Logistik -->
      <div class="flex flex-col gap-2 border-l-2 border-white/20 pl-4">
        <span class="text-sm sm:text-base uppercase text-[#FACC15] mb-1 font-bold">
          HUBUNGI MANDOR LOGISTIK
        </span>
        <div class="flex flex-col gap-3">
          <a
            class="text-base sm:text-lg text-[#FACC15] hover:underline flex items-center gap-2 font-extrabold"
            href={`tel:${siteConfig.phone}`}
          >
            <Phone className="w-5 h-5 text-[#FACC15]" />
            <span>{siteConfig.phoneDisplay}</span>
          </a>
          <a
            class="text-sm sm:text-base text-green-400 hover:underline flex items-center gap-2 font-bold"
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-source="footer_wa"
            data-wa-mode="SEWA & BELI"
            data-wa-city={city}
          >
            <MessageCircle className="w-5 h-5 text-green-400" />
            <span>WhatsApp Darurat 24/7</span>
          </a>
          <span class="text-xs text-slate-300">
            Email: {siteConfig.email}
          </span>
        </div>
      </div>
    </div>

    <!-- SEO Area Links (Programmatic Local SEO Directory) -->
    <div class="border-t-2 border-white/20 pt-6 mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
        <span class="text-sm sm:text-base uppercase text-[#FACC15] font-bold">
          Wilayah Pengiriman Cepat (Jabodetabek &amp; Banten):
        </span>
        <a href="#beranda" class="text-slate-300 hover:text-white hover:underline text-xs sm:text-sm uppercase font-bold">
          Kembali ke Beranda Utama &uarr;
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-8 gap-2">
        {locations.map((loc) => (
          <a
            href={`/area/${loc.slug}`}
            class="bg-[#1e3a8a] hover:bg-[#16A34A] text-white px-3 py-2 rounded border border-blue-400/30 text-center transition-all group"
          >
            <span class="block font-bold text-xs group-hover:underline">
              {loc.cityName}
            </span>
            <span class="block text-[11px] text-[#FACC15] mt-0.5">
              {loc.deliveryEstimate.split('(')[0].trim()}
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Bottom Copyright & Certifications -->
    <div class="border-t-2 border-white/20 pt-4 flex flex-col md:flex-row items-center justify-between gap-3">
      <p class="text-xs text-slate-300 text-center md:text-left">
        &copy; {currentYear} {siteConfig.businessName} Logistik Konstruksi. SNI &amp; K3 Certified Scaffolding Specialist.
      </p>
      <div class="flex items-center gap-4">
        <span class="text-xs text-green-400 flex items-center gap-1.5 font-bold">
          <CheckCircle2 className="w-4 h-4 text-green-400" />
          SNI 07-0065
        </span>
        <span class="text-xs text-green-400 flex items-center gap-1.5 font-bold">
          <ShieldCheck className="w-4 h-4 text-green-400" />
          STANDAR K3 KEMNAKER
        </span>
      </div>
    </div>
  </div>
</footer>