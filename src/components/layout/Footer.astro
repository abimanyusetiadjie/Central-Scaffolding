---
import { siteConfig } from '../../data/siteConfig';
import locations from '../../data/locations.json';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya harga sewa / beli scaffolding untuk proyek di ${city}.`
);
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMessage}`;
const currentYear = new Date().getFullYear();
---

<!-- ==============================================
     FOOTER (TEMA MERAH CENTRAL SCAFFOLDING)
=============================================== -->
<footer class="relative text-white">
  <!-- Background Image & Overlay Hitam 85% -->
  <div class="absolute inset-0">
    <picture class="block w-full h-full">
      <source srcset="/assets/img/bg-footer.webp" type="image/webp" />
      <img
        src="/assets/img/bg-footer.jpg"
        alt="Konstruksi rangka pipa scaffolding baja galvanis standar SNI Central Scaffolding"
        width="1280"
        height="960"
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="absolute inset-0 bg-black opacity-85"></div>
  </div>

  <!-- Main Footer Content -->
  <div class="relative container mx-auto px-4 py-16">
    <div class="grid lg:grid-cols-4 md:grid-cols-2 gap-8">
      <!-- Company Info (Col-span-2 di Desktop) -->
      <div class="lg:col-span-2">
        <div class="flex items-center space-x-3 mb-6">
          <div class="w-12 h-12 bg-white rounded-lg flex items-center justify-center p-1.5 shadow-md flex-shrink-0">
            <picture class="w-full h-full flex items-center justify-center">
              <source srcset="/assets/img/logo-icon-transparent.webp" type="image/webp" />
              <img
                src="/assets/img/logo-icon-transparent.png"
                alt={`Logo resmi ${siteConfig.businessName} pusat sewa dan jual scaffolding SNI di ${city}`}
                class="w-full h-full object-contain"
                width="48"
                height="48"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
          <div>
            <p class="text-xl font-montserrat font-bold tracking-tight">
              CENTRAL SCAFFOLDING
            </p>
            <p class="text-xs text-red-400 font-roboto">
              Pusat Sewa &amp; Jual Beli Scaffolding Pipa Tebal Standar SNI
            </p>
          </div>
        </div>
        <p class="text-gray-300 mb-6 leading-relaxed max-w-md text-justify font-roboto text-sm sm:text-base">
          Pusat persewaan dan penjualan scaffolding terbesar dan terlengkap di Tangerang dan Jabodetabek.
          Kami siap memenuhi kebutuhan Anda dalam skala besar maupun kecil dengan material bersertifikat SNI dan pengiriman cepat armada sendiri.
        </p>

        <!-- Media Sosial & Marketplace Resmi Central Scaffolding -->
        <div class="flex items-center space-x-3">
          <!-- Instagram Resmi -->
          <a
            aria-label="Instagram Resmi Central Scaffolding"
            class="w-10 h-10 bg-gray-800 hover:bg-gradient-to-tr hover:from-amber-500 hover:via-pink-500 hover:to-purple-600 rounded-lg flex items-center justify-center transition-all duration-300 group shadow-sm hover:scale-105"
            href={siteConfig.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            title="Follow Instagram Resmi @central_scaffolding.id"
          >
            <i class="fab fa-instagram text-gray-300 group-hover:text-white text-lg"></i>
          </a>

          <!-- Tokopedia Official Store -->
          <a
            aria-label="Toko Tokopedia Resmi Central Scaffolding"
            class="w-10 h-10 bg-gray-800 hover:bg-[#42b549] rounded-lg flex items-center justify-center transition-all duration-300 group shadow-sm hover:scale-105 p-2"
            href={siteConfig.social.tokopedia}
            target="_blank"
            rel="noopener noreferrer"
            title="Kunjungi Toko Tokopedia Central Scaffolding"
          >
            <svg
              class="w-5 h-5 fill-gray-300 group-hover:fill-white transition-colors"
              viewBox="0 0 1024 1024"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path d="M620.4 326.4c-5.6-56.4-51.8-100.3-108-100.3-56.1 0-102.3 43.5-108.7 99.6l29.1 2.3c5.2-40.5 38.6-71.8 79.4-71.8 40.8 0 74.6 31.8 78.9 72.8l29.3-2.6zm94.3-6.5c-32 0-63.9-1.7-95.8 1.1l-29.1 2.6c-25.9 2.3-54.3 8.9-77.6 20.9-24.8-12.9-50.2-19.8-77.9-22l-29.1-2.3c-32-2.6-63.8-.4-95.8-.4h-17.5v418.3h294.4c80.4 0 146.1-67.7 146.1-150.5V319.9h-17.7zM331.4 496.1c0-48.6 38.3-88.1 85.5-88.1s85.5 39.4 85.5 88.1c0 48.6-38.3 88.1-85.5 88.1-47.3 0-85.5-39.5-85.5-88.1zM512 632.9c-12.7-13.9-25.4-27.7-38.1-41.5 8-14.2 23.1-21.3 38.1-21.2 15 0 30.1 7 38.1 21.2-12.7 13.8-25.4 27.6-38.1 41.5zm95.1-48.7c-47.2 0-85.5-39.4-85.5-88.1 0-48.6 38.3-88.1 85.5-88.1s85.5 39.4 85.5 88.1c0 48.6-38.3 88.1-85.5 88.1zM427.6 441.4c30.5 0 55.2 25.5 55.2 56.8 0 31.4-24.7 56.9-55.2 56.9-30.5 0-55.2-25.5-55.2-56.9 0-10.5 2.8-20.3 7.6-28.7 3.9 10 13.5 17.1 24.7 17.1 14.7 0 26.6-12.2 26.6-27.4 0-6.8-2.4-13-6.4-17.8h2.7zm168.8 0c30.5 0 55.2 25.5 55.2 56.8 0 31.4-24.7 56.9-55.2 56.9-30.5 0-55.2-25.5-55.2-56.9 0-10.5 2.7-20.3 7.5-28.7 4 10 13.5 17.1 24.7 17.1 14.7 0 26.6-12.2 26.6-27.4 0-6.8-2.4-13-6.4-17.8h2.8z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-montserrat font-semibold mb-6 text-red-500">
          Menu Utama
        </h3>
        <ul class="space-y-3 font-roboto text-sm">
          <li>
            <a class="text-gray-300 hover:text-red-400 transition-colors duration-300" href="/">
              Beranda
            </a>
          </li>
          <li>
            <a class="text-gray-300 hover:text-red-400 transition-colors duration-300" href="#layanan-lokal">
              Layanan Lokal
            </a>
          </li>
          <li>
            <a class="text-gray-300 hover:text-red-400 transition-colors duration-300" href="#about">
              Tentang Kami
            </a>
          </li>
          <li>
            <a class="text-gray-300 hover:text-red-400 transition-colors duration-300" href="#products">
              Produk Scaffolding
            </a>
          </li>
          <li>
            <a class="text-gray-300 hover:text-red-400 transition-colors duration-300" href="#projects">
              Proyek Terbaru
            </a>
          </li>
          <li>
            <a class="text-gray-300 hover:text-red-400 transition-colors duration-300" href="#faq">
              FAQ
            </a>
          </li>
          <li>
            <a class="text-gray-300 hover:text-red-400 transition-colors duration-300" href="#contact">
              Kontak &amp; Cabang
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-lg font-montserrat font-semibold mb-6 text-red-500">
          Kontak Kami
        </h3>
        <div class="space-y-4 font-roboto text-sm">
          <div class="flex items-start space-x-3">
            <i class="fas fa-map-marker-alt text-red-500 mt-1 text-lg flex-shrink-0"></i>
            <div>
              <p class="text-gray-300 text-sm leading-relaxed">
                {siteConfig.warehouseAddress.street}<br />
                {siteConfig.warehouseAddress.district}<br />
                Kota {siteConfig.warehouseAddress.city}, {siteConfig.warehouseAddress.province} {siteConfig.warehouseAddress.postalCode}
              </p>
            </div>
          </div>

          <!-- Telepon -->
          <div class="flex items-start space-x-3">
            <i class="fas fa-phone text-red-500 text-lg flex-shrink-0"></i>
            <div class="text-gray-300 text-sm leading-relaxed">
              <a class="hover:text-red-400 transition-colors duration-300" href={`tel:${siteConfig.phone}`}>
                {siteConfig.phoneDisplay}
              </a>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
            </svg>
            <a class="text-gray-300 hover:text-red-400 transition-colors duration-300 text-sm" href={`mailto:${siteConfig.email}`}>
              {siteConfig.email}
            </a>
          </div>

          <!-- Jam Operasional -->
          <div class="flex items-center space-x-3 pt-2">
            <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
            </svg>
            <p class="text-gray-300 text-sm leading-relaxed">
              Senin - Minggu: 07.00 - 18.00 WIB
            </p>
          </div>

          <!-- WhatsApp Button -->
          <div class="pt-2">
            <a
              class="inline-flex items-center space-x-2 bg-green-600 hover:bg-green-700 text-white px-4 py-2.5 rounded-lg text-sm font-semibold transition-colors duration-300 shadow-md font-montserrat"
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fab fa-whatsapp text-lg"></i>
              <span>WhatsApp ({siteConfig.whatsappDisplay})</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Area Layanan Sewa Scaffolding (Pill Tags Merah Hover) -->
    <div class="mt-12 pt-6 border-t border-gray-800">
      <h3 class="text-lg font-montserrat font-semibold mb-4 text-red-500">
        Area Layanan Sewa Scaffolding
      </h3>
      <ul class="flex flex-wrap gap-2">
        {locations.map((loc) => (
          <li>
            <a
              class="inline-block bg-gray-800 hover:bg-red-600 text-gray-300 hover:text-white text-xs sm:text-sm px-4 py-2 rounded-full transition-colors duration-300 font-roboto"
              href={`/area/${loc.slug}`}
            >
              Sewa Scaffolding {loc.cityName}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bottom Footer Bar -->
  <div class="border-t border-gray-800 relative">
    <div class="container mx-auto px-4 py-6">
      <div class="flex justify-center items-center">
        <div class="text-gray-400 text-xs sm:text-sm text-center font-roboto">
          &copy; {currentYear} Central Scaffolding. All rights reserved.
          <br />
          <span class="text-xs text-gray-500">
            Pusat Sewa &amp; Jual Beli Scaffolding Pipa Tebal Standar SNI 07-0065 &amp; K3 Kemnaker.
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Back to Top Button Merah -->
  <button
    class="fixed bottom-24 right-6 sm:right-8 w-12 h-12 bg-red-600 hover:bg-red-700 text-white rounded-full shadow-lg transition-all duration-300 transform hover:scale-110 opacity-0 pointer-events-none z-40 flex items-center justify-center"
    id="back-to-top"
    aria-label="Kembali ke atas"
  >
    <svg class="w-6 h-6 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path d="M5 10l7-7m0 0l7 7m-7-7v18" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
    </svg>
  </button>

  <!-- WhatsApp Floating Button Hijau -->
  <a
    class="fixed bottom-6 sm:bottom-8 right-6 sm:right-8 w-14 h-14 bg-green-500 hover:bg-green-600 text-white rounded-full shadow-2xl flex items-center justify-center transition-all duration-300 transform hover:scale-110 z-40"
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat WhatsApp Admin"
    data-wa-source="floating_wa"
  >
    <i class="fab fa-whatsapp text-3xl"></i>
  </a>
</footer>

<script>
  const backToTopButton = document.getElementById('back-to-top');
  if (backToTopButton) {
    window.addEventListener('scroll', function () {
      if (window.scrollY > 300) {
        backToTopButton.classList.remove('opacity-0', 'pointer-events-none');
        backToTopButton.classList.add('opacity-100');
      } else {
        backToTopButton.classList.add('opacity-0', 'pointer-events-none');
        backToTopButton.classList.remove('opacity-100');
      }
    });
    backToTopButton.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>