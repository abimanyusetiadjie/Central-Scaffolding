---
import { siteConfig } from '../../data/siteConfig';
import { Phone, MessageCircle } from 'lucide-react';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau order / tanya sewa & jual scaffolding untuk proyek di ${city}. Apakah armada ready kirim?`
);
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMessage}`;
---

<!-- DESKTOP FLOATING QUICK ACTION BUTTONS -->
<aside aria-label="Aksi Cepat Kontak Gudang" class="hidden lg:flex fixed bottom-6 right-6 z-40 flex-col gap-2.5">
  <a
    class="min-h-[52px] bg-[#FACC15] hover:bg-yellow-400 text-slate-900 px-5 py-2.5 rounded-xl text-base font-extrabold uppercase flex items-center gap-2 border-2 border-yellow-600 shadow-[0_4px_0_#ca8a04] active:translate-y-1 transition-all"
    href={`tel:${siteConfig.phone}`}
    aria-label={`Telepon Gudang ${siteConfig.phoneDisplay}`}
  >
    <Phone className="w-5 h-5 text-slate-900" />
    <span>TELEPON GUDANG: {siteConfig.phoneDisplay}</span>
  </a>

  <a
    class="min-h-[52px] bg-[#16A34A] hover:bg-[#15803D] text-white px-5 py-2.5 rounded-xl text-base font-extrabold uppercase flex items-center gap-2 border-2 border-green-800 shadow-[0_4px_0_#14532d] active:translate-y-1 transition-all"
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat WhatsApp 24 Jam"
    data-wa-source="floating_desktop"
    data-wa-mode="SEWA & BELI"
    data-wa-city={city}
  >
    <MessageCircle className="w-5 h-5 text-white" />
    <span>CHAT WHATSAPP 24 JAM</span>
  </a>
</aside>

<!-- MOBILE STICKY BOTTOM BAR -->
<aside aria-label="Tombol Kontak Cepat Mobile" class="md:hidden fixed bottom-0 inset-x-0 h-16 z-50 flex shadow-2xl">
  <a
    class="w-[40%] bg-[#FACC15] hover:bg-yellow-400 text-slate-900 font-extrabold flex items-center justify-center gap-1.5 border-r border-yellow-700 active:bg-yellow-500 transition-colors uppercase text-sm sm:text-base"
    href={`tel:${siteConfig.phone}`}
    aria-label="Telepon Langsung Gudang"
  >
    <Phone className="w-5 h-5 text-slate-900" />
    <span>TELEPON</span>
  </a>

  <a
    class="w-[60%] bg-[#16A34A] hover:bg-[#15803D] text-white font-extrabold flex items-center justify-center gap-1.5 active:bg-green-700 transition-colors uppercase text-sm sm:text-base"
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Pesan via WhatsApp"
    data-wa-source="mobile_bottom_bar"
    data-wa-mode="SEWA & BELI"
    data-wa-city={city}
  >
    <MessageCircle className="w-5 h-5 text-white" />
    <span>ORDER WA</span>
  </a>
</aside>