---
import { siteConfig } from '../../data/siteConfig';
import { Phone, MessageCircle } from 'lucide-react';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau order / tanya sewa & jual scaffolding untuk proyek di ${city}. Apakah armada ready kirim?`
);
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMessage}`;
---

<!-- DESKTOP FLOATING WHATSAPP PILL (HIGH TRUST INDONESIAN STANDARD) -->
<aside aria-label="Aksi Cepat Kontak Gudang" class="hidden sm:flex fixed bottom-6 right-6 z-40 items-center gap-3">
  <a
    class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-3 rounded-full font-bold text-sm flex items-center gap-2.5 shadow-lg hover:shadow-xl transition-all active:scale-95 group"
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat WhatsApp 24 Jam"
    data-wa-source="floating_desktop"
    data-wa-mode="SEWA & BELI"
    data-wa-city={city}
  >
    <div class="relative">
      <MessageCircle className="w-5 h-5 fill-current" />
      <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-amber-400 rounded-full animate-ping"></span>
      <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-amber-400 rounded-full"></span>
    </div>
    <span>Tanya Mandor via WhatsApp</span>
  </a>
</aside>

<!-- MOBILE STICKY BOTTOM BAR (ERGONOMIC & CLEAN) -->
<aside aria-label="Tombol Kontak Cepat Mobile" class="sm:hidden fixed bottom-0 inset-x-0 h-14 z-50 bg-white border-t border-slate-200 shadow-[0_-2px_10px_rgba(0,0,0,0.08)] flex items-stretch">
  <a
    class="w-[40%] bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold flex items-center justify-center gap-1.5 border-r border-slate-200 active:bg-slate-300 transition-colors text-sm"
    href={`tel:${siteConfig.phone}`}
    aria-label="Telepon Langsung Gudang"
  >
    <Phone className="w-4 h-4 text-blue-900" />
    <span>Telepon</span>
  </a>

  <a
    class="w-[60%] bg-emerald-600 hover:bg-emerald-700 text-white font-bold flex items-center justify-center gap-2 active:bg-emerald-800 transition-colors text-sm"
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Pesan via WhatsApp"
    data-wa-source="mobile_bottom_bar"
    data-wa-mode="SEWA & BELI"
    data-wa-city={city}
  >
    <MessageCircle className="w-4 h-4" />
    <span>WhatsApp Kami</span>
  </a>
</aside>