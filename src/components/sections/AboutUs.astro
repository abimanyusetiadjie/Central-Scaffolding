---
import { ShieldCheck, Truck, Banknote, RefreshCw } from 'lucide-react';

export interface Props {
  city?: string;
}
---

<!-- ==============================================
     KENAPA PILIH KAMI (4 POIN UTAMA — RINGKAS & PADAT)
=============================================== -->
<section class="py-10 sm:py-14 bg-slate-50 border-t border-slate-200" id="about">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-6 sm:mb-9">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-100/80 text-red-600 text-[11px] font-montserrat font-bold uppercase tracking-wider mb-2">
          <span>Jaminan Layanan</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-montserrat font-extrabold text-gray-900 leading-tight">
          Kenapa Kontraktor <span class="text-red-600">Pilih Kami?</span>
        </h2>
      </div>

      <!-- 4 Poin Utama: 2x2 Grid Kompak di Mobile, 4 Kolom di Desktop -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
        <!-- Poin 1 -->
        <div class="bg-white p-3.5 sm:p-5 rounded-xl border border-gray-200 shadow-xs hover:border-red-500 transition-all flex flex-col justify-between">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-red-50 text-red-600 flex items-center justify-center shrink-0 mb-2.5">
            <ShieldCheck className="w-5 h-5 text-red-600" />
          </div>
          <div>
            <h3 class="font-montserrat font-bold text-gray-900 text-xs sm:text-base mb-1">
              Pipa Tebal SNI
            </h3>
            <p class="text-[11px] sm:text-xs text-gray-600 font-roboto leading-relaxed">
              Baja 1.8–2.0 mm presisi, aman untuk beban cor beton.
            </p>
          </div>
        </div>

        <!-- Poin 2 -->
        <div class="bg-white p-3.5 sm:p-5 rounded-xl border border-gray-200 shadow-xs hover:border-red-500 transition-all flex flex-col justify-between">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-red-50 text-red-600 flex items-center justify-center shrink-0 mb-2.5">
            <Truck className="w-5 h-5 text-red-600" />
          </div>
          <div>
            <h3 class="font-montserrat font-bold text-gray-900 text-xs sm:text-base mb-1">
              Kirim 1–3 Jam
            </h3>
            <p class="text-[11px] sm:text-xs text-gray-600 font-roboto leading-relaxed">
              Armada pikap &amp; truk sendiri, langsung berangkat hari ini.
            </p>
          </div>
        </div>

        <!-- Poin 3 -->
        <div class="bg-white p-3.5 sm:p-5 rounded-xl border border-gray-200 shadow-xs hover:border-red-500 transition-all flex flex-col justify-between">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-red-50 text-red-600 flex items-center justify-center shrink-0 mb-2.5">
            <Banknote className="w-5 h-5 text-red-600" />
          </div>
          <div>
            <h3 class="font-montserrat font-bold text-gray-900 text-xs sm:text-base mb-1">
              Bisa Bayar COD
            </h3>
            <p class="text-[11px] sm:text-xs text-gray-600 font-roboto leading-relaxed">
              Barang tiba dicek mandor di proyek, cocok baru bayar.
            </p>
          </div>
        </div>

        <!-- Poin 4 -->
        <div class="bg-white p-3.5 sm:p-5 rounded-xl border border-gray-200 shadow-xs hover:border-red-500 transition-all flex flex-col justify-between">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-red-50 text-red-600 flex items-center justify-center shrink-0 mb-2.5">
            <RefreshCw className="w-5 h-5 text-red-600" />
          </div>
          <div>
            <h3 class="font-montserrat font-bold text-gray-900 text-xs sm:text-base mb-1">
              Garansi Tukar Unit
            </h3>
            <p class="text-[11px] sm:text-xs text-gray-600 font-roboto leading-relaxed">
              Ada kendala ukuran/unit langsung ditukar di hari yang sama.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
