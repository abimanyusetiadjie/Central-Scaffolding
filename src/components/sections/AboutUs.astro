---
import { siteConfig } from '../../data/siteConfig';
import { ShieldCheck, Truck, Banknote, RefreshCw } from 'lucide-react';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

// Slot foto fisik gudang utama (user dapat mengganti URL ini dengan foto gudang asli)
const warehousePhoto = '/images/stitch/warehouse-map.jpg'; // or empty string ''
---

<!-- ==============================================
     TENTANG CENTRAL SCAFFOLDING (VISUAL & RINGKAS)
=============================================== -->
<section class="py-20 bg-gray-50" id="about">
  <div class="container mx-auto px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Kolom Kiri: Frame Foto Fisik Toko & Gudang (Siap Diganti Foto User) -->
        <div class="lg:col-span-6">
          <div class="relative rounded-2xl overflow-hidden border-2 border-gray-200 shadow-xl bg-slate-200 group">
            <!-- Aspect Ratio 4:3 untuk foto gudang nyata -->
            <div class="relative aspect-[4/3] w-full flex items-center justify-center bg-gradient-to-br from-slate-100 to-slate-200">
              {warehousePhoto ? (
                <img
                  src={warehousePhoto}
                  alt="Gudang Central Scaffolding Tangerang"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
              ) : null}

              <!-- Placeholder Foto jika user ingin ganti foto nanti -->
              <div class={`w-full h-full flex flex-col items-center justify-center p-8 text-center ${warehousePhoto ? 'hidden' : 'flex'}`}>
                <div class="w-16 h-16 rounded-full bg-white text-red-600 flex items-center justify-center shadow-md mb-3 border border-red-100">
                  <i class="fas fa-warehouse text-2xl"></i>
                </div>
                <span class="text-sm font-montserrat font-bold text-gray-800 uppercase tracking-wider">
                  Foto Utama Toko / Gudang
                </span>
                <span class="text-xs text-gray-500 font-roboto mt-1">
                  (Slot foto siap diisi dokumentasi fisik Anda)
                </span>
              </div>

              <!-- Overlay Badge Kepercayaan di Foto -->
              <div class="absolute bottom-4 left-4 right-4 bg-black/80 backdrop-blur-md text-white p-3.5 rounded-xl border border-white/10 flex items-center justify-between">
                <div>
                  <p class="text-xs font-montserrat font-bold text-red-400 uppercase tracking-wider">
                    Gudang Pusat Sukasari, Tangerang
                  </p>
                  <p class="text-sm font-bold text-white mt-0.5 font-montserrat">
                    Stok 10.000+ Set Ready Tiap Hari
                  </p>
                </div>
                <span class="bg-red-600 text-white text-xs font-montserrat font-bold px-3 py-1.5 rounded-lg shadow shrink-0">
                  SNI 07-0065
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Kolom Kanan: Poin Garansi Ringkas (Tanpa Teks Bertele-tele) -->
        <div class="lg:col-span-6 flex flex-col justify-center">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-100/70 text-red-600 text-xs font-montserrat font-bold uppercase tracking-wider mb-3 w-fit">
            <span>Kenapa Pilih Kami</span>
          </div>

          <h2 class="text-3xl sm:text-4xl font-montserrat font-extrabold text-gray-900 leading-tight mb-4">
            Pusat Sewa Scaffolding <span class="text-red-600">Terpercaya &amp; Siap Kirim</span>
          </h2>

          <p class="text-base text-gray-600 font-roboto mb-6 leading-relaxed">
            Central Scaffolding melayani kontraktor, pemborong, dan mandor di {city} dengan pasokan scaffolding pipa baja presisi, aman, dan langsung kirim tanpa perantara.
          </p>

          <!-- 4 Poin Visual Ringkas -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Poin 1 -->
            <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-red-50 text-red-600 flex items-center justify-center shrink-0">
                <ShieldCheck className="w-5 h-5 text-red-600" />
              </div>
              <div>
                <h3 class="font-montserrat font-bold text-gray-900 text-sm">Pipa Tebal SNI 07-0065</h3>
                <p class="text-xs text-gray-500 font-roboto mt-0.5">Tebal 1.8mm – 2.0mm, kokoh dan lulus uji beban proyek berat.</p>
              </div>
            </div>

            <!-- Poin 2 -->
            <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-red-50 text-red-600 flex items-center justify-center shrink-0">
                <Truck className="w-5 h-5 text-red-600" />
              </div>
              <div>
                <h3 class="font-montserrat font-bold text-gray-900 text-sm">Kirim Cepat 1-3 Jam</h3>
                <p class="text-xs text-gray-500 font-roboto mt-0.5">Armada pikap &amp; truk sendiri, berangkat di hari yang sama.</p>
              </div>
            </div>

            <!-- Poin 3 -->
            <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-red-50 text-red-600 flex items-center justify-center shrink-0">
                <Banknote className="w-5 h-5 text-red-600" />
              </div>
              <div>
                <h3 class="font-montserrat font-bold text-gray-900 text-sm">Bisa Bayar COD di Proyek</h3>
                <p class="text-xs text-gray-500 font-roboto mt-0.5">Barang tiba dicek mandor, cocok dan sesuai baru pelunasan.</p>
              </div>
            </div>

            <!-- Poin 4 -->
            <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-red-50 text-red-600 flex items-center justify-center shrink-0">
                <RefreshCw className="w-5 h-5 text-red-600" />
              </div>
              <div>
                <h3 class="font-montserrat font-bold text-gray-900 text-sm">Garansi Tukar Unit</h3>
                <p class="text-xs text-gray-500 font-roboto mt-0.5">Jika ada komponen cacat saat tiba, langsung kami ganti hari itu juga.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
