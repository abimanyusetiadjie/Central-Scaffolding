---
import { siteConfig } from '../../data/siteConfig';
import { Check, MessageCircle } from 'lucide-react';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

const sewaText = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau sewa scaffolding untuk proyek di ${city}. Mohon info rincian & ketersediaan stok.`
);
const waSewaUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${sewaText}`;

const beliText = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau beli scaffolding (baru/rekondisi) untuk dikirim ke ${city}. Mohon info harga grosir & stok.`
);
const waBeliUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${beliText}`;
---

<!-- ==============================================
     LAYANAN SCAFFOLDING (GAYA PERSIS PT SNI)
=============================================== -->
<section class="py-20 bg-gray-50" id="layanan">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-montserrat font-bold text-orange-600 mb-4">
        Layanan <span class="text-gray-800">Scaffolding di {city}</span>
      </h2>
      <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto text-center font-roboto">
        Kami menyediakan solusi sewa scaffolding fleksibel serta penjualan unit baru dan rekondisi siap pakai untuk seluruh jenis proyek konstruksi Anda.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <!-- Card 1: Sewa Scaffolding -->
      <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 p-8 border border-gray-100 flex flex-col justify-between">
        <div class="flex flex-col gap-5">
          <div class="flex items-center justify-between">
            <span class="bg-orange-100 text-orange-800 text-xs font-montserrat font-bold px-3 py-1 rounded-full uppercase">
              Rental Fleksibel
            </span>
            <span class="text-orange-600 font-montserrat font-bold text-sm">✓ Ready Stock</span>
          </div>

          <div>
            <h3 class="text-2xl font-montserrat font-bold text-gray-800">
              Sewa Scaffolding (Rental)
            </h3>
            <p class="text-gray-600 text-sm mt-2 font-roboto leading-relaxed">
              Pilihan tepat untuk proyek renovasi rumah, ruko, gedung, hingga jembatan tanpa beban investasi beli dan gudang penyimpanan.
            </p>
          </div>

          <div class="bg-orange-50/60 p-4 rounded-xl border border-orange-100">
            <span class="text-xs uppercase text-gray-500 font-bold block">Harga Sewa Mulai:</span>
            <div class="text-3xl font-montserrat font-extrabold text-orange-600 mt-1">
              Rp 35.000 <span class="text-sm font-semibold text-gray-600">/ Set / Bulan</span>
            </div>
            <span class="text-xs text-gray-600 mt-1 block">Tersedia sewa harian &amp; mingguan (minimal 5 set)</span>
          </div>

          <ul class="space-y-3 text-sm text-gray-700 font-roboto">
            <li class="flex items-start gap-2.5">
              <Check className="w-5 h-5 text-orange-600 shrink-0 mt-0.5" />
              <span><strong>1 Set Komplit:</strong> 2 Main Frame (170/190cm), 2 Cross Brace, 4 Joint Pin.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-5 h-5 text-orange-600 shrink-0 mt-0.5" />
              <span><strong>Jaminan Ganti Baru:</strong> Unit cacat langsung ditukar di hari yang sama.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-5 h-5 text-orange-600 shrink-0 mt-0.5" />
              <span><strong>Bisa Bayar di Lokasi (COD):</strong> Pelunasan setelah barang sampai dan dicek mandor.</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-4 border-t border-gray-100">
          <a
            href={waSewaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full bg-orange-600 hover:bg-orange-700 text-white py-3.5 px-6 rounded-lg font-montserrat font-bold text-sm transition-all duration-300 flex items-center justify-center gap-2 shadow-md hover:shadow-lg"
            data-wa-source="service_split_sewa"
            data-wa-mode="SEWA"
            data-wa-city={city}
          >
            <MessageCircle className="w-4 h-4 fill-current" />
            <span>KONSULTASI SEWA VIA WHATSAPP</span>
          </a>
        </div>
      </div>

      <!-- Card 2: Jual Scaffolding -->
      <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 p-8 border border-gray-100 flex flex-col justify-between">
        <div class="flex flex-col gap-5">
          <div class="flex items-center justify-between">
            <span class="bg-gray-100 text-gray-800 text-xs font-montserrat font-bold px-3 py-1 rounded-full uppercase">
              Investasi Aset
            </span>
            <span class="text-gray-600 font-montserrat font-bold text-sm">Partai &amp; Ecer</span>
          </div>

          <div>
            <h3 class="text-2xl font-montserrat font-bold text-gray-800">
              Jual Scaffolding Baru &amp; Bekas
            </h3>
            <p class="text-gray-600 text-sm mt-2 font-roboto leading-relaxed">
              Investasi aset scaffolding untuk kontraktor dan pemborong dengan pipa standar SNI 07-0065 tebal {siteConfig.stats.pipeThickness}.
            </p>
          </div>

          <div class="bg-gray-100 p-4 rounded-xl border border-gray-200">
            <span class="text-xs uppercase text-gray-500 font-bold block">Harga Jual Langsung Pabrik:</span>
            <div class="text-3xl font-montserrat font-extrabold text-gray-900 mt-1">
              Harga Grosir <span class="text-sm font-semibold text-gray-600">Pabrik</span>
            </div>
            <span class="text-xs text-gray-600 mt-1 block">Ready stok baru dan rekondisi cat celup anti karat</span>
          </div>

          <ul class="space-y-3 text-sm text-gray-700 font-roboto">
            <li class="flex items-start gap-2.5">
              <Check className="w-5 h-5 text-orange-600 shrink-0 mt-0.5" />
              <span><strong>Pipa Hitam Galvanis SNI:</strong> Las MIG CO2 presisi, tahan beban cor beton berat.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-5 h-5 text-orange-600 shrink-0 mt-0.5" />
              <span><strong>Rekondisi Grade A:</strong> Pipa lurus lempeng, lubang pin presisi, bebas kerak semen.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <Check className="w-5 h-5 text-orange-600 shrink-0 mt-0.5" />
              <span><strong>Layanan Buyback (Beli Balik):</strong> Kami siap beli kembali scaffolding Anda setelah proyek usai.</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-4 border-t border-gray-100">
          <a
            href={waBeliUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full bg-gray-900 hover:bg-gray-800 text-white py-3.5 px-6 rounded-lg font-montserrat font-bold text-sm transition-all duration-300 flex items-center justify-center gap-2 shadow-md hover:shadow-lg"
            data-wa-source="service_split_jual"
            data-wa-mode="BELI"
            data-wa-city={city}
          >
            <MessageCircle className="w-4 h-4 fill-current text-orange-400" />
            <span>TANYA HARGA JUAL VIA WHATSAPP</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>