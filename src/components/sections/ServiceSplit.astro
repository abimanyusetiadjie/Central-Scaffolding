---
import { siteConfig } from '../../data/siteConfig';
import { Repeat, Store, CheckCircle2, MessageCircle } from 'lucide-react';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

const sewaText = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau sewa scaffolding untuk proyek di ${city}. Mohon info rincian & ketersediaan stok.`
);
const waSewaUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${sewaText}`;

const beliText = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau beli scaffolding (baru/rekondisi) untuk dikirim ke ${city}. Mohon info harga grosir & stok.`
);
const waBeliUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${beliText}`;
---

<!-- 2. SERVICE SPLIT (CLEAN COMPARISON CARDS) -->
<section
  id="sewa-atau-beli"
  aria-labelledby="service-split-title"
  class="w-full bg-slate-50 py-16 px-4 sm:px-6 lg:px-8 border-b border-slate-200 scroll-mt-20"
>
  <div class="max-w-7xl mx-auto flex flex-col gap-10">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto flex flex-col gap-2.5">
      <div class="inline-flex items-center gap-1.5 bg-blue-100 text-blue-900 px-3 py-1 rounded-full text-xs font-bold uppercase w-fit mx-auto">
        Skema Layanan Fleksibel
      </div>
      <h2
        id="service-split-title"
        class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight"
      >
        Pilihan Layanan Sewa &amp; Jual Scaffolding di {city}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 font-normal">
        Tentukan skema terbaik sesuai anggaran dan lama durasi pengerjaan proyek konstruksi Anda.
      </p>
    </div>

    <!-- 2 Comparison Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      <!-- CARD 1: SEWA -->
      <div class="bg-white p-7 sm:p-9 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
        <div class="flex flex-col gap-5">
          <div class="flex items-center justify-between gap-2">
            <span class="bg-amber-50 text-amber-900 border border-amber-200 px-3 py-1 rounded-full text-xs font-bold">
              ★ Paling Hemat untuk Renovasi
            </span>
            <Repeat className="w-6 h-6 text-blue-900" />
          </div>

          <div>
            <h3 class="text-2xl font-extrabold text-slate-900">
              Layanan Sewa (Rental)
            </h3>
            <p class="text-sm sm:text-base text-slate-600 mt-1.5 leading-relaxed">
              Sistem sewa fleksibel harian, mingguan, atau bulanan tanpa beban biaya gudang dan perawatan alat.
            </p>
          </div>

          <div class="bg-blue-50/70 p-5 rounded-xl border border-blue-100">
            <span class="text-xs uppercase text-slate-500 font-bold block mb-1">Harga Sewa Mulai Dari</span>
            <div class="text-3xl font-extrabold text-blue-900">
              Rp 35.000 <span class="text-base text-slate-600 font-semibold">/ Set / Bulan</span>
            </div>
            <span class="text-xs sm:text-sm font-semibold text-emerald-700 block mt-1.5">
              ✓ Tersedia sewa harian &amp; mingguan (minimal mulai 5 set)
            </span>
          </div>

          <ul class="flex flex-col gap-3 text-sm sm:text-base text-slate-700 pt-1">
            <li class="flex items-start gap-2.5">
              <CheckCircle2 className="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
              <span><strong>Durasi Fleksibel:</strong> Sewa 1 minggu, 2 minggu, atau bulanan sesuai progres tukang.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <CheckCircle2 className="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
              <span><strong>Jaminan Tukar Unit:</strong> Ganti pipa/komponen baru jika ditemukan cacat saat dibongkar.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <CheckCircle2 className="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
              <span><strong>Bebas Hitung Rumus:</strong> Mandor logistik kami siap bantu hitung kebutuhan set secara gratis.</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-5 border-t border-slate-100">
          <a
            class="w-full min-h-[50px] bg-emerald-600 hover:bg-emerald-700 text-white flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-bold text-base transition-colors shadow-sm"
            href={waSewaUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-source="service_split_sewa"
            data-wa-mode="SEWA"
            data-wa-city={city}
          >
            <MessageCircle className="w-5 h-5" />
            <span>Konsultasi Sewa via WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- CARD 2: BELI -->
      <div class="bg-white p-7 sm:p-9 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
        <div class="flex flex-col gap-5">
          <div class="flex items-center justify-between gap-2">
            <span class="bg-blue-50 text-blue-900 border border-blue-200 px-3 py-1 rounded-full text-xs font-bold">
              ★ Investasi Aset Kontraktor
            </span>
            <Store className="w-6 h-6 text-blue-900" />
          </div>

          <div>
            <h3 class="text-2xl font-extrabold text-slate-900">
              Layanan Jual Beli
            </h3>
            <p class="text-sm sm:text-base text-slate-600 mt-1.5 leading-relaxed">
              Stok baru dari pabrikan las MIG CO2 atau rekondisi mulus cat celup anti karat siap kerja di lapangan.
            </p>
          </div>

          <div class="bg-slate-100 p-5 rounded-xl border border-slate-200">
            <span class="text-xs uppercase text-slate-500 font-bold block mb-1">Harga Jual Langsung Pabrik</span>
            <div class="text-3xl font-extrabold text-slate-900">
              Harga Grosir <span class="text-base text-slate-600 font-semibold">Partai &amp; Eceran</span>
            </div>
            <span class="text-xs sm:text-sm font-semibold text-blue-900 block mt-1.5">
              ✓ Ready Rekondisi Grade A + Layanan Buyback (Beli Balik)
            </span>
          </div>

          <ul class="flex flex-col gap-3 text-sm sm:text-base text-slate-700 pt-1">
            <li class="flex items-start gap-2.5">
              <CheckCircle2 className="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
              <span><strong>Pipa SNI Tebal:</strong> Pipa hitam galvanis 1.8mm – 2.0mm, tahan beban cor beton berat.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <CheckCircle2 className="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
              <span><strong>Rekondisi Grade A:</strong> Pipa lurus lempeng, lubang pin presisi, dicat celup anti karat.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <CheckCircle2 className="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
              <span><strong>Kapasitas Pengiriman Besar:</strong> Siap kirim pickup, truk cold diesel, hingga fuso tronton.</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-5 border-t border-slate-100">
          <a
            class="w-full min-h-[50px] bg-slate-900 hover:bg-slate-800 text-white flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-bold text-base transition-colors shadow-sm"
            href={waBeliUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-source="service_split_jual"
            data-wa-mode="BELI"
            data-wa-city={city}
          >
            <MessageCircle className="w-5 h-5 text-emerald-400" />
            <span>Tanya Harga Beli via WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>