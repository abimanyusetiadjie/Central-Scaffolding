---
import { siteConfig } from '../../data/siteConfig';
import { Check, MessageCircle } from 'lucide-react';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

const sewaText = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau sewa scaffolding untuk proyek di ${city}. Mohon info rincian & ketersediaan stok.`
);
const waSewaUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${sewaText}`;

const beliText = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau beli scaffolding (baru/rekondisi) untuk dikirim ke ${city}. Mohon info harga grosir & stok.`
);
const waBeliUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${beliText}`;
---

<!-- DAFTAR HARGA SEWA & BELI KHAS ELEMENTOR PRICING TABLE -->
<section
  id="sewa-atau-beli"
  aria-labelledby="service-split-title"
  class="w-full bg-slate-50 py-16 px-4 sm:px-6 lg:px-8 border-b border-slate-200 scroll-mt-20"
>
  <div class="max-w-6xl mx-auto flex flex-col gap-10">
    <!-- Header Khas WordPress -->
    <div class="text-center max-w-3xl mx-auto flex flex-col gap-2.5">
      <span class="inline-flex items-center gap-1.5 bg-blue-100 text-[#0284c7] px-4 py-1 rounded-full text-xs font-black uppercase tracking-wider w-fit mx-auto">
        BIAYA SEWA &amp; JUAL TRANSPARAN
      </span>
      <h2
        id="service-split-title"
        class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight"
      >
        Daftar Harga Sewa &amp; Beli Scaffolding di {city}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 font-normal">
        Pilih skema paling hemat sesuai kebutuhan proyek renovasi rumah, ruko bertingkat, maupun proyek gedung.
      </p>
    </div>

    <!-- 2 Kolom Pricing Card Khas Elementor -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch max-w-4xl mx-auto w-full">
      <!-- PRICING CARD 1: SEWA -->
      <div class="bg-white rounded-2xl border-2 border-emerald-500 shadow-md p-6 sm:p-8 flex flex-col justify-between relative">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-emerald-600 text-white text-xs font-black px-4 py-1 rounded-full shadow-sm uppercase tracking-wider">
          ★ PALING BANYAK DISEWA
        </div>

        <div class="flex flex-col gap-5 mt-2">
          <div class="border-b border-slate-100 pb-4 text-center">
            <h3 class="text-2xl font-black text-slate-900">
              Sewa Scaffolding (Rental)
            </h3>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              Solusi hemat untuk proyek jangka pendek tanpa biaya simpan alat
            </p>
            <div class="mt-4 pt-3 border-t border-slate-100">
              <span class="text-xs text-slate-500 font-bold uppercase block">Mulai Dari</span>
              <div class="text-4xl font-black text-emerald-600 mt-1">
                Rp 35.000
                <span class="text-sm font-bold text-slate-600">/ Set / Bulan</span>
              </div>
              <span class="text-xs font-bold text-emerald-700 block mt-1">
                (Tersedia sewa harian &amp; mingguan, minimal 5 set)
              </span>
            </div>
          </div>

          <!-- Feature List with Green Circles -->
          <ul class="space-y-3 text-sm text-slate-700">
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5 font-bold">
                <Check className="w-3.5 h-3.5" />
              </div>
              <span><strong>1 Set Lengkap:</strong> 2 Main Frame, 2 Cross Brace silangan, dan 4 Joint Pin pengunci.</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5 font-bold">
                <Check className="w-3.5 h-3.5" />
              </div>
              <span><strong>Pilihan Ukuran:</strong> Tinggi Main Frame 170 cm dan 190 cm standar konstruksi SNI.</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5 font-bold">
                <Check className="w-3.5 h-3.5" />
              </div>
              <span><strong>Garansi Tukar Unit:</strong> Pipa bengkok atau cacat langsung ditukar baru tanpa biaya tambahan.</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5 font-bold">
                <Check className="w-3.5 h-3.5" />
              </div>
              <span><strong>Bisa Bayar di Lokasi (COD):</strong> Pelunasan setelah barang sampai dan dicek mandor proyek.</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-4 border-t border-slate-100">
          <a
            class="w-full min-h-[48px] bg-[#25D366] hover:bg-[#20bd5a] text-white flex items-center justify-center gap-2 px-6 py-3 rounded-full font-black text-sm uppercase tracking-wider shadow-md hover:shadow-lg transition-all active:scale-95 text-center"
            href={waSewaUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-source="service_split_sewa"
            data-wa-mode="SEWA"
            data-wa-city={city}
          >
            <MessageCircle className="w-4 h-4 fill-current" />
            <span>SEWA VIA WHATSAPP</span>
          </a>
        </div>
      </div>

      <!-- PRICING CARD 2: BELI -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-md p-6 sm:p-8 flex flex-col justify-between relative">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-slate-800 text-white text-xs font-black px-4 py-1 rounded-full shadow-sm uppercase tracking-wider">
          ASET JANGKA PANJANG
        </div>

        <div class="flex flex-col gap-5 mt-2">
          <div class="border-b border-slate-100 pb-4 text-center">
            <h3 class="text-2xl font-black text-slate-900">
              Jual Beli (Baru &amp; Rekondisi)
            </h3>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              Investasi aset scaffolding untuk kontraktor dan pemborong rutin
            </p>
            <div class="mt-4 pt-3 border-t border-slate-100">
              <span class="text-xs text-slate-500 font-bold uppercase block">Harga Penjualan</span>
              <div class="text-3xl sm:text-4xl font-black text-slate-900 mt-1">
                Harga Grosir
                <span class="text-sm font-bold text-slate-600">/ Pabrik</span>
              </div>
              <span class="text-xs font-bold text-blue-800 block mt-1">
                (Melayani order partai besar maupun eceran)
              </span>
            </div>
          </div>

          <!-- Feature List with Blue Circles -->
          <ul class="space-y-3 text-sm text-slate-700">
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-blue-100 text-blue-800 flex items-center justify-center shrink-0 mt-0.5 font-bold">
                <Check className="w-3.5 h-3.5" />
              </div>
              <span><strong>Unit Baru SNI:</strong> Pipa galvanis tebal 1.8mm–2.0mm diproduksi dengan las MIG CO2 penuh.</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-blue-100 text-blue-800 flex items-center justify-center shrink-0 mt-0.5 font-bold">
                <Check className="w-3.5 h-3.5" />
              </div>
              <span><strong>Rekondisi Grade A:</strong> Pipa lempeng lurus, lubang pin presisi, dibersihkan dan dicat celup anti karat.</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-blue-100 text-blue-800 flex items-center justify-center shrink-0 mt-0.5 font-bold">
                <Check className="w-3.5 h-3.5" />
              </div>
              <span><strong>Layanan Buyback (Beli Balik):</strong> Proyek selesai? Kami siap beli kembali scaffolding Anda dengan harga transparan.</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-blue-100 text-blue-800 flex items-center justify-center shrink-0 mt-0.5 font-bold">
                <Check className="w-3.5 h-3.5" />
              </div>
              <span><strong>Surat Jalan &amp; Faktur:</strong> Legalitas resmi siap untuk administrasi proyek &amp; tender dinas.</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-4 border-t border-slate-100">
          <a
            class="w-full min-h-[48px] bg-slate-900 hover:bg-slate-800 text-white flex items-center justify-center gap-2 px-6 py-3 rounded-full font-black text-sm uppercase tracking-wider shadow-md hover:shadow-lg transition-all active:scale-95 text-center"
            href={waBeliUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-source="service_split_jual"
            data-wa-mode="BELI"
            data-wa-city={city}
          >
            <MessageCircle className="w-4 h-4 fill-current text-emerald-400" />
            <span>TANYA HARGA BELI VIA WA</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>