---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya melihat portofolio proyek scaffolding Anda dan ingin konsultasi kebutuhan sewa scaffolding untuk proyek saya di ${city}.`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;

const projects = [
  {
    title: 'Gedung Bank BTN (Komersial)',
    location: 'Jabodetabek',
    badge: 'Komersial',
    specs: 'Tower 5 Lantai & Tangga Perancah',
    year: '2025',
    webp: '/assets/img/projects/project-bank-btn.webp',
    alt: `Dokumentasi pemasangan tower scaffolding bertingkat lengkap tangga pada proyek gedung Bank BTN oleh Central Scaffolding di ${city}`,
  },
  {
    title: 'Cluster Mozia, BSD City',
    location: 'BSD City, Tangsel',
    badge: 'Residensial',
    specs: 'Fasad & Cor Beton Rumah Mewah',
    year: '2025',
    webp: '/assets/img/projects/project-cluster-mozia-bsd.webp',
    alt: `Proyek sewa scaffolding Main Frame dan perancah cor beton perumahan mewah Cluster Mozia BSD City Tangerang`,
  },
  {
    title: 'Ruko Niaga Bidex, BSD',
    location: 'BSD Serpong, Tangsel',
    badge: 'Ruko Niaga',
    specs: 'Pekerjaan Fasad & Renovasi Ruko',
    year: '2025',
    webp: '/assets/img/projects/project-ruko-bidex-bsd.webp',
    alt: `Penyewaan scaffolding ruko niaga Bidex BSD Serpong Tangerang oleh Central Scaffolding`,
  },
  {
    title: 'Kalibata Residence',
    location: 'Jakarta Selatan',
    badge: 'Mansion',
    specs: 'Main Frame 1.90m Pipa Tebal SNI',
    year: '2025',
    webp: '/assets/img/projects/project-kalibata-residence.webp',
    alt: `Sewa scaffolding Main Frame 190 pembangunan rumah mewah klasik Kalibata Residence Jakarta Selatan`,
  },
  {
    title: 'Gedung Fasilitas Publik',
    location: 'Tangerang & Jabodetabek',
    badge: 'Proyek BUMN',
    specs: 'Main Frame 190 & Ladder Frame 90',
    year: '2025',
    webp: '/assets/img/projects/project-gedung-bumn.webp',
    alt: `Penyelesaian sewa scaffolding proyek gedung fasilitas publik BUMN oleh Central Scaffolding`,
  },
  {
    title: 'Konstruksi Cor Bertingkat',
    location: 'Tangerang, Banten',
    badge: 'Struktur Beton',
    specs: 'Penyangga Balok & Plat Lantai Cor',
    year: '2025',
    webp: '/assets/img/projects/project-konstruksi-cor.webp',
    alt: `Sewa scaffolding penyangga cor beton dan rangka besi gedung bertingkat di Tangerang`,
  },
];
---

<!-- ==============================================
     PORTOFOLIO PROYEK KAMI (BEBAS TEKS TERPOTONG DI MOBILE)
=============================================== -->
<section class="py-10 sm:py-14 bg-white border-t border-slate-200" id="projects">
  <div class="container mx-auto px-4 font-montserrat">
    <!-- Header Section -->
    <div class="text-center mb-6 sm:mb-9">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-red-50 border border-red-200 text-red-700 text-xs font-bold uppercase tracking-wider mb-2">
        <i class="fas fa-building-circle-check text-xs"></i>
        <span>Portofolio Lapangan Nyata</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-bold text-slate-900">
        Portofolio <span class="text-red-600">Proyek Kami</span>
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 font-roboto mt-1 sm:hidden">
        Geser untuk melihat dokumentasi proyek →
      </p>
    </div>

    <!-- 6 Kartu Proyek: Horizontal Snap di Mobile, Grid 3 Kolom di Desktop -->
    <div
      id="projects-mobile-carousel"
      class="flex overflow-x-auto snap-x snap-mandatory gap-3.5 pb-3 -mx-4 px-4 no-scrollbar sm:grid sm:grid-cols-2 lg:grid-cols-3 sm:gap-5 max-w-7xl mx-auto sm:overflow-visible sm:pb-0 sm:mx-auto sm:px-0 scroll-smooth"
    >
      {projects.map((proj) => (
        <article class="w-[82vw] max-w-[290px] shrink-0 snap-center sm:w-auto sm:max-w-none sm:shrink bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 border border-slate-200 hover:border-red-600 flex flex-col justify-between group">
          <!-- Frame Foto Proyek (Aspect Ratio 4:3 Rapi & Proporsional) -->
          <div class="relative aspect-[4/3] w-full overflow-hidden bg-slate-100">
            <picture class="block w-full h-full">
              <source srcset={proj.webp} type="image/webp" />
              <img
                src={proj.webp}
                alt={proj.alt}
                width="640"
                height="480"
                class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </picture>

            <!-- Badge Kategori Pojok Kiri Atas -->
            <div class="absolute top-2.5 left-2.5 bg-red-600/95 text-white text-xs font-bold px-2.5 py-0.5 rounded shadow-sm">
              {proj.badge}
            </div>

            <!-- Badge Tahun Pojok Kanan Atas -->
            <div class="absolute top-2.5 right-2.5 bg-slate-900/90 text-white text-xs font-mono font-bold px-2 py-0.5 rounded shadow-sm">
              {proj.year}
            </div>
          </div>

          <!-- Keterangan Proyek Utuh (Tanpa Truncate / Tidak Terpotong) -->
          <div class="p-3.5 sm:p-4 flex-grow flex flex-col justify-between">
            <div>
              <h3 class="text-sm sm:text-base font-bold text-slate-900 mb-1.5 leading-snug group-hover:text-red-600 transition-colors">
                {proj.title}
              </h3>
              <p class="text-xs text-slate-600 font-roboto flex items-start gap-1.5 leading-snug mb-3">
                <i class="fas fa-screwdriver-wrench text-red-600 text-xs mt-0.5 shrink-0"></i>
                <span>{proj.specs}</span>
              </p>
            </div>

            <div class="flex items-center justify-between gap-2 text-slate-600 font-roboto text-xs pt-2.5 border-t border-slate-100">
              <span class="flex items-center gap-1.5 text-slate-700 font-medium leading-tight">
                <i class="fas fa-map-marker-alt text-red-600 text-xs shrink-0"></i>
                <span>{proj.location}</span>
              </span>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100 shrink-0">
                Terpasang
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Tombol Konsultasi WhatsApp di Bawah -->
    <div class="text-center mt-6 sm:mt-8">
      <a
        class="inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 active:bg-green-800 text-white px-6 py-3 sm:px-7 sm:py-3.5 rounded-xl font-bold text-xs sm:text-base transition-all duration-300 shadow-md font-montserrat"
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fab fa-whatsapp text-lg sm:text-xl"></i>
        <span>Konsultasi Kebutuhan Proyek via WhatsApp</span>
      </a>
    </div>
  </div>
</section>

<!-- Script Auto-Slide Khusus Layar Mobile (Tempo 3.5 Detik Nyaman Dibaca) -->
<script>
  function initProjectsAutoScroll() {
    const carousel = document.getElementById('projects-mobile-carousel');
    if (!carousel) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let isInteracting = false;
    let resumeTimeout: ReturnType<typeof setTimeout> | undefined;

    function autoSlide() {
      // Hanya aktif di layar handphone (< 640px) saat tidak disentuh
      if (!carousel || window.innerWidth >= 640 || isInteracting) return;

      const maxScroll = carousel.scrollWidth - carousel.clientWidth;
      if (carousel.scrollLeft >= maxScroll - 15) {
        // Jika sudah di ujung foto terakhir, kembali ke awal dengan halus
        carousel.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        // Ambil lebar kartu aktif + gap secara dinamis
        const card = carousel.querySelector('article');
        const scrollDistance = card ? card.getBoundingClientRect().width + 14 : 285;
        carousel.scrollBy({ left: scrollDistance, behavior: 'smooth' });
      }
    }

    // Ritme pergeseran yang nyaman: 3.5 detik
    setInterval(autoSlide, 3500);

    // Jeda otomatis jika pengguna menyentuh layar
    carousel.addEventListener('touchstart', () => {
      isInteracting = true;
      clearTimeout(resumeTimeout);
    }, { passive: true });

    carousel.addEventListener('touchend', () => {
      clearTimeout(resumeTimeout);
      resumeTimeout = setTimeout(() => {
        isInteracting = false;
      }, 2500);
    }, { passive: true });

    carousel.addEventListener('touchcancel', () => {
      isInteracting = false;
    }, { passive: true });

    carousel.addEventListener('mouseenter', () => { isInteracting = true; });
    carousel.addEventListener('mouseleave', () => { isInteracting = false; });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectsAutoScroll);
  } else {
    initProjectsAutoScroll();
  }
</script>
