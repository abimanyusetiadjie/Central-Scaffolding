---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya tertarik melihat portofolio proyek scaffolding Anda dan ingin konsultasi kebutuhan scaffolding untuk proyek saya di ${city}.`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;

const projects = [
  {
    title: 'Pembangunan Rumah Mewah & Hunian Residensial',
    location: `${city}, 2025`,
    img: '/assets/img/project-royal-residence.jpg',
    alt: 'Proyek Sewa Scaffolding Frame System Hunian Residensial',
  },
  {
    title: 'Kawasan Pergudangan & Logistik Industrial',
    location: `Kawasan Industri Tangerang & Sekitarnya, 2025`,
    img: '/assets/img/project-terminal-gresik.jpg',
    alt: 'Proyek Sewa Scaffolding Terminal dan Pergudangan',
  },
  {
    title: 'Gedung Fasilitas Pendidikan & Perkantoran',
    location: `Jabodetabek, 2025`,
    img: '/assets/img/project-unair.jpg',
    alt: 'Proyek Sewa Scaffolding Gedung Bertingkat',
  },
];
---

<!-- ==============================================
     PROYEK SEWA SCAFFOLDING TERBARU (EXACT PT SNI)
=============================================== -->
<section class="py-20 bg-gray-50" id="projects">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-montserrat font-bold text-red-600 mb-4">
        Proyek
        <span class="text-gray-800">
          Sewa Scaffolding
        </span>
        Terbaru
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto font-roboto">
        Lihat berbagai proyek sewa scaffolding dan pemasangan rangka kerja yang telah kami kerjakan dengan standar kualitas dan keamanan terbaik di wilayah {city} dan sekitarnya.
      </p>
    </div>

    <!-- 3 Project Cards Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12 max-w-6xl mx-auto">
      {projects.map((proj) => (
        <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
          <div class="relative overflow-hidden h-64 bg-slate-100">
            <img
              src={proj.img}
              alt={proj.alt}
              class="w-full h-64 object-cover transition-transform duration-300 hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-black/20 pointer-events-none"></div>
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-montserrat font-bold text-gray-800 mb-2 leading-tight">
              {proj.title}
            </h3>
            <p class="text-gray-600 font-roboto text-sm font-medium">
              {proj.location}
            </p>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <a
        class="inline-block bg-red-600 hover:bg-red-700 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all duration-300 transform hover:scale-105 btn-hover shadow-md font-montserrat"
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Lihat Project Selengkapnya
      </a>
    </div>
  </div>
</section>
