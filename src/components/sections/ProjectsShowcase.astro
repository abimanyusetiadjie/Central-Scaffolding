---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya melihat portofolio proyek scaffolding Anda (seperti Bank BTN & BSD) dan ingin konsultasi kebutuhan sewa scaffolding untuk proyek saya di ${city}.`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;

const projects = [
  {
    title: 'Gedung Bank BTN (Proyek Komersial)',
    location: 'Jabodetabek',
    badge: 'Komersial & Perbankan',
    specs: 'Tower 5 Lantai + Tangga Perancah',
    year: '2025',
    webp: '/assets/img/projects/project-bank-btn.webp',
    alt: `Dokumentasi pemasangan tower scaffolding bertingkat lengkap tangga pada proyek gedung Bank BTN oleh Central Scaffolding di ${city}`,
  },
  {
    title: 'Cluster Mozia, BSD City',
    location: 'BSD City, Tangerang Selatan',
    badge: 'Residensial Mewah',
    specs: 'Fasad & Cor Beton Rumah Mewah',
    year: '2025',
    webp: '/assets/img/projects/project-cluster-mozia-bsd.webp',
    alt: `Proyek sewa scaffolding Main Frame dan perancah cor beton perumahan mewah Cluster Mozia BSD City Tangerang`,
  },
  {
    title: 'Ruko Niaga Bidex, BSD',
    location: 'BSD Serpong, Tangerang Selatan',
    badge: 'Ruko Komersial',
    specs: 'Pekerjaan Fasad & Renovasi Ruko',
    year: '2025',
    webp: '/assets/img/projects/project-ruko-bidex-bsd.webp',
    alt: `Penyewaan scaffolding ruko niaga Bidex BSD Serpong Tangerang oleh Central Scaffolding`,
  },
  {
    title: 'Kalibata Residence, Jakarta Selatan',
    location: 'Jakarta Selatan, DKI Jakarta',
    badge: 'Mansion Residensial',
    specs: 'Main Frame 1.90m & Pipa Tebal SNI',
    year: '2025',
    webp: '/assets/img/projects/project-kalibata-residence.webp',
    alt: `Sewa scaffolding Main Frame 190 pembangunan rumah mewah klasik Kalibata Residence Jakarta Selatan`,
  },
  {
    title: 'Gedung Instansi & Fasilitas Publik',
    location: 'Tangerang & Jabodetabek',
    badge: 'Proyek BUMN',
    specs: 'Main Frame 190 & Ladder Frame 90',
    year: '2025',
    webp: '/assets/img/projects/project-gedung-bumn.webp',
    alt: `Penyelesaian sewa scaffolding proyek gedung fasilitas publik BUMN oleh Central Scaffolding`,
  },
  {
    title: 'Konstruksi Bertingkat & Cor Beton',
    location: 'Kawasan Tangerang & Banten',
    badge: 'Struktur Beton',
    specs: 'Penyangga Balok & Plat Lantai Cor',
    year: '2025',
    webp: '/assets/img/projects/project-konstruksi-cor.webp',
    alt: `Sewa scaffolding penyangga cor beton dan rangka besi gedung bertingkat di Tangerang`,
  },
];
---

<!-- ==============================================
     PROYEK SEWA SCAFFOLDING TERBARU (AUTO-SLIDE MOBILE & GRID DESKTOP)
=============================================== -->
<section class="py-14 sm:py-20 bg-gray-50 border-t border-gray-200" id="projects">
  <div class="container mx-auto px-4 font-montserrat">
    <!-- Header Section -->
    <div class="text-center mb-8 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-50 text-red-600 text-xs font-bold uppercase tracking-wider mb-2.5">
        <i class="fas fa-building-circle-check text-sm"></i>
        <span>Portofolio Proyek Lapangan Nyata</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-3">
        Proyek Sewa Scaffolding <span class="text-red-600">Terbaru Kami</span>
      </h2>
      <p class="text-sm sm:text-base text-gray-600 max-w-2xl mx-auto font-roboto">
        Dokumentasi instalasi nyata scaffolding Central Scaffolding pada proyek gedung perbankan, perumahan klaster BSD, ruko niaga, dan proyek BUMN di {city}.
      </p>
    </div>

    <!-- 6 Kartu Proyek: Auto-Slide Geser Sendiri di Mobile (Bebas Dead Scroll), Grid 3 Kolom di Desktop -->
    <div
      id="projects-mobile-carousel"
      class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 -mx-4 px-4 no-scrollbar sm:grid sm:grid-cols-2 lg:grid-cols-3 sm:gap-6 lg:gap-8 mb-10 sm:mb-12 max-w-7xl mx-auto sm:overflow-visible sm:pb-0 sm:mx-auto sm:px-0 scroll-smooth"
    >
      {projects.map((proj) => (
        <article class="w-[80vw] max-w-[285px] shrink-0 snap-center sm:w-auto sm:max-w-none sm:shrink bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1.5 border border-gray-200 flex flex-col justify-between group">
          <!-- Frame Foto Proyek (Aspect Ratio 4:5 Proporsional Foto Lapangan) -->
          <div class="relative aspect-[4/5] w-full overflow-hidden bg-slate-100">
            <picture class="block w-full h-full">
              <source srcset={proj.webp} type="image/webp" />
              <img
                src={proj.webp}
                alt={proj.alt}
                width="720"
                height="900"
                class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </picture>

            <!-- Gradient Overlay Halus Bawah Foto -->
            <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-slate-950/75 to-transparent pointer-events-none"></div>

            <!-- Badge Kategori Pojok Kiri Atas -->
            <div class="absolute top-3 left-3 bg-red-600/95 backdrop-blur-sm text-white text-[10px] sm:text-[11px] font-bold px-2.5 py-1 rounded-md shadow-sm">
              {proj.badge}
            </div>

            <!-- Badge Tahun Pojok Kanan Atas -->
            <div class="absolute top-3 right-3 bg-slate-900/90 backdrop-blur-sm text-white text-[11px] font-mono font-bold px-2 py-0.5 rounded-md shadow-sm">
              {proj.year}
            </div>

            <!-- Highlight Teknis di Bawah Foto -->
            <div class="absolute bottom-3 left-3 right-3 text-white text-[11px] sm:text-xs font-medium flex items-center gap-1.5 drop-shadow">
              <i class="fas fa-screwdriver-wrench text-amber-400 text-[10px] shrink-0"></i>
              <span class="truncate">{proj.specs}</span>
            </div>
          </div>

          <!-- Keterangan Proyek -->
          <div class="p-4 sm:p-5 flex-grow flex flex-col justify-between">
            <div>
              <h3 class="text-sm sm:text-base lg:text-lg font-bold text-gray-900 mb-2 leading-snug group-hover:text-red-600 transition-colors">
                {proj.title}
              </h3>
            </div>

            <div class="flex items-center justify-between text-gray-600 font-roboto text-xs sm:text-sm font-medium pt-3 border-t border-gray-100 mt-2">
              <span class="flex items-center gap-1.5 text-gray-700">
                <i class="fas fa-map-marker-alt text-red-600 text-xs shrink-0"></i>
                <span class="truncate max-w-[150px] sm:max-w-[180px] text-xs sm:text-sm">{proj.location}</span>
              </span>
              <span class="text-[10px] sm:text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100 shrink-0">
                Terpasang
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Tombol Konsultasi WhatsApp di Bawah -->
    <div class="text-center mt-6 sm:mt-10">
      <a
        class="inline-flex items-center justify-center gap-2.5 bg-green-600 hover:bg-green-700 active:bg-green-800 text-white px-7 sm:px-8 py-3.5 sm:py-4 rounded-xl font-bold text-sm sm:text-lg transition-all duration-300 transform hover:scale-105 shadow-lg font-montserrat active:scale-95"
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fab fa-whatsapp text-xl sm:text-2xl"></i>
        <span>Konsultasikan Kebutuhan Proyek Anda (WhatsApp)</span>
      </a>
    </div>
  </div>
</section>

<!-- Script Auto-Slide Khusus Layar Mobile dengan Tempo Cepat (2.0s) -->
<script>
  function initProjectsAutoScroll() {
    const carousel = document.getElementById('projects-mobile-carousel');
    if (!carousel) return;

    let isInteracting = false;
    let resumeTimeout;

    function autoSlide() {
      // Hanya aktif di layar handphone (< 640px)
      if (window.innerWidth >= 640 || isInteracting) return;

      const maxScroll = carousel.scrollWidth - carousel.clientWidth;
      if (carousel.scrollLeft >= maxScroll - 20) {
        // Kembali ke foto proyek awal secara mulus
        carousel.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        // Geser ke foto proyek berikutnya (sekitar 285px)
        carousel.scrollBy({ left: 285, behavior: 'smooth' });
      }
    }

    // Ritme/tempo agak cepat: bergeser setiap 2.0 detik
    const timer = setInterval(autoSlide, 2000);

    // Jeda saat disentuh atau diswipe manual oleh pengguna
    carousel.addEventListener('touchstart', () => {
      isInteracting = true;
      clearTimeout(resumeTimeout);
    }, { passive: true });

    carousel.addEventListener('touchend', () => {
      clearTimeout(resumeTimeout);
      resumeTimeout = setTimeout(() => {
        isInteracting = false;
      }, 3000);
    }, { passive: true });

    carousel.addEventListener('mouseenter', () => { isInteracting = true; });
    carousel.addEventListener('mouseleave', () => { isInteracting = false; });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectsAutoScroll);
  } else {
    initProjectsAutoScroll();
  }
</script>
