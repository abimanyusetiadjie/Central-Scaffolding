---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya tertarik melihat portofolio proyek scaffolding Anda dan ingin konsultasi kebutuhan scaffolding untuk proyek saya di ${city}.`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;

const projects = [
  {
    title: 'Pembangunan Rumah Mewah & Hunian Residensial',
    location: `Kawasan Residensial ${city}`,
    year: '2025',
    webp: '/assets/img/project-royal-residence.webp',
    img: '/assets/img/project-royal-residence.jpg',
    alt: `Proyek pemasangan scaffolding Main Frame untuk pembangunan rumah mewah dan hunian residensial di ${city}`,
  },
  {
    title: 'Kawasan Pergudangan & Terminal Logistik Industrial',
    location: 'Kawasan Industri Tangerang & Sekitarnya',
    year: '2025',
    webp: '/assets/img/project-terminal-gresik.webp',
    img: '/assets/img/project-terminal-gresik.jpg',
    alt: 'Proyek sewa scaffolding heavy duty untuk konstruksi terminal pelabuhan dan kawasan pergudangan logistik industrial',
  },
  {
    title: 'Gedung Fasilitas Pendidikan & Perkantoran',
    location: `Area ${city} & Jabodetabek`,
    year: '2025',
    webp: '/assets/img/project-unair.webp',
    img: '/assets/img/project-unair.jpg',
    alt: `Proyek sewa scaffolding pipa baja SNI untuk pekerjaan fasad gedung fasilitas pendidikan dan perkantoran bertingkat di ${city}`,
  },
];
---

<!-- ==============================================
     PROYEK SEWA SCAFFOLDING TERBARU
=============================================== -->
<section class="py-20 bg-gray-50" id="projects">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-montserrat font-bold text-red-600 mb-4">
        Proyek
        <span class="text-gray-800">
          Sewa Scaffolding
        </span>
        Terbaru
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto font-roboto">
        Lihat berbagai proyek sewa scaffolding dan pemasangan rangka kerja yang telah kami kerjakan dengan standar kualitas dan keamanan terbaik di wilayah {city} dan sekitarnya.
      </p>
    </div>

    <!-- Hint Geser di Layar HP (Bebas Dead Scroll) -->
    <div class="flex items-center justify-between text-xs text-slate-500 font-roboto sm:hidden mb-3 px-1">
      <span class="flex items-center gap-1.5 font-medium text-slate-700">
        <i class="fas fa-arrows-left-right text-red-600"></i>
        <span>Geser horizontal untuk portofolio proyek</span>
      </span>
      <span class="text-[11px] bg-slate-200 text-slate-700 px-2 py-0.5 rounded font-mono font-bold">3 Proyek Pilihan</span>
    </div>

    <!-- 3 Project Cards Grid: Horizontal Snap Scroll di Mobile, 2 Kolom Tablet, 3 Kolom Desktop -->
    <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 -mx-4 px-4 no-scrollbar sm:grid md:grid-cols-2 lg:grid-cols-3 sm:gap-8 mb-12 max-w-6xl mx-auto sm:overflow-visible sm:pb-0 sm:mx-auto sm:px-0">
      {projects.map((proj) => (
        <article class="w-[84vw] max-w-[320px] shrink-0 snap-center sm:w-auto sm:max-w-none sm:shrink bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1.5 border border-gray-200 flex flex-col justify-between group">
          <div class="relative aspect-[4/3] w-full overflow-hidden bg-slate-100">
            <picture class="block w-full h-full">
              <source srcset={proj.webp} type="image/webp" />
              <img
                src={proj.img}
                alt={proj.alt}
                width="800"
                height="600"
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <div class="absolute top-3 right-3 bg-slate-900/85 text-white text-xs font-mono font-bold px-2.5 py-1 rounded">
              {proj.year}
            </div>
          </div>
          <div class="p-6 flex-grow flex flex-col justify-between">
            <h3 class="text-xl sm:text-2xl font-montserrat font-bold text-gray-900 mb-3 leading-snug group-hover:text-red-600 transition-colors">
              {proj.title}
            </h3>
            <div class="flex items-center justify-between text-gray-600 font-roboto text-sm font-medium pt-3 border-t border-gray-100">
              <span class="flex items-center gap-1.5">
                <i class="fas fa-map-marker-alt text-red-600"></i>
                <span>{proj.location}</span>
              </span>
              <span class="text-xs font-mono font-bold text-gray-500">Tahun {proj.year}</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="text-center mt-12">
      <a
        class="inline-block bg-red-600 hover:bg-red-700 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all duration-300 transform hover:scale-105 btn-hover shadow-md font-montserrat"
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Lihat Project Selengkapnya
      </a>
    </div>
  </div>
</section>
