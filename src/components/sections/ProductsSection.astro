---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau minta katalog lengkap dan penawaran harga scaffolding untuk proyek di ${city}.`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;

const products = [
  {
    title: 'Main Frame Scaffolding',
    webp: '/assets/img/product/mainframepng.webp',
    img: '/assets/img/product/mainframepng.png',
    alt: `Sewa dan jual scaffolding Main Frame 170cm dan 190cm pipa tebal SNI di ${city}`,
    specs: [
      { label: 'Ukuran', val: 'T. 170/190cm x L. 122cm' },
      { label: 'Pipa', val: 'Tebal 1.8mm – 2.0mm SNI' },
      { label: '1 Set', val: '2 Frame, 2 Silang, 4 Pin' },
    ],
    badge: 'Paling Laris',
  },
  {
    title: 'Bekisting System (Cor)',
    webp: '/assets/img/product/Bekistingpng.webp',
    img: '/assets/img/product/Bekistingpng.png',
    alt: `Sewa bekisting system penyangga pengecoran balok dan plat lantai beton di ${city}`,
    specs: [
      { label: 'Fungsi', val: 'Cor Balok & Plat Lantai' },
      { label: 'Komponen', val: 'U-Head, Jack Base, Support' },
      { label: 'Material', val: 'Baja Presisi Beban Berat' },
    ],
    badge: 'Spesialis Cor',
  },
  {
    title: 'Tubular System (Heavy)',
    webp: '/assets/img/product/tubularsystempng.webp',
    img: '/assets/img/product/tubularsystempng.png',
    alt: `Sewa scaffolding Tubular System pipa seamless heavy duty proyek industri di ${city}`,
    specs: [
      { label: 'Fungsi', val: 'Tangki, Silo & Ketinggian' },
      { label: 'Sistem', val: 'Pipa Seamless + Klem' },
      { label: 'Desain', val: 'Fleksibel Segala Sudut' },
    ],
    badge: 'Heavy Duty',
  },
  {
    title: 'PCH Kwikstage System',
    webp: '/assets/img/product/Kwikstagepng.webp',
    img: '/assets/img/product/Kwikstagepng.png',
    alt: `Sewa scaffolding PCH Kwikstage System konstruksi gedung bertingkat di ${city}`,
    specs: [
      { label: 'Aplikasi', val: 'Gedung & Hotel Bertingkat' },
      { label: 'Fitur', val: 'Kuncian Wedge Cepat' },
      { label: 'Kapasitas', val: 'Beban Kerja Ekstra Tinggi' },
    ],
    badge: 'Gedung Bertingkat',
  },
  {
    title: 'Ringlock System (Modular)',
    webp: '/assets/img/product/ringlocksystem.webp',
    img: '/assets/img/product/ringlocksystem.png',
    alt: `Sewa scaffolding Ringlock System modular rosette standar K3 internasional di ${city}`,
    specs: [
      { label: 'Aplikasi', val: 'Jembatan & Struktur Rumit' },
      { label: 'Sistem', val: 'Koneksi Rosette 8 Arah' },
      { label: 'Keamanan', val: 'Kekakuan Tertinggi K3' },
    ],
    badge: 'Standar K3',
  },
];
---

<!-- ==============================================
     PRODUK SCAFFOLDING KAMI (VISUAL & RINGKAS)
=============================================== -->
<section class="py-16 bg-white" id="products">
  <div class="container mx-auto px-4">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 text-red-600 text-xs font-montserrat font-bold uppercase tracking-wider mb-2.5">
        <i class="fas fa-boxes-stacked text-sm"></i>
        <span>Katalog Ready Stok</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-montserrat font-bold text-gray-900 mb-3">
        Produk <span class="text-red-600">Scaffolding Kami</span>
      </h2>
      <p class="text-sm sm:text-base text-gray-600 max-w-xl mx-auto font-roboto">
        Pipa baja standar SNI 07-0065 tebal 1.8mm – 2.0mm. Sewa bulanan &amp; jual siap kirim di {city}.
      </p>
    </div>

    <!-- Hint Geser di Layar HP (Bebas Dead Scroll) -->
    <div class="flex items-center justify-between text-xs text-slate-500 font-roboto sm:hidden mb-2.5 px-1">
      <span class="flex items-center gap-1.5 font-medium text-slate-700">
        <i class="fas fa-arrows-left-right text-red-600"></i>
        <span>Geser horizontal untuk 5 produk</span>
      </span>
      <span class="text-[11px] bg-red-50 text-red-700 px-2 py-0.5 rounded font-mono font-bold">5 Tipe Ready</span>
    </div>

    <!-- 5 Kolom Grid: Horizontal Snap Scroll di Mobile, 2 Kolom Tablet, 5 Kolom Desktop -->
    <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 -mx-4 px-4 no-scrollbar sm:grid sm:grid-cols-2 lg:grid-cols-5 sm:gap-6 sm:overflow-visible sm:pb-0 sm:mx-0 sm:px-0">
      {products.map((item) => (
        <article class="w-[82vw] max-w-[290px] shrink-0 snap-center sm:w-auto sm:max-w-none sm:shrink bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1.5 p-4 sm:p-5 border border-gray-200 flex flex-col justify-between group">
          <div>
            <!-- Badge Pojok Atas -->
            <div class="flex justify-between items-center mb-2.5 gap-1">
              <span class="text-[10px] font-montserrat font-bold uppercase bg-red-50 text-red-600 px-2 py-0.5 rounded-full border border-red-100">
                {item.badge}
              </span>
              <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded shrink-0">
                ● Ready Stok
              </span>
            </div>

            <!-- Frame Foto Produk Bersih -->
            <div class="relative aspect-[4/3] w-full flex items-center justify-center p-3 mb-3 bg-slate-50 rounded-lg border border-slate-100 group-hover:bg-slate-100/80 transition-colors overflow-hidden">
              <picture class="w-full h-full flex items-center justify-center">
                <source srcset={item.webp} type="image/webp" />
                <img
                  src={item.img}
                  alt={item.alt}
                  width="400"
                  height="300"
                  class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>

            <!-- Judul Produk -->
            <h3 class="text-sm sm:text-base font-montserrat font-bold text-gray-900 mb-2.5 group-hover:text-red-600 transition-colors leading-snug">
              {item.title}
            </h3>

            <!-- Tabel Spesifikasi Ringkas -->
            <div class="space-y-1 text-xs font-roboto bg-gray-50 p-2.5 rounded-lg border border-gray-100 mb-3.5">
              {item.specs.map((s) => (
                <div class="flex items-start justify-between gap-1 border-b border-gray-200/50 pb-1 last:border-0 last:pb-0">
                  <span class="text-gray-500 font-medium">{s.label}:</span>
                  <span class="text-gray-900 font-bold text-right">{s.val}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Tombol CTA Pesan Cepat -->
          <div>
            <a
              href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Halo Admin ${siteConfig.businessName}, saya mau tanya stok & harga untuk ${item.title} di ${city}.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 px-3 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-montserrat font-bold transition-all shadow hover:shadow-md"
            >
              <i class="fab fa-whatsapp text-sm"></i>
              <span>Tanya Harga / Sewa</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Tombol Katalog Lengkap di Bawah -->
    <div class="text-center mt-10">
      <a
        class="inline-flex items-center gap-2 bg-gray-900 hover:bg-red-600 text-white px-7 py-3.5 rounded-xl font-semibold text-sm sm:text-base transition-all duration-300 transform hover:scale-105 shadow-lg font-montserrat"
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fas fa-file-pdf text-red-400"></i>
        <span>Minta Rincian Harga Lengkap (PDF)</span>
      </a>
    </div>
  </div>
</section>
