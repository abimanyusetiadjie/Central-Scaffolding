---

<!-- ==============================================
     KATALOG PRODUK RESMI (SISTEM TAB KATEGORI)
=============================================== -->
<section class="py-10 sm:py-16 bg-slate-50 border-y border-slate-200" id="products">
  <div class="container mx-auto px-4 max-w-7xl">
    <!-- Header Section -->
    <div class="text-center mb-6 sm:mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-red-50 border border-red-200 text-red-700 text-xs font-montserrat font-bold uppercase tracking-wider mb-2.5">
        <i class="fas fa-boxes-stacked text-xs"></i>
        <span>Katalog Resmi Gudang 2026</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-montserrat font-bold text-slate-900">
        Daftar Produk <span class="text-red-600">& Aksesoris</span>
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 font-roboto mt-2 max-w-2xl mx-auto">
        Tersedia layanan <strong>Sewa Harian/Bulanan</strong>, <strong>Jual Unit Baru (New)</strong>, dan <strong>Jual Unit Rekondisi (Second)</strong> berkualitas standar SNI.
      </p>
    </div>

    <!-- Navigasi Tab Kategori (Scrollable di layar sempit, Center di Desktop) -->
    <div
      class="flex items-center sm:justify-center gap-2 sm:gap-3 overflow-x-auto no-scrollbar pb-2 mb-6 sm:mb-8 -mx-4 px-4 sm:mx-0 sm:px-0"
      role="tablist"
      aria-label="Filter Kategori Produk Scaffolding"
    >
      {categories.map((cat, idx) => (
        <button
          type="button"
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
          data-filter-btn={cat.id}
          class:list={[
            'product-tab-btn inline-flex items-center gap-2 px-3.5 sm:px-5 py-2.5 rounded-xl font-montserrat font-bold text-xs sm:text-sm transition-all duration-200 shrink-0 border cursor-pointer',
            idx === 0
              ? 'bg-red-600 text-white border-red-600 shadow-sm'
              : 'bg-white text-slate-700 border-slate-200 hover:border-red-300 hover:text-red-600',
          ]}
        >
          <i class={`fas ${cat.icon} text-xs`}></i>
          <span>{cat.label}</span>
          <span
            data-badge-count
            class:list={[
              'text-[11px] px-1.5 py-0.5 rounded-md font-bold transition-colors',
              idx === 0 ? 'bg-red-700 text-white' : 'bg-slate-100 text-slate-600',
            ]}
          >
            {cat.count}
          </span>
        </button>
      ))}
    </div>

    <!-- Grid Kartu Produk: 2 Kolom di Mobile & Tablet, 3 Kolom di Laptop, 4 Kolom di Desktop -->
    <div
      id="product-catalog-grid"
      class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-5"
    >
      {products.map((item) => (
        <article
          data-product-card
          data-category={item.category}
          class="bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 p-2.5 sm:p-4 border border-slate-200 hover:border-red-600 flex flex-col justify-between group"
        >
          <div>
            <!-- Badge Pojok Atas -->
            <div class="flex justify-between items-center mb-2 gap-1">
              <span class="text-[10px] sm:text-xs font-montserrat font-bold uppercase bg-red-50 text-red-700 px-1.5 sm:px-2 py-0.5 rounded border border-red-100 truncate">
                {item.badge}
              </span>
              <span class="text-[10px] sm:text-xs font-bold text-emerald-700 bg-emerald-50 px-1.5 sm:px-2 py-0.5 rounded border border-emerald-100 shrink-0">
                ● Ready
              </span>
            </div>

            <!-- Frame Foto Produk Studio (Latar Putih Murni & Zoomed In) -->
            <div class="relative aspect-[16/11] w-full flex items-center justify-center p-0.5 sm:p-1 mb-2.5 bg-white rounded-lg border border-slate-100 overflow-hidden">
              <picture class="w-full h-full flex items-center justify-center">
                <source srcset={item.webp} type="image/webp" />
                <img
                  src={item.img}
                  alt={item.alt}
                  width="600"
                  height="420"
                  class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>

            <!-- Judul Produk -->
            <h3 class="text-xs sm:text-base font-montserrat font-bold text-slate-900 mb-2 group-hover:text-red-600 transition-colors leading-snug">
              {item.title}
            </h3>

            <!-- Tabel Spesifikasi Rapi -->
            <div class="space-y-1 sm:space-y-1.5 text-[11px] sm:text-xs font-roboto bg-slate-50 p-2 sm:p-2.5 rounded-lg border border-slate-100 mb-2.5 sm:mb-3">
              {item.specs.map((s) => (
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-0.5 sm:gap-2 border-b border-slate-200/60 pb-1 last:border-0 last:pb-0">
                  <span class="text-slate-500 font-medium shrink-0 text-[10px] sm:text-xs">{s.label}</span>
                  <span class="text-slate-900 font-bold sm:text-right truncate">{s.val}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Tombol CTA Pesan Cepat -->
          <a
            href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Halo Admin ${siteConfig.businessName}, saya mau tanya stok & harga (Sewa / Jual) untuk *${item.title}* di ${city}.`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 w-full py-2 sm:py-2.5 px-2.5 sm:px-3 bg-green-600 hover:bg-green-700 active:bg-green-800 text-white rounded-lg text-[11px] sm:text-xs font-montserrat font-bold transition-all shadow-sm hover:shadow-md"
          >
            <i class="fab fa-whatsapp text-xs sm:text-sm"></i>
            <span>Tanya Harga</span>
          </a>
        </article>
      ))}
    </div>

    <!-- Tombol Katalog Lengkap di Bawah -->
    <div class="text-center mt-8 sm:mt-10">
      <a
        class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 active:bg-red-800 text-white px-6 py-3.5 rounded-xl font-bold text-xs sm:text-sm transition-all duration-300 shadow-sm hover:shadow-md font-montserrat group"
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fas fa-file-invoice-dollar text-base text-white"></i>
        <span>Minta Pricelist Resmi 2026 (Sewa, Baru & Second) via WhatsApp</span>
      </a>
    </div>

    <!-- Trust Strip Ringkas (Bisa COD & Garansi Tukar) -->
    <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-6 mt-5 text-xs font-montserrat font-bold text-slate-700">
      <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full border border-slate-200 shadow-sm">
        <i class="fas fa-handshake text-emerald-600"></i> Bisa Bayar COD di Proyek
      </span>
      <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full border border-slate-200 shadow-sm">
        <i class="fas fa-rotate text-red-600"></i> Tersedia Unit Baru & Second
      </span>
      <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full border border-slate-200 shadow-sm">
        <i class="fas fa-truck-fast text-red-600"></i> Armada Sendiri 1–3 Jam
      </span>
    </div>
  </div>
</section>

<script>
  function initProductTabs() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]');
    const productCards = document.querySelectorAll<HTMLElement>('[data-product-card]');

    if (!tabButtons.length || !productCards.length) return;

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedCat = btn.getAttribute('data-filter-btn') || 'all';

        // Update active state on buttons
        tabButtons.forEach((b) => {
          const isCurrent = b === btn;
          b.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
          b.classList.toggle('bg-red-600', isCurrent);
          b.classList.toggle('text-white', isCurrent);
          b.classList.toggle('border-red-600', isCurrent);
          b.classList.toggle('shadow-sm', isCurrent);

          b.classList.toggle('bg-white', !isCurrent);
          b.classList.toggle('text-slate-700', !isCurrent);
          b.classList.toggle('border-slate-200', !isCurrent);

          const countBadge = b.querySelector('[data-badge-count]');
          if (countBadge) {
            countBadge.classList.toggle('bg-red-700', isCurrent);
            countBadge.classList.toggle('text-white', isCurrent);
            countBadge.classList.toggle('bg-slate-100', !isCurrent);
            countBadge.classList.toggle('text-slate-600', !isCurrent);
          }
        });

        // Filter cards
        productCards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (selectedCat === 'all' || cardCat === selectedCat) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  }

  initProductTabs();
  document.addEventListener('astro:after-swap', initProductTabs);
</script>
