---

<!-- ==============================================
     KATALOG PRODUK RESMI (SISTEM TAB KATEGORI)
=============================================== -->
<section class="py-10 sm:py-16 bg-slate-50 border-y border-slate-200" id="products">
  <div class="container mx-auto px-4 max-w-7xl">
    <!-- Header Section -->
    <div class="text-center mb-6 sm:mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-red-50 border border-red-200 text-red-700 text-xs font-montserrat font-bold uppercase tracking-wider mb-2.5">
        <i class="fas fa-boxes-stacked text-xs"></i>
        <span>Katalog Resmi Gudang 2026</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-montserrat font-bold text-slate-900">
        Daftar Produk <span class="text-red-600">& Aksesoris</span>
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 font-roboto mt-2 max-w-2xl mx-auto">
        Tersedia layanan <strong>Sewa Harian/Bulanan</strong>, <strong>Jual Unit Baru (New)</strong>, dan <strong>Jual Unit Rekondisi (Second)</strong> berkualitas standar SNI.
      </p>
    </div>

    <!-- Navigasi Tab Kategori (Scrollable di layar sempit, Center di Desktop) -->
    <div
      class="flex items-center sm:justify-center gap-2 sm:gap-3 overflow-x-auto no-scrollbar pb-2 mb-6 sm:mb-8 -mx-4 px-4 sm:mx-0 sm:px-0"
      role="tablist"
      aria-label="Filter Kategori Produk Scaffolding"
    >
      {categories.map((cat, idx) => (
        <button
          type="button"
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
          data-filter-btn={cat.id}
          class:list={[
            'product-tab-btn inline-flex items-center gap-2 px-3.5 sm:px-5 py-2.5 rounded-xl font-montserrat font-bold text-xs sm:text-sm transition-all duration-200 shrink-0 border cursor-pointer',
            idx === 0
              ? 'bg-red-600 text-white border-red-600 shadow-sm'
              : 'bg-white text-slate-700 border-slate-200 hover:border-red-300 hover:text-red-600',
          ]}
        >
          <i class={`fas ${cat.icon} text-xs`}></i>
          <span>{cat.label}</span>
          <span
            data-badge-count
            class:list={[
              'text-[11px] px-1.5 py-0.5 rounded-md font-bold transition-colors',
              idx === 0 ? 'bg-red-700 text-white' : 'bg-slate-100 text-slate-600',
            ]}
          >
            {cat.count}
          </span>
        </button>
      ))}
    </div>

    <!-- Indikator Geser di Layar HP (Mobile Swipe Hint - Anti Dead Scroll) -->
    <div class="flex items-center justify-between text-xs text-slate-500 font-roboto mb-3 px-1 sm:hidden">
      <span class="inline-flex items-center gap-1.5 font-medium text-slate-700 bg-white px-2.5 py-1 rounded-full border border-slate-200 shadow-xs">
        <i class="fas fa-arrows-left-right text-red-600 text-[10px]"></i>
        <span>Geser samping untuk cek barang</span>
      </span>
      <span class="text-[11px] font-bold text-slate-400">
        ← Geser Katalog →
      </span>
    </div>

    <!-- Container Produk: Horizontal Snap Slider di Mobile, Grid 4 Kolom di Desktop (Gaya 1) -->
    <div
      id="product-catalog-grid"
      class="flex overflow-x-auto snap-x snap-mandatory gap-3.5 pb-4 -mx-4 px-4 no-scrollbar sm:grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 sm:gap-5 sm:overflow-visible sm:pb-0 sm:mx-0 sm:px-0 max-w-7xl mx-auto"
    >
      {products.map((item) => (
        <article
          data-product-card
          data-category={item.category}
          class="w-[76vw] max-w-[275px] shrink-0 snap-center sm:w-auto sm:max-w-none sm:shrink bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 p-3.5 sm:p-4 border border-slate-200 hover:border-red-600 flex flex-col justify-between group"
        >
          <div>
            <!-- Badge Pojok Atas -->
            <div class="flex justify-between items-center mb-2.5 gap-1.5">
              <span class="text-[10px] sm:text-xs font-montserrat font-bold uppercase bg-red-50 text-red-700 px-2 py-0.5 rounded border border-red-100 truncate">
                {item.badge}
              </span>
              <span class="text-[10px] sm:text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100 shrink-0">
                ● Ready
              </span>
            </div>

            <!-- Trigger Frame Foto Produk (Klik untuk Popup Lightbox Detail) -->
            <button
              type="button"
              data-product-lightbox-trigger
              data-img-src={item.webp}
              data-img-alt={item.alt}
              data-title={item.title}
              data-badge={item.badge}
              data-specs={JSON.stringify(item.specs)}
              data-wa-url={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Halo Admin ${siteConfig.businessName}, saya mau tanya stok & harga untuk *${item.title}* di ${city}.`)}`}
              class="relative aspect-[16/11] w-full flex items-center justify-center p-0.5 sm:p-1 mb-2.5 bg-white rounded-lg border border-slate-100 overflow-hidden cursor-zoom-in group/img focus:outline-none focus:ring-2 focus:ring-red-500/40 text-left"
              aria-label={`Klik untuk melihat detail foto ${item.title}`}
            >
              <picture class="w-full h-full flex items-center justify-center">
                <source srcset={item.webp} type="image/webp" />
                <img
                  src={item.img}
                  alt={item.alt}
                  width="600"
                  height="420"
                  class="w-full h-full object-contain group-hover/img:scale-108 transition-transform duration-300"
                  loading="lazy"
                  decoding="async"
                />
              </picture>

              <!-- Micro Zoom/Expand Icon (Pojok Kanan Atas - Bersih, Ringkas & Bebas Halangan) -->
              <span class="absolute top-1.5 right-1.5 sm:top-2 sm:right-2 w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-white/95 hover:bg-white text-slate-600 hover:text-red-600 border border-slate-200/90 shadow-xs flex items-center justify-center backdrop-blur-sm transition-all duration-200 opacity-90 sm:opacity-0 group-hover/img:opacity-100 group-hover/img:scale-110">
                <i class="fas fa-expand text-[9px] sm:text-[10px]"></i>
              </span>
            </button>

            <!-- Judul Produk -->
            <h3 class="text-sm sm:text-base font-montserrat font-bold text-slate-900 mb-2 group-hover:text-red-600 transition-colors leading-snug">
              {item.title}
            </h3>

            <!-- Tabel Spesifikasi Rapi -->
            <div class="space-y-1.5 text-xs font-roboto bg-slate-50 p-2.5 rounded-lg border border-slate-100 mb-3">
              {item.specs.map((s) => (
                <div class="flex items-center justify-between gap-2 border-b border-slate-200/60 pb-1 last:border-0 last:pb-0">
                  <span class="text-slate-500 font-medium shrink-0">{s.label}</span>
                  <span class="text-slate-900 font-bold text-right truncate">{s.val}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Tombol CTA Pesan Cepat -->
          <a
            href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Halo Admin ${siteConfig.businessName}, saya mau tanya stok & harga (Sewa / Jual) untuk *${item.title}* di ${city}.`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 px-3 bg-green-600 hover:bg-green-700 active:bg-green-800 text-white rounded-lg text-xs font-montserrat font-bold transition-all shadow-sm hover:shadow-md"
          >
            <i class="fab fa-whatsapp text-sm"></i>
            <span>Tanya Harga</span>
          </a>
        </article>
      ))}
    </div>

    <!-- Tombol Katalog Lengkap di Bawah -->
    <div class="text-center mt-8 sm:mt-10">
      <a
        class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 active:bg-red-800 text-white px-6 py-3.5 rounded-xl font-bold text-xs sm:text-sm transition-all duration-300 shadow-sm hover:shadow-md font-montserrat group"
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fas fa-file-invoice-dollar text-base text-white"></i>
        <span>Minta Pricelist Resmi 2026 (Sewa, Baru & Second) via WhatsApp</span>
      </a>
    </div>

    <!-- Trust Strip Ringkas (Bisa COD & Garansi Tukar) -->
    <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-6 mt-5 text-xs font-montserrat font-bold text-slate-700">
      <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full border border-slate-200 shadow-sm">
        <i class="fas fa-handshake text-emerald-600"></i> Bisa Bayar COD di Proyek
      </span>
      <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full border border-slate-200 shadow-sm">
        <i class="fas fa-rotate text-red-600"></i> Tersedia Unit Baru & Second
      </span>
      <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full border border-slate-200 shadow-sm">
        <i class="fas fa-truck-fast text-red-600"></i> Armada Sendiri 1–3 Jam
      </span>
    </div>
  </div>

  <!-- ==============================================
       LIGHTBOX MODAL DETAIL PRODUK POP-UP
  =============================================== -->
  <div
    id="product-lightbox-modal"
    class="fixed inset-0 z-50 hidden opacity-0 transition-opacity duration-200 items-center justify-center p-3 sm:p-5 bg-slate-950/80 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-product-title"
  >
    <!-- Backdrop: klik untuk menutup -->
    <div class="absolute inset-0 cursor-pointer" data-close-lightbox></div>

    <!-- Kotak Dialog Modal -->
    <div
      id="product-lightbox-box"
      class="relative z-10 w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden transform scale-95 transition-transform duration-200 flex flex-col max-h-[92vh]"
    >
      <!-- Modal Header -->
      <div class="flex items-center justify-between px-4 sm:px-5 py-3 border-b border-slate-100 bg-slate-50">
        <div class="flex items-center gap-2">
          <span
            id="modal-product-badge"
            class="text-[10px] sm:text-xs font-montserrat font-bold uppercase bg-red-50 text-red-700 px-2 py-0.5 rounded border border-red-100"
          ></span>
          <span class="text-[10px] sm:text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">
            ● Ready Stok
          </span>
        </div>
        <button
          type="button"
          data-close-lightbox
          class="w-8 h-8 rounded-full bg-slate-200/80 hover:bg-red-50 hover:text-red-600 text-slate-600 flex items-center justify-center transition-colors focus:outline-none cursor-pointer"
          aria-label="Tutup popup"
        >
          <i class="fas fa-times text-sm"></i>
        </button>
      </div>

      <!-- Frame Foto Zoom Penuh (Resolusi Tinggi) -->
      <div class="relative bg-slate-50 p-3 sm:p-5 flex items-center justify-center overflow-hidden min-h-[220px] sm:min-h-[280px]">
        <img
          id="modal-product-img"
          src=""
          alt=""
          class="max-h-[46vh] sm:max-h-[52vh] w-auto max-w-full object-contain drop-shadow-sm rounded-lg"
        />
      </div>

      <!-- Detail & Tombol CTA -->
      <div class="p-4 sm:p-5 bg-white border-t border-slate-100">
        <h3 id="modal-product-title" class="text-base sm:text-lg font-montserrat font-bold text-slate-900 mb-2.5"></h3>
        
        <div id="modal-product-specs" class="grid grid-cols-3 gap-2 mb-4 bg-slate-50 p-2.5 rounded-lg border border-slate-100 text-xs font-roboto"></div>

        <div class="flex items-center gap-2">
          <a
            id="modal-product-wa"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 flex-1 py-2.5 px-3 bg-green-600 hover:bg-green-700 active:bg-green-800 text-white rounded-xl text-xs sm:text-sm font-montserrat font-bold transition-all shadow-sm hover:shadow-md"
          >
            <i class="fab fa-whatsapp text-base"></i>
            <span>Tanya Stok & Harga</span>
          </a>
          <button
            type="button"
            data-close-lightbox
            class="py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs sm:text-sm font-montserrat font-semibold transition-colors cursor-pointer"
          >
            Tutup
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initProductTabs() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]');
    const productCards = document.querySelectorAll<HTMLElement>('[data-product-card]');

    if (!tabButtons.length || !productCards.length) return;

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedCat = btn.getAttribute('data-filter-btn') || 'all';

        // Update active state on buttons
        tabButtons.forEach((b) => {
          const isCurrent = b === btn;
          b.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
          b.classList.toggle('bg-red-600', isCurrent);
          b.classList.toggle('text-white', isCurrent);
          b.classList.toggle('border-red-600', isCurrent);
          b.classList.toggle('shadow-sm', isCurrent);

          b.classList.toggle('bg-white', !isCurrent);
          b.classList.toggle('text-slate-700', !isCurrent);
          b.classList.toggle('border-slate-200', !isCurrent);

          const countBadge = b.querySelector('[data-badge-count]');
          if (countBadge) {
            countBadge.classList.toggle('bg-red-700', isCurrent);
            countBadge.classList.toggle('text-white', isCurrent);
            countBadge.classList.toggle('bg-slate-100', !isCurrent);
            countBadge.classList.toggle('text-slate-600', !isCurrent);
          }
        });

        // Filter cards
        productCards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (selectedCat === 'all' || cardCat === selectedCat) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });

        // Scroll mobile horizontal slider back to first item smoothly
        const catalogContainer = document.getElementById('product-catalog-grid');
        if (catalogContainer) {
          catalogContainer.scrollTo({ left: 0, behavior: 'smooth' });
        }
      });
    });
  }

  function initProductLightbox() {
    const modal = document.getElementById('product-lightbox-modal');
    const modalBox = document.getElementById('product-lightbox-box');
    const modalImg = document.getElementById('modal-product-img') as HTMLImageElement | null;
    const modalTitle = document.getElementById('modal-product-title');
    const modalBadge = document.getElementById('modal-product-badge');
    const modalSpecs = document.getElementById('modal-product-specs');
    const modalWa = document.getElementById('modal-product-wa') as HTMLAnchorElement | null;

    if (!modal || !modalBox || !modalImg || !modalTitle || !modalBadge || !modalSpecs || !modalWa) return;

    const triggers = document.querySelectorAll<HTMLElement>('[data-product-lightbox-trigger]');
    const closeButtons = modal.querySelectorAll<HTMLElement>('[data-close-lightbox]');

    function openModal(el: HTMLElement) {
      const imgSrc = el.getAttribute('data-img-src') || '';
      const imgAlt = el.getAttribute('data-img-alt') || '';
      const title = el.getAttribute('data-title') || '';
      const badge = el.getAttribute('data-badge') || '';
      const waUrl = el.getAttribute('data-wa-url') || '#';
      const specsRaw = el.getAttribute('data-specs') || '[]';

      modalImg!.src = imgSrc;
      modalImg!.alt = imgAlt;
      modalTitle!.textContent = title;
      modalBadge!.textContent = badge;
      modalWa!.href = waUrl;

      try {
        const specs = JSON.parse(specsRaw);
        modalSpecs!.innerHTML = specs
          .map(
            (s: { label: string; val: string }) => `
            <div class="flex flex-col">
              <span class="text-slate-400 text-[10px] font-medium">${s.label}</span>
              <span class="text-slate-800 font-bold text-[11px] truncate">${s.val}</span>
            </div>
          `
          )
          .join('');
      } catch (e) {
        modalSpecs!.innerHTML = '';
      }

      modal!.classList.remove('hidden');
      modal!.classList.add('flex');
      document.body.style.overflow = 'hidden';

      // Animasi transisi masuk halus
      requestAnimationFrame(() => {
        modal!.classList.remove('opacity-0');
        modal!.classList.add('opacity-100');
        modalBox!.classList.remove('scale-95');
        modalBox!.classList.add('scale-100');
      });
    }

    function closeModal() {
      modal!.classList.remove('opacity-100');
      modal!.classList.add('opacity-0');
      modalBox!.classList.remove('scale-100');
      modalBox!.classList.add('scale-95');

      setTimeout(() => {
        modal!.classList.remove('flex');
        modal!.classList.add('hidden');
        document.body.style.overflow = '';
      }, 200);
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => openModal(trigger));
    });

    closeButtons.forEach((btn) => {
      btn.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal!.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  function initProductsSection() {
    initProductTabs();
    initProductLightbox();
  }

  initProductsSection();
  document.addEventListener('astro:after-swap', initProductsSection);
</script>
