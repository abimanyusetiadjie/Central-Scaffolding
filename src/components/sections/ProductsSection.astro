---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau minta katalog lengkap dan penawaran harga scaffolding untuk proyek di ${city}.`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;

const products = [
  {
    title: 'Main Frame Scaffolding',
    webp: '/assets/img/product/mainframepng.webp',
    img: '/assets/img/product/mainframepng.png',
    alt: `Sewa dan jual scaffolding Main Frame 170cm dan 190cm pipa tebal SNI di ${city}`,
    specs: [
      { label: 'Ukuran', val: '170 / 190 x 122 cm' },
      { label: 'Pipa', val: '1.8 – 2.0 mm SNI' },
      { label: '1 Set', val: '2 Frame, 2 Silang, 4 Pin' },
    ],
    badge: 'Paling Laris',
  },
  {
    title: 'Bekisting System (Cor)',
    webp: '/assets/img/product/Bekistingpng.webp',
    img: '/assets/img/product/Bekistingpng.png',
    alt: `Sewa bekisting system penyangga pengecoran balok dan plat lantai beton di ${city}`,
    specs: [
      { label: 'Fungsi', val: 'Cor Balok & Plat Lantai' },
      { label: 'Part', val: 'U-Head, Jack Base, Pipa' },
      { label: 'Bahan', val: 'Baja Beban Berat' },
    ],
    badge: 'Spesialis Cor',
  },
  {
    title: 'Tubular System (Heavy)',
    webp: '/assets/img/product/tubularsystempng.webp',
    img: '/assets/img/product/tubularsystempng.png',
    alt: `Sewa scaffolding Tubular System pipa seamless heavy duty proyek industri di ${city}`,
    specs: [
      { label: 'Fungsi', val: 'Industri & Ketinggian' },
      { label: 'Sistem', val: 'Pipa Seamless + Klem' },
      { label: 'Desain', val: 'Fleksibel Segala Sudut' },
    ],
    badge: 'Heavy Duty',
  },
  {
    title: 'PCH Kwikstage System',
    webp: '/assets/img/product/Kwikstagepng.webp',
    img: '/assets/img/product/Kwikstagepng.png',
    alt: `Sewa scaffolding PCH Kwikstage System konstruksi gedung bertingkat di ${city}`,
    specs: [
      { label: 'Aplikasi', val: 'Gedung & Hotel Tinggi' },
      { label: 'Kuncian', val: 'Sistem Baji (Wedge)' },
      { label: 'Beban', val: 'Kapasitas Ekstra Berat' },
    ],
    badge: 'Gedung Tinggi',
  },
  {
    title: 'Ringlock System (Modular)',
    webp: '/assets/img/product/ringlocksystem.webp',
    img: '/assets/img/product/ringlocksystem.png',
    alt: `Sewa scaffolding Ringlock System modular rosette standar K3 internasional di ${city}`,
    specs: [
      { label: 'Aplikasi', val: 'Jembatan & Pabrik' },
      { label: 'Sistem', val: 'Rosette 8 Arah K3' },
      { label: 'Kualitas', val: 'Kekakuan Tertinggi' },
    ],
    badge: 'Standar K3',
  },
];
---

<!-- ==============================================
     PRODUK UNGGULAN (COMPACT & RAPI DI MOBILE)
=============================================== -->
<section class="py-10 sm:py-14 bg-slate-50 border-y border-slate-200" id="products">
  <div class="container mx-auto px-4">
    <div class="text-center mb-6 sm:mb-9">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-red-50 border border-red-200 text-red-700 text-xs font-montserrat font-bold uppercase tracking-wider mb-2">
        <i class="fas fa-boxes-stacked text-xs"></i>
        <span>Katalog Ready Stok</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-montserrat font-bold text-slate-900">
        Produk <span class="text-red-600">Unggulan Kami</span>
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 font-roboto mt-1 sm:hidden">
        Geser ke samping untuk melihat pilihan produk →
      </p>
    </div>

    <!-- 5 Produk Unggulan: Horizontal Snap di Mobile, 2 Kolom Tablet, 3 Kolom Laptop, 5 Kolom Desktop Luas -->
    <div class="flex overflow-x-auto snap-x snap-mandatory gap-3.5 pb-3 -mx-4 px-4 no-scrollbar sm:grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 sm:gap-5 sm:overflow-visible sm:pb-0 sm:mx-0 sm:px-0 max-w-7xl mx-auto">
      {products.map((item) => (
        <article class="w-[78vw] max-w-[265px] shrink-0 snap-center sm:w-auto sm:max-w-none sm:shrink bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 p-3.5 sm:p-4 border border-slate-200 hover:border-red-600 flex flex-col justify-between group">
          <div>
            <!-- Badge Pojok Atas -->
            <div class="flex justify-between items-center mb-2.5 gap-1">
              <span class="text-xs font-montserrat font-bold uppercase bg-red-50 text-red-700 px-2 py-0.5 rounded border border-red-100 whitespace-nowrap">
                {item.badge}
              </span>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100 shrink-0 whitespace-nowrap">
                ● Ready
              </span>
            </div>

            <!-- Frame Foto Produk Compact -->
            <div class="relative aspect-[16/11] w-full flex items-center justify-center p-2.5 mb-2.5 bg-slate-50 rounded-lg border border-slate-100 group-hover:bg-slate-100/80 transition-colors overflow-hidden">
              <picture class="w-full h-full flex items-center justify-center">
                <source srcset={item.webp} type="image/webp" />
                <img
                  src={item.img}
                  alt={item.alt}
                  width="360"
                  height="250"
                  class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>

            <!-- Judul Produk -->
            <h3 class="text-sm sm:text-base font-montserrat font-bold text-slate-900 mb-2 group-hover:text-red-600 transition-colors leading-snug">
              {item.title}
            </h3>

            <!-- Tabel Spesifikasi Rapi 1 Baris per Item (Mudah Dibaca) -->
            <div class="space-y-1.5 text-xs font-roboto bg-slate-50 p-2.5 rounded-lg border border-slate-100 mb-3">
              {item.specs.map((s) => (
                <div class="flex items-center justify-between gap-2 border-b border-slate-200/60 pb-1 last:border-0 last:pb-0">
                  <span class="text-slate-500 font-medium shrink-0">{s.label}</span>
                  <span class="text-slate-900 font-bold text-right whitespace-nowrap">{s.val}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Tombol CTA Pesan Cepat -->
          <a
            href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Halo Admin ${siteConfig.businessName}, saya mau tanya stok & harga untuk ${item.title} di ${city}.`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 px-3 bg-green-600 hover:bg-green-700 active:bg-green-800 text-white rounded-lg text-xs font-montserrat font-bold transition-all shadow-sm hover:shadow-md"
          >
            <i class="fab fa-whatsapp text-sm"></i>
            <span>Tanya Harga / Sewa</span>
          </a>
        </article>
      ))}
    </div>

    <!-- Tombol Katalog Lengkap di Bawah -->
    <div class="text-center mt-7 sm:mt-9">
      <a
        class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 active:bg-red-800 text-white px-6 py-3 rounded-xl font-bold text-xs sm:text-sm transition-all duration-300 shadow-sm hover:shadow-md font-montserrat group"
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fas fa-file-pdf text-base text-white"></i>
        <span>Minta Daftar Harga Lengkap via WhatsApp</span>
      </a>
    </div>

    <!-- Trust Strip Ringkas (Bisa COD & Garansi Tukar) -->
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 mt-5 text-xs font-montserrat font-bold text-slate-700">
      <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1 rounded-full border border-slate-200 shadow-sm">
        <i class="fas fa-handshake text-emerald-600"></i> Bisa Bayar COD di Proyek
      </span>
      <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1 rounded-full border border-slate-200 shadow-sm">
        <i class="fas fa-rotate text-red-600"></i> Garansi Tukar Unit Langsung
      </span>
      <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1 rounded-full border border-slate-200 shadow-sm">
        <i class="fas fa-truck-fast text-red-600"></i> Armada Sendiri 1–3 Jam
      </span>
    </div>
  </div>
</section>
