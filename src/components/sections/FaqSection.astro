---
import { siteConfig, getFaqItems } from '../../data/siteConfig';
import { PhoneCall, MessageCircle, ShieldCheck, ChevronDown } from 'lucide-react';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

const faqItems = getFaqItems(city);

const waFaqMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya-tanya soal sewa / beli scaffolding untuk proyek di ${city}. Mohon dibantu.`
);
const waFaqUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waFaqMessage}`;
---

<!-- ==============================================
     FAQ / TANYA JAWAB (GAYA PERSIS PT SNI)
=============================================== -->
<section class="py-20 bg-white" id="faq">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-montserrat font-bold text-orange-600 mb-4">
        Pertanyaan Umum <span class="text-gray-800">Seputar Scaffolding</span>
      </h2>
      <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto text-center font-roboto">
        Jawaban praktis dan transparan seputar sistem sewa, syarat COD, dan mutu pipa bersertifikat di {city}.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Support Box Khas PT SNI -->
      <div class="lg:col-span-4 flex flex-col gap-6">
        <div class="bg-gray-50 p-6 sm:p-7 rounded-xl shadow-lg border border-gray-100 flex flex-col gap-4">
          <div class="w-12 h-12 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center font-bold">
            <PhoneCall className="w-6 h-6" />
          </div>
          <div>
            <h3 class="text-xl font-montserrat font-bold text-gray-800">
              Butuh Hitung Kebutuhan Set?
            </h3>
            <p class="text-sm text-gray-600 mt-2 font-roboto leading-relaxed">
              Sebutkan tinggi dinding atau luas bidang kerja proyek Anda di <strong>{city}</strong>. Mandor logistik kami akan bantu hitungkan rincian set dan aksesorisnya secara gratis.
            </p>
          </div>
          <div class="pt-2">
            <a
              href={waFaqUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-wa-source="faq_cta"
              data-wa-mode="SEWA & BELI"
              data-wa-city={city}
              class="w-full bg-orange-600 hover:bg-orange-700 text-white py-3 px-4 rounded-lg font-montserrat font-bold text-sm transition-all duration-300 flex items-center justify-center gap-2 shadow-md hover:shadow-lg text-center"
            >
              <MessageCircle className="w-4 h-4 fill-current" />
              <span>TANYA VIA WHATSAPP</span>
            </a>
          </div>
        </div>

        <div class="bg-gray-900 text-white p-6 rounded-xl shadow-lg">
          <div class="flex items-center gap-2 text-orange-400 text-sm font-montserrat font-bold mb-1">
            <ShieldCheck className="w-5 h-5 text-orange-400 shrink-0" />
            <span>Garansi Mutu Pipa SNI</span>
          </div>
          <p class="text-xs text-gray-300 font-roboto leading-relaxed mt-2">
            Pipa tebal {siteConfig.stats.pipeThickness} berstandar SNI 07-0065 &amp; K3 Kemnaker. Jaminan langsung tukar unit jika ditemukan cacat saat dibongkar di proyek.
          </p>
        </div>
      </div>

      <!-- Right Column: Accordion Questions -->
      <div class="lg:col-span-8 space-y-4">
        {faqItems.map((item, index) => (
          <details
            open={index === 0}
            class="group bg-gray-50 rounded-xl border border-gray-200 shadow-sm overflow-hidden transition-all duration-300"
          >
            <summary class="list-none cursor-pointer p-5 flex items-center justify-between gap-4 font-montserrat font-bold text-gray-800 hover:text-orange-600 transition-colors select-none">
              <div class="flex items-center gap-3.5 text-left">
                <span class="text-xs font-montserrat font-bold bg-white text-orange-600 px-3 py-1 rounded-md shrink-0 border border-gray-200">
                  0{index + 1}
                </span>
                <span class="text-base sm:text-lg leading-snug">
                  {item.question}
                </span>
              </div>
              <span class="shrink-0 text-gray-400 group-open:rotate-180 transition-transform duration-300">
                <ChevronDown className="w-5 h-5" />
              </span>
            </summary>

            <div class="px-5 pb-5 pt-1 text-gray-600 text-sm sm:text-base leading-relaxed border-t border-gray-200/60 mt-1 bg-white font-roboto">
              <p class="pt-3">{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>