---
import { siteConfig, getFaqItems } from '../../data/siteConfig';
import { PhoneCall, MessageCircle, ShieldCheck, ChevronDown } from 'lucide-react';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

const faqItems = getFaqItems(city);

const waFaqMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya-tanya soal sewa / beli scaffolding untuk proyek di ${city}. Mohon dibantu.`
);
const waFaqUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waFaqMessage}`;
---

<!-- FAQ SECTION KHAS ELEMENTOR ACCORDION -->
<section
  id="faq"
  aria-labelledby="faq-heading"
  class="w-full bg-white py-16 px-4 sm:px-6 lg:px-8 border-b border-slate-200 scroll-mt-20"
>
  <div class="max-w-6xl mx-auto flex flex-col gap-10">
    <!-- Header Khas WordPress -->
    <div class="text-center max-w-3xl mx-auto flex flex-col gap-2.5">
      <span class="inline-flex items-center gap-1.5 bg-blue-100 text-[#0284c7] px-4 py-1 rounded-full text-xs font-black uppercase tracking-wider w-fit mx-auto">
        TANYA JAWAB UMUM
      </span>
      <h2
        id="faq-heading"
        class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight"
      >
        Pertanyaan Umum Seputar Sewa &amp; Jual Scaffolding
      </h2>
      <p class="text-base sm:text-lg text-slate-600 font-normal">
        Jawaban praktis dan transparan seputar sistem sewa, syarat COD, dan jaminan mutu pipa di {city}.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Fast Help Box -->
      <div class="lg:col-span-4 flex flex-col gap-4">
        <div class="bg-slate-50 p-6 sm:p-7 rounded-2xl border border-slate-200 shadow-xs flex flex-col gap-4">
          <div class="w-11 h-11 rounded-xl bg-blue-100 text-[#0284c7] flex items-center justify-center font-bold">
            <PhoneCall className="w-5 h-5" />
          </div>
          <div>
            <h3 class="text-xl font-black text-slate-900">
              Butuh Hitung Jumlah Set?
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1.5 leading-relaxed">
              Sebutkan tinggi dinding atau luas bidang kerja proyek Anda di <strong>{city}</strong>. Mandor logistik kami akan bantu hitungkan rincian set dan aksesorisnya secara gratis.
            </p>
          </div>
          <div class="pt-1">
            <a
              href={waFaqUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-wa-source="faq_cta"
              data-wa-mode="SEWA & BELI"
              data-wa-city={city}
              class="w-full min-h-[46px] bg-[#25D366] hover:bg-[#20bd5a] text-white flex items-center justify-center gap-2 rounded-full text-xs uppercase font-black tracking-wider shadow-sm hover:shadow-md transition active:scale-95 text-center"
            >
              <MessageCircle className="w-4 h-4 fill-current" />
              <span>TANYA MANDOR VIA WHATSAPP</span>
            </a>
          </div>
        </div>

        <div class="bg-[#0f172a] text-white p-5 rounded-2xl shadow-xs">
          <div class="flex items-center gap-2 text-amber-300 text-xs sm:text-sm font-black uppercase mb-1">
            <ShieldCheck className="w-4 h-4 text-amber-300 shrink-0" />
            <span>Garansi Mutu Pipa SNI</span>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">
            Pipa tebal {siteConfig.stats.pipeThickness} berstandar SNI 07-0065 &amp; K3 Kemnaker. Jaminan langsung tukar unit jika ditemukan cacat saat dibongkar di proyek.
          </p>
        </div>
      </div>

      <!-- Right Column: Accordion Questions -->
      <div class="lg:col-span-8 space-y-3">
        {faqItems.map((item, index) => (
          <details
            open={index === 0}
            class="group bg-slate-50 rounded-xl border border-slate-200 shadow-xs overflow-hidden transition-all"
          >
            <summary class="list-none cursor-pointer p-4 sm:p-5 flex items-center justify-between gap-4 font-black text-slate-900 hover:text-[#0284c7] transition-colors select-none">
              <div class="flex items-center gap-3 text-left">
                <span class="text-xs font-black bg-white text-slate-700 px-2.5 py-1 rounded-md shrink-0 border border-slate-200">
                  0{index + 1}
                </span>
                <span class="text-base sm:text-lg leading-snug">
                  {item.question}
                </span>
              </div>
              <span class="shrink-0 text-slate-400 group-open:rotate-180 transition-transform">
                <ChevronDown className="w-5 h-5" />
              </span>
            </summary>

            <div class="px-5 pb-5 pt-1 text-slate-600 text-sm sm:text-base leading-relaxed border-t border-slate-200/60 mt-1 bg-white">
              <p class="pt-3">{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>