---
import { siteConfig, getFaqItems } from '../../data/siteConfig';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;
const faqItems = getFaqItems(city);
---

<!-- ==============================================
     FAQ SEWA SCAFFOLDING (EXACT 1-TO-1 PT SNI)
=============================================== -->
<section class="py-20 bg-white" id="faq">
  <div class="container mx-auto px-4 font-montserrat">
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold text-red-600 mb-4">
        FAQ
        <span class="text-gray-800">
          Sewa Scaffolding
        </span>
      </h2>
      <p class="text-base md:text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed font-roboto">
        Kumpulan pertanyaan yang paling sering diajukan terkait jasa sewa scaffolding dan sewa bekisting di {city} dan wilayah Jabodetabek. Jika pertanyaan Anda belum terjawab di bawah ini, silakan hubungi tim kami.
      </p>
    </div>

    <div class="max-w-3xl mx-auto space-y-4">
      {faqItems.map((item, index) => (
        <details
          open={index === 0}
          class="border border-gray-200 rounded-lg p-4 bg-gray-50 group transition-all"
        >
          <summary class="font-semibold text-gray-800 cursor-pointer flex justify-between items-center list-none select-none">
            <span class="pr-4">{item.question}</span>
            <i class="fas fa-chevron-down text-red-600 transition-transform group-open:rotate-180 flex-shrink-0"></i>
          </summary>
          <div class="mt-3 text-gray-600 text-sm leading-relaxed font-roboto pt-2 border-t border-gray-200/60">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
