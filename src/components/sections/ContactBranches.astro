---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau minta shareloc / tanya rute ke gudang pusat di ${siteConfig.warehouseAddress.street}, ${siteConfig.warehouseAddress.city}.`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;
---

<!-- ==============================================
     LOKASI GUDANG PUSAT & KONTAK RESMI (1 PETA UTAMA TANGERANG)
=============================================== -->
<section class="py-16 bg-gray-50 border-t border-gray-200" id="contact">
  <div class="container mx-auto px-4 font-montserrat">
    <!-- Header Section -->
    <div class="text-center mb-10 sm:mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-50 text-red-600 text-xs font-montserrat font-bold uppercase tracking-wider mb-2.5">
        <i class="fas fa-map-location-dot text-sm"></i>
        <span>Lokasi Gudang Pusat &amp; Kontak Resmi</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-montserrat font-bold text-gray-900 mb-3">
        Kunjungi Gudang Pusat <span class="text-red-600">Central Scaffolding</span>
      </h2>
      <p class="text-sm sm:text-base text-gray-600 max-w-2xl mx-auto font-roboto">
        Silakan datang langsung untuk survei stok fisik, cek ketebalan pipa SNI 1.8mm – 2.0mm dengan jangka sorong, atau order via WhatsApp untuk pengiriman cepat ke {city}.
      </p>
    </div>

    <!-- Grid Utama: 1 Peta Utama di Kiri (7 Kolom) + Detail Toko & Jalur Depo di Kanan (5 Kolom) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start max-w-7xl mx-auto">
      
      <!-- KOLOM KIRI: 1 PETA GOOGLE MAPS UTAMA (GUDANG PUSAT TANGERANG) -->
      <div class="lg:col-span-7 bg-white p-4 sm:p-5 rounded-2xl border-2 border-gray-200 shadow-sm flex flex-col justify-between">
        <!-- Frame Iframe Google Maps Tunggal -->
        <div class="relative w-full h-[320px] sm:h-[400px] rounded-xl overflow-hidden border border-gray-200 shadow-inner bg-slate-100 mb-4">
          <iframe
            allowfullscreen=""
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            src={siteConfig.warehouseAddress.googleMapsEmbedUrl}
            style="border:0;"
            title={`Peta Lokasi Gudang Pusat ${siteConfig.businessName} Tangerang`}
          >
          </iframe>
        </div>

        <!-- Tombol Aksi Bawah Peta -->
        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between pt-1">
          <a
            href={siteConfig.warehouseAddress.gmapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 bg-[#1a73e8] hover:bg-[#1557b0] active:bg-[#10448d] text-white px-5 py-3 rounded-xl font-bold text-sm transition-all shadow hover:shadow-md font-montserrat group"
          >
            <i class="fas fa-map-marker-alt text-base transition-transform group-hover:scale-110"></i>
            <span>Buka Rute di Google Maps</span>
          </a>

          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 bg-green-600 hover:bg-green-700 active:bg-green-800 text-white px-5 py-3 rounded-xl font-bold text-sm transition-all shadow hover:shadow-md font-montserrat group"
          >
            <i class="fab fa-whatsapp text-lg transition-transform group-hover:scale-110"></i>
            <span>Minta Shareloc WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- KOLOM KANAN: DETAIL ALAMAT GUDANG PUSAT & JALUR ARMADA (5 Kolom) -->
      <div class="lg:col-span-5 space-y-5">
        
        <!-- KARTU UTAMA: DETAIL GUDANG PUSAT TANGERANG -->
        <div class="bg-white p-5 sm:p-6 rounded-2xl border-2 border-gray-200 shadow-sm">
          <!-- Badge Buka -->
          <div class="flex items-center justify-between mb-3 pb-3 border-b border-gray-100">
            <span class="text-xs font-montserrat font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Buka Setiap Hari (07.00 - 18.00 WIB)</span>
            </span>
            <span class="text-xs font-bold text-gray-500 font-mono">Pusat Tangerang</span>
          </div>

          <h3 class="text-lg sm:text-xl font-montserrat font-extrabold text-gray-900 mb-3">
            Toko Central Scaffolding
          </h3>

          <div class="space-y-3.5 font-roboto text-sm text-gray-700">
            <!-- Alamat Lengkap -->
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-red-50 text-red-600 flex items-center justify-center shrink-0 mt-0.5">
                <i class="fas fa-map-marker-alt text-sm"></i>
              </div>
              <div>
                <p class="font-bold text-gray-900">Alamat Toko &amp; Gudang:</p>
                <p class="text-gray-600 text-xs sm:text-sm leading-relaxed mt-0.5">
                  {siteConfig.warehouseAddress.street}, {siteConfig.warehouseAddress.district}, Kota {siteConfig.warehouseAddress.city}, {siteConfig.warehouseAddress.province} {siteConfig.warehouseAddress.postalCode}
                </p>
              </div>
            </div>

            <!-- Telepon & Hotline -->
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-red-50 text-red-600 flex items-center justify-center shrink-0 mt-0.5">
                <i class="fas fa-phone text-sm"></i>
              </div>
              <div>
                <p class="font-bold text-gray-900">Hotline Telepon Gudang:</p>
                <a class="text-red-600 hover:underline font-bold text-xs sm:text-sm" href={`tel:${siteConfig.phone}`}>
                  {siteConfig.phoneDisplay}
                </a>
              </div>
            </div>

            <!-- WhatsApp -->
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-green-50 text-green-600 flex items-center justify-center shrink-0 mt-0.5">
                <i class="fab fa-whatsapp text-base"></i>
              </div>
              <div>
                <p class="font-bold text-gray-900">WhatsApp Fast Response:</p>
                <a class="text-emerald-700 hover:underline font-extrabold text-xs sm:text-sm" href={waUrl} target="_blank" rel="noopener noreferrer">
                  {siteConfig.whatsappDisplay} (Konsultasi &amp; Order)
                </a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-slate-50 text-slate-600 flex items-center justify-center shrink-0 mt-0.5">
                <i class="fas fa-envelope text-sm"></i>
              </div>
              <div>
                <p class="font-bold text-gray-900">Email Resmi:</p>
                <a class="text-gray-600 hover:text-red-600 transition-colors text-xs sm:text-sm" href={`mailto:${siteConfig.email}`}>
                  {siteConfig.email}
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- KARTU KEDUA: JALUR SIAGA ARMADA CEPAT JABODETABEK -->
        <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
          <div class="flex items-center gap-2 mb-3">
            <i class="fas fa-truck-fast text-red-600"></i>
            <h4 class="font-montserrat font-bold text-sm text-gray-900 uppercase tracking-wide">
              Jalur Depo Armada Siaga (Antar Cepat):
            </h4>
          </div>

          <div class="space-y-2 font-roboto text-xs text-gray-600">
            <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-100 flex items-center justify-between">
              <span class="font-semibold text-gray-800">Tangerang &amp; Bandara Soetta</span>
              <span class="text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded text-[11px]">Kirim 1 - 3 Jam</span>
            </div>
            <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-100 flex items-center justify-between">
              <span class="font-semibold text-gray-800">Jakarta Barat, Selatan &amp; Pusat</span>
              <span class="text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded text-[11px]">Kirim 2 - 3 Jam</span>
            </div>
            <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-100 flex items-center justify-between">
              <span class="font-semibold text-gray-800">BSD City, Serpong &amp; Tangsel</span>
              <span class="text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded text-[11px]">Kirim 1 - 2 Jam</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
