---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
  whatsappNumber?: string;
}

const {
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau minta shareloc / tanya rute ke gudang pusat di ${siteConfig.warehouseAddress.street}, ${siteConfig.warehouseAddress.city}.`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;
---

<!-- ==============================================
     LOKASI GUDANG PUSAT & KONTAK RESMI (COMPACT MOBILE)
=============================================== -->
<section class="py-10 sm:py-14 bg-slate-50 border-t border-slate-200" id="contact">
  <div class="container mx-auto px-4 font-montserrat">
    <!-- Header Section -->
    <div class="text-center mb-6 sm:mb-9">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-50 text-red-600 text-[11px] font-montserrat font-bold uppercase tracking-wider mb-2">
        <i class="fas fa-map-location-dot text-xs"></i>
        <span>Kontak &amp; Lokasi Gudang</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-montserrat font-bold text-gray-900">
        Gudang Pusat <span class="text-red-600">&amp; Cabang Resmi</span>
      </h2>
    </div>

    <!-- Grid Utama: Peta di Kiri (7 Kolom) + Detail Gudang di Kanan (5 Kolom) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-7 items-stretch max-w-6xl mx-auto">
      
      <!-- KOLOM KIRI: PETA GOOGLE MAPS GUDANG PUSAT TANGERANG -->
      <div class="lg:col-span-7 bg-white p-3.5 sm:p-5 rounded-2xl border border-gray-200 shadow-xs flex flex-col justify-between">
        <div class="relative w-full h-[230px] sm:h-[340px] rounded-xl overflow-hidden border border-gray-200 bg-slate-100 mb-3.5">
          <iframe
            allowfullscreen=""
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            src={siteConfig.warehouseAddress.googleMapsEmbedUrl}
            style="border:0;"
            title={`Peta Lokasi Gudang Pusat ${siteConfig.businessName} Tangerang`}
          >
          </iframe>
        </div>

        <!-- Tombol Aksi Bawah Peta -->
        <div class="grid grid-cols-2 gap-2.5 sm:gap-3">
          <a
            href={siteConfig.warehouseAddress.gmapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 sm:gap-2 bg-[#1a73e8] hover:bg-[#1557b0] text-white px-3 py-2.5 sm:px-4 sm:py-3 rounded-xl font-bold text-xs sm:text-sm transition-all shadow-xs font-montserrat"
          >
            <i class="fas fa-map-marker-alt text-xs sm:text-sm"></i>
            <span>Buka Google Maps</span>
          </a>

          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 sm:gap-2 bg-green-600 hover:bg-green-700 text-white px-3 py-2.5 sm:px-4 sm:py-3 rounded-xl font-bold text-xs sm:text-sm transition-all shadow-xs font-montserrat"
          >
            <i class="fab fa-whatsapp text-sm sm:text-base"></i>
            <span>Shareloc WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- KOLOM KANAN: DETAIL ALAMAT GUDANG PUSAT & CABANG -->
      <div class="lg:col-span-5 bg-white p-4 sm:p-6 rounded-2xl border border-gray-200 shadow-xs flex flex-col justify-between">
        <div>
          <!-- Badge Buka -->
          <div class="flex items-center justify-between mb-3 pb-2.5 border-b border-gray-100">
            <span class="text-[11px] font-montserrat font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Buka Setiap Hari (07.00 – 18.00 WIB)</span>
            </span>
          </div>

          <h3 class="text-base sm:text-xl font-montserrat font-extrabold text-gray-900 mb-3">
            Toko Central Scaffolding
          </h3>

          <div class="space-y-3 font-roboto text-xs sm:text-sm text-gray-700">
            <!-- Alamat Gudang Pusat -->
            <div class="flex items-start gap-2.5">
              <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-red-50 text-red-600 flex items-center justify-center shrink-0 mt-0.5">
                <i class="fas fa-map-marker-alt text-xs sm:text-sm"></i>
              </div>
              <div>
                <p class="font-bold text-gray-900">Gudang Pusat (Tangerang &amp; Jabodetabek):</p>
                <p class="text-gray-600 leading-relaxed mt-0.5">
                  {siteConfig.warehouseAddress.street}, {siteConfig.warehouseAddress.district}, Kota {siteConfig.warehouseAddress.city}, {siteConfig.warehouseAddress.province} {siteConfig.warehouseAddress.postalCode}
                </p>
              </div>
            </div>

            <!-- Cabang Surabaya -->
            <div class="flex items-start gap-2.5">
              <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-red-50 text-red-600 flex items-center justify-center shrink-0 mt-0.5">
                <i class="fas fa-truck text-xs sm:text-sm"></i>
              </div>
              <div>
                <p class="font-bold text-gray-900">Surabaya &amp; Jawa Timur:</p>
                <p class="text-gray-600 leading-relaxed mt-0.5">
                  Layanan Proyek Surabaya, Gresik &amp; Sidoarjo
                </p>
              </div>
            </div>

            <!-- Telepon & WhatsApp -->
            <div class="flex items-start gap-2.5">
              <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-green-50 text-green-600 flex items-center justify-center shrink-0 mt-0.5">
                <i class="fab fa-whatsapp text-sm sm:text-base"></i>
              </div>
              <div>
                <p class="font-bold text-gray-900">Hotline Telepon &amp; WhatsApp:</p>
                <a class="text-emerald-700 hover:underline font-extrabold" href={waUrl} target="_blank" rel="noopener noreferrer">
                  {siteConfig.whatsappDisplay} (Fast Response)
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Note Kredibilitas di Bawah Kartu -->
        <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-[11px] font-roboto text-gray-500">
          <span>✔ Boleh Cek Fisik ke Gudang</span>
          <span>✔ Bisa Bayar COD</span>
        </div>
      </div>

    </div>
  </div>
</section>
