---
import { siteConfig } from '../../data/siteConfig';
import { MessageSquare } from 'lucide-react';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau pesan scaffolding untuk proyek di ${city}. Mohon dibantu prosesnya.`
);
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMessage}`;
---

<!-- ==============================================
     CARA PEMESANAN (GAYA PERSIS PT SNI)
=============================================== -->
<section class="py-20 bg-white" id="cara-pesan">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-montserrat font-bold text-orange-600 mb-4">
        Cara Pemesanan <span class="text-gray-800">Scaffolding</span>
      </h2>
      <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto text-center font-roboto">
        Proses cepat dan transparan tanpa birokrasi berbelit. Pesan sekarang, armada langsung berangkat ke proyek di {city}.
      </p>
    </div>

    <!-- 3 Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Step 1 -->
      <div class="bg-gray-50 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center flex flex-col items-center border border-gray-100">
        <div class="w-16 h-16 rounded-full bg-orange-600 text-white flex items-center justify-center text-2xl font-montserrat font-bold mb-6 shadow-md">
          1
        </div>
        <h3 class="text-2xl font-montserrat font-bold text-gray-800 mb-3">
          Hubungi via WhatsApp
        </h3>
        <p class="text-gray-600 text-sm font-roboto leading-relaxed">
          Kirimkan kebutuhan sewa atau beli, estimasi jumlah set, dan share-lokasi proyek Anda di {city} kepada admin kami.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="bg-gray-50 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center flex flex-col items-center border border-gray-100">
        <div class="w-16 h-16 rounded-full bg-orange-600 text-white flex items-center justify-center text-2xl font-montserrat font-bold mb-6 shadow-md">
          2
        </div>
        <h3 class="text-2xl font-montserrat font-bold text-gray-800 mb-3">
          Armada Langsung Antar
        </h3>
        <p class="text-gray-600 text-sm font-roboto leading-relaxed">
          Scaffolding dimuat dari gudang pusat Cipondoh dan langsung meluncur ke lokasi proyek Anda dalam 1-3 jam perjalanan.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="bg-gray-50 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 p-8 text-center flex flex-col items-center border border-gray-100">
        <div class="w-16 h-16 rounded-full bg-orange-600 text-white flex items-center justify-center text-2xl font-montserrat font-bold mb-6 shadow-md">
          3
        </div>
        <h3 class="text-2xl font-montserrat font-bold text-gray-800 mb-3">
          Cek Barang &amp; Bayar (COD)
        </h3>
        <p class="text-gray-600 text-sm font-roboto leading-relaxed">
          Mandor Anda memeriksa kelengkapan fisik unit di lokasi proyek. Setelah sesuai, baru lakukan pelunasan di tempat.
        </p>
      </div>
    </div>

    <!-- Banner Callout Khas PT SNI -->
    <div class="bg-gray-900 text-white p-8 rounded-xl shadow-xl flex flex-col sm:flex-row items-center justify-between gap-6 mt-12">
      <div>
        <h4 class="text-2xl font-montserrat font-bold text-white">Butuh Konsultasi Perhitungan Set Proyek?</h4>
        <p class="text-gray-300 text-sm font-roboto mt-1">Tim mandor logistik kami aktif dan siap bantu hitung kebutuhan set secara gratis.</p>
      </div>
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-orange-600 hover:bg-orange-700 text-white font-montserrat font-bold text-base px-8 py-3.5 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 transform hover:scale-105 shrink-0 flex items-center gap-2"
      >
        <MessageSquare className="w-5 h-5 fill-current" />
        <span>KONSULTASI WHATSAPP</span>
      </a>
    </div>
  </div>
</section>