---
import { siteConfig } from '../../data/siteConfig';
import { MessageSquare } from 'lucide-react';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau pesan scaffolding untuk proyek di ${city}. Mohon dibantu prosesnya.`
);
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMessage}`;
---

<!-- 3 LANGKAH CARA PESAN KHAS LANDING PAGE ELEMENTOR -->
<section
  id="cara-pesan"
  aria-labelledby="order-steps-title"
  class="w-full bg-white py-16 px-4 sm:px-6 lg:px-8 border-b border-slate-200 scroll-mt-20"
>
  <div class="max-w-6xl mx-auto flex flex-col gap-10">
    <div class="text-center max-w-3xl mx-auto flex flex-col gap-2.5">
      <span class="inline-flex items-center gap-1.5 bg-emerald-100 text-emerald-800 px-4 py-1 rounded-full text-xs font-black uppercase tracking-wider w-fit mx-auto">
        PROSES MUDAH &amp; AMAN
      </span>
      <h2
        id="order-steps-title"
        class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight"
      >
        Cara Pemesanan Scaffolding (3 Langkah Cepat)
      </h2>
      <p class="text-base sm:text-lg text-slate-600 font-normal">
        Tanpa proses birokrasi ribet. Cukup kirim pesan, barang langsung kami antar ke proyek Anda di {city}.
      </p>
    </div>

    <!-- 3 Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      <!-- Step 1 -->
      <div class="bg-slate-50 p-6 sm:p-7 rounded-2xl border border-slate-200 text-center flex flex-col items-center gap-4 relative">
        <div class="w-16 h-16 rounded-full bg-[#25D366] text-white flex items-center justify-center text-2xl font-black shadow-md">
          1
        </div>
        <div>
          <h3 class="text-xl font-black text-slate-900">
            Hubungi via WhatsApp
          </h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">
            Sampaikan kebutuhan sewa atau beli, estimasi jumlah set, dan share lokasi proyek Anda kepada admin kami.
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="bg-slate-50 p-6 sm:p-7 rounded-2xl border border-slate-200 text-center flex flex-col items-center gap-4 relative">
        <div class="w-16 h-16 rounded-full bg-[#0284c7] text-white flex items-center justify-center text-2xl font-black shadow-md">
          2
        </div>
        <div>
          <h3 class="text-xl font-black text-slate-900">
            Armada Langsung Antar
          </h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">
            Scaffolding dimuat dari gudang Cipondoh dan langsung dikirim ke lokasi proyek Anda dalam 1-3 jam perjalanan.
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="bg-slate-50 p-6 sm:p-7 rounded-2xl border border-slate-200 text-center flex flex-col items-center gap-4 relative">
        <div class="w-16 h-16 rounded-full bg-amber-500 text-white flex items-center justify-center text-2xl font-black shadow-md">
          3
        </div>
        <div>
          <h3 class="text-xl font-black text-slate-900">
            Cek Barang &amp; Bayar (COD)
          </h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">
            Barang tiba di lokasi, mandor Anda memeriksa kelengkapan fisik unit, setelah sesuai baru lakukan pelunasan.
          </p>
        </div>
      </div>
    </div>

    <!-- CTA Box Bawah -->
    <div class="bg-gradient-to-r from-blue-900 to-slate-900 text-white p-6 sm:p-8 rounded-2xl text-center flex flex-col sm:flex-row items-center justify-between gap-4 mt-2">
      <div class="text-center sm:text-left">
        <h4 class="text-xl font-black">Mau Tanya atau Hitung Kebutuhan Proyek?</h4>
        <p class="text-sm text-slate-300 mt-0.5">Admin mandor logistik kami aktif dan siap bantu hitung gratis.</p>
      </div>
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#25D366] hover:bg-[#20bd5a] text-white font-black text-sm px-7 py-3.5 rounded-full shadow-lg transition-all active:scale-95 shrink-0 uppercase tracking-wider flex items-center gap-2"
      >
        <MessageSquare className="w-4 h-4 fill-current" />
        <span>KONSULTASI WHATSAPP SEKARANG</span>
      </a>
    </div>
  </div>
</section>