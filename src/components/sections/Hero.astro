---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
  deliveryEstimate?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya harga & sewa/beli scaffolding untuk proyek di ${city}. Mohon informasi stok dan biaya kirim.`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;
---

<!-- ==============================================
     HERO SECTION (HIGH-CONTRAST INDUSTRIAL BLUEPRINT)
=============================================== -->
<section class="relative min-h-[100svh] flex flex-col justify-center items-center overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-24">
  <!-- Background Image Poster -->
  <picture class="absolute inset-0 w-full h-full z-0">
    <source srcset="/assets/video/bg-hero-index-poster.webp" type="image/webp" />
    <img
      src="/assets/video/bg-hero-index-poster.jpg"
      alt={`Dokumentasi proyek pemasangan scaffolding pipa baja standar SNI oleh ${siteConfig.businessName} di ${city}`}
      class="w-full h-full object-cover scale-105"
      width="1280"
      height="720"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <!-- High-Contrast Dark Slate Overlay (75% - 85% untuk legibilitas maksimal) -->
  <div class="absolute inset-0 bg-gradient-to-b from-slate-950/85 via-slate-900/75 to-slate-950/90 z-10"></div>

  <!-- Hero Content (Posisi Presisi di Tengah Layar HP & Desktop) -->
  <div class="relative z-20 text-center text-white px-4 max-w-4xl mx-auto flex flex-col items-center">
    <!-- Badge Status Kepercayaan -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-400/30 text-amber-300 text-xs sm:text-sm font-montserrat font-bold uppercase tracking-wider mb-4 animate-fade-in">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Gudang Mandiri &bull; Pipa Tebal SNI 07-0065</span>
    </div>

    <!-- H1 Headline (Ukuran Responsif & Terbaca Jelas Tanpa Terpotong) -->
    <h1 class="text-2xl sm:text-4xl md:text-6xl font-montserrat font-extrabold mb-4 sm:mb-5 leading-tight sm:leading-tight tracking-tight text-white drop-shadow-md">
      Sewa &amp; Jual Scaffolding <br class="hidden sm:inline" />
      <span class="text-amber-400">Terpercaya di Indonesia</span>
    </h1>

    <!-- Subheadline -->
    <p class="text-sm sm:text-base md:text-xl text-slate-200 mb-6 sm:mb-8 leading-relaxed max-w-2xl mx-auto font-roboto drop-shadow">
      Pusat persewaan dan penjualan scaffolding pipa tebal untuk proyek rumah, ruko, gedung &amp; jembatan di {city}. Ready stok 10.000+ set, kirim 1-3 jam dengan armada sendiri.
    </p>

    <!-- Dua Tombol Utama Berkontras Tinggi -->
    <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 w-full sm:w-auto justify-center items-center">
      <!-- Tombol Utama: WhatsApp Hijau -->
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto bg-green-600 hover:bg-green-700 text-white px-7 py-3.5 sm:py-4 rounded-xl font-montserrat font-bold text-base sm:text-lg transition-all duration-300 transform hover:scale-105 shadow-xl btn-hover inline-flex items-center justify-center gap-2.5 active:scale-95"
        data-wa-source="hero_primary"
        data-wa-mode="SEWA & BELI"
        data-wa-city={city}
      >
        <i class="fab fa-whatsapp text-xl sm:text-2xl"></i>
        <span>Chat WhatsApp Admin</span>
      </a>

      <!-- Tombol Sekunder: Solid Putih (Kontras Tinggi di Atas Latar Gelap) -->
      <a
        href="#products"
        class="w-full sm:w-auto bg-white hover:bg-slate-100 text-slate-900 border border-slate-200 px-7 py-3.5 sm:py-4 rounded-xl font-montserrat font-bold text-base sm:text-lg transition-all duration-300 transform hover:scale-105 shadow-xl inline-flex items-center justify-center gap-2.5 active:scale-95"
        title="Lihat katalog produk scaffolding"
      >
        <i class="fas fa-book-open text-base sm:text-lg text-slate-700"></i>
        <span>Katalog Produk</span>
      </a>
    </div>

    <!-- Tautan Area Layanan (Pill Badges yang Jelas & Rapi) -->
    <div class="mt-6 sm:mt-8 flex flex-wrap items-center justify-center gap-2 text-xs sm:text-sm font-roboto">
      <span class="text-slate-300 font-medium mr-1">Layanan Siaga:</span>
      <a class="bg-slate-900/80 hover:bg-amber-400 hover:text-slate-950 text-slate-200 px-3 py-1 rounded-full border border-slate-700 transition-colors" href="/area/sewa-scaffolding-tangerang">Tangerang</a>
      <a class="bg-slate-900/80 hover:bg-amber-400 hover:text-slate-950 text-slate-200 px-3 py-1 rounded-full border border-slate-700 transition-colors" href="/area/sewa-scaffolding-dki-jakarta">DKI Jakarta</a>
      <a class="bg-slate-900/80 hover:bg-amber-400 hover:text-slate-950 text-slate-200 px-3 py-1 rounded-full border border-slate-700 transition-colors" href="/area/sewa-scaffolding-bsd-serpong">BSD &amp; Serpong</a>
      <a class="bg-slate-900/80 hover:bg-amber-400 hover:text-slate-950 text-slate-200 px-3 py-1 rounded-full border border-slate-700 transition-colors" href="/area/sewa-scaffolding-surabaya">Surabaya</a>
    </div>
  </div>

  <!-- Scroll Down Indicator (Tetap Terlihat Nyaman di Bawah) -->
  <a class="mt-8 text-slate-400 hover:text-white transition-colors cursor-pointer" href="#stats" aria-label="Scroll ke statistik">
    <div class="animate-bounce flex flex-col items-center gap-1">
      <span class="text-[10px] tracking-widest font-mono uppercase opacity-70">Scroll Down</span>
      <i class="fas fa-chevron-down text-base"></i>
    </div>
  </a>
</section>

<!-- ==============================================
     STATS SECTION: INDUSTRIAL NAVY & SAFETY GOLD (#stats)
     Kontras Tinggi, Elegan & Standar Keselamatan Kerja
=============================================== -->
<section class="py-8 sm:py-12 bg-slate-900 border-y-2 border-slate-800" id="stats">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-6 max-w-6xl mx-auto">
      <!-- Stat 1 -->
      <div class="bg-slate-800/70 p-4 sm:p-6 rounded-xl border border-slate-700/70 text-center shadow-sm">
        <p class="text-2xl sm:text-4xl md:text-5xl font-extrabold font-montserrat text-amber-400 tracking-tight">
          1.000+
        </p>
        <p class="text-[11px] sm:text-xs md:text-sm mt-1.5 text-slate-300 font-roboto uppercase tracking-wider font-semibold">
          Proyek Selesai
        </p>
      </div>

      <!-- Stat 2 -->
      <div class="bg-slate-800/70 p-4 sm:p-6 rounded-xl border border-slate-700/70 text-center shadow-sm">
        <p class="text-2xl sm:text-4xl md:text-5xl font-extrabold font-montserrat text-amber-400 tracking-tight">
          10.000+
        </p>
        <p class="text-[11px] sm:text-xs md:text-sm mt-1.5 text-slate-300 font-roboto uppercase tracking-wider font-semibold">
          Set Ready Stock
        </p>
      </div>

      <!-- Stat 3 -->
      <div class="bg-slate-800/70 p-4 sm:p-6 rounded-xl border border-slate-700/70 text-center shadow-sm">
        <p class="text-2xl sm:text-4xl md:text-5xl font-extrabold font-montserrat text-amber-400 tracking-tight">
          1 - 3 Jam
        </p>
        <p class="text-[11px] sm:text-xs md:text-sm mt-1.5 text-slate-300 font-roboto uppercase tracking-wider font-semibold">
          Kirim Cepat Armada
        </p>
      </div>

      <!-- Stat 4 -->
      <div class="bg-slate-800/70 p-4 sm:p-6 rounded-xl border border-slate-700/70 text-center shadow-sm">
        <p class="text-2xl sm:text-4xl md:text-5xl font-extrabold font-montserrat text-amber-400 tracking-tight">
          SNI 07-0065
        </p>
        <p class="text-[11px] sm:text-xs md:text-sm mt-1.5 text-slate-300 font-roboto uppercase tracking-wider font-semibold">
          Pipa Bersertifikat K3
        </p>
      </div>
    </div>
  </div>
</section>
