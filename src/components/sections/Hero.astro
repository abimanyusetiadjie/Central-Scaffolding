---
import { siteConfig } from '../../data/siteConfig';
import { Phone, MessageCircle } from 'lucide-react';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
  deliveryEstimate?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  coveredDistricts = [
    'Cipondoh',
    'Karawaci',
    'Ciledug',
    'BSD Serpong',
    'Cikupa',
    'Balaraja',
    'Jakarta Barat',
  ],
  deliveryEstimate = '1 - 3 Jam (Armada Sendiri)',
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya sewa/beli scaffolding untuk lokasi proyek di ${city}. Apakah siap kirim hari ini?`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;
---

<!-- HERO BANNER (GAYA PERSIS PT SNI - SCAFFOLDING NASIONAL INDONESIA) -->
<section class="relative min-h-[580px] lg:min-h-[640px] flex items-center justify-center overflow-hidden py-16 sm:py-24">
  <!-- Background Image with Dark Contrast Overlay (bg-black/65) -->
  <div
    class="absolute inset-0 w-full h-full bg-cover bg-center z-0 scale-105 transition-transform duration-1000"
    style={`background-image: url('${siteConfig.images.heroTruck}');`}
    aria-hidden="true"
  ></div>
  <div class="absolute inset-0 bg-black/65 z-10"></div>

  <!-- Hero Content (Montserrat + Roboto) -->
  <div class="relative z-20 text-center text-white px-4 max-w-5xl mx-auto flex flex-col items-center">
    <div class="inline-flex items-center gap-2 bg-orange-600/90 text-white px-4 py-1.5 rounded-full text-xs font-montserrat font-bold uppercase tracking-wider mb-5">
      ★ PUSAT SEWA &amp; JUAL SCAFFOLDING DI {city.toUpperCase()}
    </div>

    <h1 class="text-4xl sm:text-5xl md:text-6xl font-montserrat font-extrabold mb-6 leading-tight text-white drop-shadow-sm">
      Jasa Sewa &amp; Jual Scaffolding Terpercaya di {city}
    </h1>

    <p class="text-lg md:text-xl mb-8 opacity-90 max-w-3xl mx-auto font-roboto font-normal leading-relaxed text-gray-200">
      Solusi sewa scaffolding (steger perancah) untuk proyek rumah, ruko, gudang &amp; gedung bertingkat. Material pipa tebal bersertifikat SNI 07-0065, tim logistik berpengalaman, dan <strong class="text-orange-400">Bisa Bayar di Tempat (COD)</strong> setelah barang sampai di proyek Anda.
    </p>

    <!-- Area Pengiriman Cepat -->
    {coveredDistricts && coveredDistricts.length > 0 && (
      <div class="mb-8 inline-flex flex-wrap items-center justify-center gap-2 text-xs sm:text-sm text-gray-300 bg-black/40 px-4 py-2 rounded-lg border border-white/10 backdrop-blur-xs">
        <span class="font-bold text-orange-400">Wilayah Layanan Cepat:</span>
        <span>{coveredDistricts.slice(0, 6).join(' • ')} &amp; sekitarnya (Tiba dalam {deliveryEstimate})</span>
      </div>
    )}

    <!-- Tombol CTA Oranye Khas PT SNI -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center w-full sm:w-auto">
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-orange-600 hover:bg-orange-700 text-white px-8 py-4 rounded-lg font-montserrat font-bold text-lg transition-all duration-300 transform hover:scale-105 hover:shadow-lg flex items-center justify-center gap-2"
        data-wa-source="hero_cta"
        data-wa-mode="SEWA & BELI"
        data-wa-city={city}
      >
        <MessageCircle className="w-5 h-5 fill-current" />
        <span>WhatsApp</span>
      </a>

      <a
        href={`tel:${siteConfig.phone}`}
        class="bg-white/20 hover:bg-white/30 text-white border border-white/40 px-8 py-4 rounded-lg font-montserrat font-semibold text-lg backdrop-blur-sm transition-all duration-300 flex items-center justify-center gap-2"
      >
        <Phone className="w-5 h-5" />
        <span>Telepon: {siteConfig.phoneDisplay}</span>
      </a>
    </div>
  </div>
</section>

<!-- ==============================================
     STATS BAR ORANYE PERSIS SEPERTI DI PT SNI
=============================================== -->
<section id="stats" class="py-10 bg-orange-600">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center text-white">
      <div>
        <p class="text-4xl md:text-5xl font-extrabold font-montserrat">10.000+</p>
        <p class="text-sm md:text-base mt-1 opacity-90 font-roboto">Set Ready Stock</p>
      </div>
      <div>
        <p class="text-4xl md:text-5xl font-extrabold font-montserrat">1 - 3 Jam</p>
        <p class="text-sm md:text-base mt-1 opacity-90 font-roboto">Pengiriman Cepat Armada Sendiri</p>
      </div>
      <div>
        <p class="text-4xl md:text-5xl font-extrabold font-montserrat">COD</p>
        <p class="text-sm md:text-base mt-1 opacity-90 font-roboto">Bisa Bayar di Lokasi Proyek</p>
      </div>
      <div>
        <p class="text-4xl md:text-5xl font-extrabold font-montserrat">SNI</p>
        <p class="text-sm md:text-base mt-1 opacity-90 font-roboto">Pipa 1.8mm Bersertifikat</p>
      </div>
    </div>
  </div>
</section>