---
import { siteConfig } from '../../data/siteConfig';
import { Truck, MessageCircle, Phone, CheckCircle2, ShieldCheck, Calculator } from 'lucide-react';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
  deliveryEstimate?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  coveredDistricts = [
    'Cipondoh',
    'Karawaci',
    'Ciledug',
    'BSD Serpong',
    'Cikupa',
    'Balaraja',
    'Jakarta Barat',
  ],
  deliveryEstimate = '1 - 3 Jam (Armada Sendiri)',
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya sewa/beli scaffolding untuk lokasi proyek di ${city}. Apakah siap kirim hari ini?`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;
---

<!-- HERO SECTION: CLEAN INDUSTRIAL PROFESSIONAL BENCHMARK -->
<section
  id="beranda"
  aria-labelledby="hero-title"
  class="relative bg-gradient-to-b from-slate-50 via-white to-slate-50 py-12 md:py-18 border-b border-slate-200"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left Column: Copywriting & Actions -->
      <div class="lg:col-span-7 flex flex-col gap-5 text-left">
        <!-- Stock Status Badge -->
        <div class="inline-flex items-center gap-2 bg-blue-50 border border-blue-200 text-blue-900 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-bold w-fit shadow-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Ready Stock 10.000+ Set • Siap Kirim ke {city} Hari Ini</span>
        </div>

        <!-- Main Heading H1 (Professional, Human, No ALL-CAPS Yelling) -->
        <h1
          id="hero-title"
          class="text-3xl sm:text-4xl lg:text-[42px] font-extrabold text-slate-900 leading-[1.2] tracking-tight"
        >
          Sewa &amp; Jual Scaffolding di {city} — Kualitas Pipa SNI Langsung dari Gudang Pusat
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
          Pusat rental dan penjualan scaffolding baru serta rekondisi Grade A dengan pipa tebal {siteConfig.stats.pipeThickness} standar SNI. Armada pikap dan truk mandiri siap antar cepat ke wilayah {city} dan sekitarnya. <strong>Bisa bayar di lokasi proyek (COD)</strong> setelah barang dicek mandor.
        </p>

        <!-- Covered districts quick chips -->
        {coveredDistricts && coveredDistricts.length > 0 && (
          <div class="text-xs sm:text-sm text-slate-500 flex flex-wrap items-center gap-1.5 pt-1">
            <span class="font-bold text-slate-700">Area Pengiriman:</span>
            <span>{coveredDistricts.slice(0, 6).join(' • ')} &amp; sekitarnya</span>
          </div>
        )}

        <!-- Dual CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <a
            class="inline-flex items-center justify-center gap-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-base sm:text-lg px-6 py-4 rounded-xl shadow-md hover:shadow-lg transition-all active:scale-[0.98]"
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-wa-source="hero_cta"
            data-wa-mode="SEWA & BELI"
            data-wa-city={city}
          >
            <MessageCircle className="w-5 h-5 shrink-0" />
            <span>Konsultasi &amp; Pesan via WhatsApp</span>
          </a>

          <a
            class="inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-50 text-slate-800 font-bold text-base px-5 py-4 rounded-xl border border-slate-300 shadow-xs transition-all"
            href={`tel:${siteConfig.phone}`}
          >
            <Phone className="w-4 h-4 text-blue-900 shrink-0" />
            <span>Telepon: {siteConfig.phoneDisplay}</span>
          </a>
        </div>

        <!-- 3 Reassurance Value Props (Horizontal Clean Row) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-slate-200 text-slate-700">
          <div class="flex items-center gap-2.5">
            <CheckCircle2 className="w-5 h-5 text-emerald-600 shrink-0" />
            <div class="text-xs sm:text-sm font-semibold">
              <span class="block text-slate-900 font-bold">Bayar di Tempat (COD)</span>
              <span>Barang sampai baru lunas</span>
            </div>
          </div>

          <div class="flex items-center gap-2.5">
            <Calculator className="w-5 h-5 text-blue-900 shrink-0" />
            <div class="text-xs sm:text-sm font-semibold">
              <span class="block text-slate-900 font-bold">Bebas Biaya Survei</span>
              <span>Bantu hitung set gratis</span>
            </div>
          </div>

          <div class="flex items-center gap-2.5">
            <ShieldCheck className="w-5 h-5 text-amber-600 shrink-0" />
            <div class="text-xs sm:text-sm font-semibold">
              <span class="block text-slate-900 font-bold">Pipa SNI 1.8mm–2.0mm</span>
              <span>Garansi tukar unit cacat</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Warehouse & Delivery Fleet Visual Card -->
      <div class="lg:col-span-5">
        <div class="bg-white p-3 rounded-2xl border border-slate-200 shadow-lg relative">
          <div class="relative w-full aspect-[4/3] rounded-xl overflow-hidden bg-slate-100">
            <img
              alt={`Gudang Pusat ${siteConfig.businessName} dan Armada Pengiriman Scaffolding ke ${city}`}
              class="w-full h-full object-cover"
              src={siteConfig.images.heroTruck}
              width="800"
              height="600"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            <div class="absolute bottom-3 left-3 right-3 bg-slate-900/90 backdrop-blur-xs text-white p-3 rounded-lg flex items-center justify-between text-xs">
              <div class="flex items-center gap-2 font-semibold">
                <Truck className="w-4 h-4 text-emerald-400 shrink-0" />
                <span>Armada Milik Sendiri</span>
              </div>
              <span class="text-amber-300 font-bold">Estimasi: {deliveryEstimate}</span>
            </div>
          </div>

          <div class="p-3 text-xs text-slate-600 flex items-center justify-between">
            <span class="font-medium">Lokasi Gudang: Cipondoh, Kota Tangerang</span>
            <span class="text-emerald-700 font-bold">✓ Buka Setiap Hari</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>