---
import { siteConfig } from '../../data/siteConfig';
import { Truck, MessageCircle, CheckCircle2, ShieldCheck, FileText, MapPin, Clock } from 'lucide-react';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
  deliveryEstimate?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  coveredDistricts = [
    'Cipondoh',
    'Karawaci',
    'Ciledug',
    'BSD Serpong',
    'Cikupa',
    'Balaraja',
    'Jakarta Barat',
  ],
  deliveryEstimate = '2 Jam (Jabodetabek & Banten)',
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya sewa/beli scaffolding untuk lokasi proyek di ${city}. Apakah siap kirim hari ini?`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;
---

<!-- TOP ALERT BANNER (High-Vis Daylight Contrast) -->
<section class="w-full bg-[#FACC15] text-slate-900 py-2.5 px-4 text-center font-bold text-sm sm:text-base border-b-2 border-yellow-600">
  <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-2 sm:gap-4">
    <div class="flex items-center gap-2">
      <Truck className="w-5 h-5 text-[#00236f] shrink-0" />
      <span class="tracking-tight uppercase">
        {coveredDistricts && coveredDistricts.length > 0
          ? `GUDANG BUKA HARI INI • SIAP ANTAR KE ${city.toUpperCase()} (${coveredDistricts.slice(0, 3).join(', ')}, DLL)`
          : `GUDANG BUKA HARI INI • ARMADA SIAP ANGKUT SE-JABODETABEK & BANTEN`}
      </span>
    </div>
    <span class="inline-flex items-center bg-[#00236f] text-white px-2.5 py-0.5 rounded text-xs uppercase font-extrabold">
      RESPON CEPAT 1 MENIT
    </span>
  </div>
</section>

<!-- HERO SECTION -->
<section
  id="beranda"
  aria-labelledby="hero-title"
  class="w-full bg-[#00236f] text-white py-12 md:py-16 border-b-4 border-blue-950 scroll-mt-20"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-6 sm:gap-8">
    <!-- Yellow Status Badge & Delivery Time -->
    <div class="flex flex-wrap items-center gap-2 sm:gap-3">
      <div class="inline-flex items-center gap-2 bg-[#FACC15] text-slate-900 px-3.5 sm:px-4 py-2 rounded-lg shadow-md border-2 border-yellow-600">
        <CheckCircle2 className="w-5 h-5 text-[#00236f] shrink-0" />
        <span class="text-xs sm:text-sm uppercase font-extrabold tracking-wide">
          READY STOCK 10.000+ SET • SIAP ANTAR HARI INI
        </span>
      </div>

      <div class="inline-flex items-center gap-1.5 bg-[#1e3a8a] text-green-300 px-3 sm:px-3.5 py-2 rounded-lg border-2 border-blue-400 text-xs sm:text-sm font-bold uppercase">
        <Clock className="w-4 h-4 shrink-0" />
        <span>ESTIMASI: {deliveryEstimate}</span>
      </div>
    </div>

    <!-- Main Headline H1 & Subtitle -->
    <div class="flex flex-col gap-3 max-w-5xl">
      <h1
        id="hero-title"
        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight uppercase text-white"
      >
        SEWA &amp; JUAL SCAFFOLDING {city.toUpperCase()} — SIAP KIRIM KE PROYEK ANDA
      </h1>
      <p class="text-base sm:text-lg font-medium leading-relaxed text-blue-100 max-w-3xl">
        Pipa baja tebal standar SNI ({siteConfig.stats.pipeThickness}), kuat &amp; aman. Melayani sewa harian, mingguan, bulanan, dan jual baru / rekondisi Grade A siap pakai untuk wilayah {city} &amp; sekitarnya.
      </p>
    </div>

    <!-- Covered Districts Info Bar -->
    {coveredDistricts && coveredDistricts.length > 0 && (
      <div class="bg-[#1e3a8a] p-3.5 sm:p-4 rounded-xl border-2 border-blue-400 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1 text-xs sm:text-sm text-[#FACC15] uppercase font-bold shrink-0">
          <MapPin className="w-4 h-4" />
          KECAMATAN DILAYANI ({city.toUpperCase()}):
        </span>
        <span class="text-xs sm:text-sm text-slate-100 font-medium">
          {coveredDistricts.join(' • ')}
        </span>
      </div>
    )}

    <!-- Warehouse Delivery Photo with Hard Framing -->
    <div class="w-full bg-white p-2.5 sm:p-3.5 rounded-2xl border-4 border-blue-300 shadow-2xl">
      <div class="relative w-full h-[260px] sm:h-[400px] lg:h-[480px] overflow-hidden rounded-xl bg-slate-100">
        <img
          alt={`Gudang ${siteConfig.businessName} dan Armada Truk Scaffolding Siap Antar ke ${city}`}
          class="w-full h-full object-cover"
          src={siteConfig.images.heroTruck}
          width="1200"
          height="600"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <div class="absolute bottom-0 inset-x-0 bg-[#00236f]/95 text-white p-3.5 sm:p-5 flex flex-wrap items-center justify-between gap-2 sm:gap-3 border-t-2 border-[#1e3a8a]">
          <div class="flex items-center gap-2">
            <Truck className="w-6 h-6 text-green-400 shrink-0" />
            <span class="text-sm sm:text-base md:text-lg uppercase text-green-300 font-bold">
              ARMADA PICKUP &amp; ENGKEL SIAP ANGKUT
            </span>
          </div>
          <p class="text-xs sm:text-sm md:text-base text-white font-bold">
            Tiba di lokasi proyek Anda dalam {deliveryEstimate} ({coveredDistricts.slice(0, 4).join(', ')}, dsb.)
          </p>
        </div>
      </div>
    </div>

    <!-- Gigantic WhatsApp Call-to-Action Button -->
    <div class="w-full flex flex-col gap-2">
      <a
        class="w-full min-h-[64px] bg-[#16A34A] hover:bg-[#15803D] text-white font-extrabold text-lg sm:text-2xl rounded-xl border-4 border-[#002109] shadow-[0_6px_0_#002109] flex items-center justify-center gap-3 px-6 py-4 transition-all active:translate-y-1 active:shadow-[0_2px_0_#002109] text-center cursor-pointer"
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-source="hero_cta"
        data-wa-mode="SEWA & BELI"
        data-wa-city={city}
      >
        <MessageCircle className="w-8 h-8 sm:w-9 sm:h-9 shrink-0 animate-pulse" />
        <span class="uppercase tracking-tight">
          PENCET DI SINI UNTUK CHAT WHATSAPP (RESPON CEPAT 1 MENIT)
        </span>
      </a>
      <div class="text-center text-xs sm:text-sm text-blue-200 uppercase mt-1 font-semibold">
        Layanan Konsultasi Langsung dengan Mandor Logistik Gudang • Hubungi: {siteConfig.phoneDisplay}
      </div>
    </div>

    <!-- 3 Core Reassurance Badges -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
      <div class="bg-[#1e3a8a] p-4 sm:p-5 rounded-xl border-2 border-blue-400 flex items-center gap-3.5">
        <FileText className="w-9 h-9 text-[#FACC15] shrink-0" />
        <div>
          <div class="text-base sm:text-lg uppercase text-white font-bold">BEBAS BIAYA SURVEI</div>
          <div class="text-xs sm:text-sm text-blue-100 font-medium">Bantu hitung kebutuhan set akurat gratis</div>
        </div>
      </div>

      <div class="bg-[#1e3a8a] p-4 sm:p-5 rounded-xl border-2 border-blue-400 flex items-center gap-3.5">
        <CheckCircle2 className="w-9 h-9 text-green-400 shrink-0" />
        <div>
          <div class="text-base sm:text-lg uppercase text-white font-bold">BAYAR DI TEMPAT (COD)</div>
          <div class="text-xs sm:text-sm text-blue-100 font-medium">Barang sampai dicek mandor, baru pelunasan</div>
        </div>
      </div>

      <div class="bg-[#1e3a8a] p-4 sm:p-5 rounded-xl border-2 border-blue-400 flex items-center gap-3.5">
        <ShieldCheck className="w-9 h-9 text-[#FACC15] shrink-0" />
        <div>
          <div class="text-base sm:text-lg uppercase text-white font-bold">SURAT JALAN &amp; FAKTUR RESMI</div>
          <div class="text-xs sm:text-sm text-blue-100 font-medium">Legalitas aman standar K3 Kemnaker &amp; SNI</div>
        </div>
      </div>
    </div>
  </div>
</section>
