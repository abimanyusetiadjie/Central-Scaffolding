---
import { siteConfig } from '../../data/siteConfig';
import { MessageCircle, FileText, ChevronDown } from 'lucide-react';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
  deliveryEstimate?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  coveredDistricts = [
    'Cipondoh',
    'Karawaci',
    'Ciledug',
    'BSD Serpong',
    'Cikupa',
    'Balaraja',
    'Jakarta Barat',
  ],
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya sewa/beli scaffolding untuk lokasi proyek di ${city}. Apakah siap kirim hari ini?`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;
---

<!-- HERO BANNER (SAMA PERSIS DENGAN PT SNI) -->
<section class="relative h-screen min-h-[640px] flex items-center justify-center overflow-hidden">
  <!-- Background Image with Overlay -->
  <div
    class="absolute top-0 left-0 w-full h-full bg-cover bg-center z-0 scale-105"
    style={`background-image: url('${siteConfig.images.heroTruck}');`}
    aria-hidden="true"
  ></div>

  <!-- Overlay (bg-black/60) -->
  <div class="absolute inset-0 bg-black/60 z-10"></div>

  <!-- Hero Content -->
  <div class="relative z-20 text-center text-white px-4 max-w-4xl mx-auto pt-20">
    <h1 class="text-4xl sm:text-5xl md:text-7xl font-montserrat font-bold mb-6 leading-tight">
      Jasa Sewa Scaffolding Terpercaya di {city}
    </h1>
    <p class="text-lg md:text-2xl mb-8 opacity-90 font-roboto max-w-3xl mx-auto">
      Solusi jasa sewa scaffolding (perancah) &amp; bekisting untuk proyek rumah, ruko, gudang &amp; gedung bertingkat. Material bersertifikat SNI 07-0065, tim berpengalaman, tersedia stok 10.000+ set siap kirim ke {city}.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-orange-600 hover:bg-orange-700 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all duration-300 transform hover:scale-105 hover:shadow-lg flex items-center justify-center gap-2 font-montserrat"
        data-wa-source="hero_cta"
        data-wa-mode="SEWA & BELI"
        data-wa-city={city}
      >
        <MessageCircle className="w-5 h-5 fill-current" />
        <span>WhatsApp</span>
      </a>

      <a
        href="#products"
        class="bg-transparent border-2 border-white text-white hover:bg-white hover:text-orange-600 px-8 py-4 rounded-lg font-semibold text-lg transition-all duration-300 transform hover:scale-105 flex items-center justify-center gap-2 font-montserrat"
      >
        <FileText className="w-5 h-5" />
        <span>Katalog Produk</span>
      </a>
    </div>

    <!-- Area List Under Hero (Khas PT SNI) -->
    {coveredDistricts && coveredDistricts.length > 0 && (
      <p class="mt-6 text-sm md:text-base opacity-90 font-roboto">
        Lihat layanan lokal:
        {coveredDistricts.slice(0, 4).map((district, idx) => (
          <span>
            <a href="#layanan-lokal" class="underline hover:text-orange-300">{district}</a>
            {idx < 3 && <span> &bull; </span>}
          </span>
        ))}
      </p>
    )}
  </div>

  <!-- Scroll Indicator (Khas PT SNI) -->
  <a href="#stats" class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 cursor-pointer" aria-label="Scroll ke statistik">
    <div class="animate-bounce">
      <ChevronDown className="w-8 h-8 text-white" />
    </div>
  </a>
</section>

<!-- ==============================================
     STATS BAR ORANYE PERSIS SEPERTI DI PT SNI
=============================================== -->
<section id="stats" class="py-10 bg-orange-600">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center text-white">
      <div>
        <p class="text-4xl md:text-5xl font-bold font-montserrat">1000+</p>
        <p class="text-sm md:text-base mt-1 opacity-90 font-roboto">Proyek Selesai</p>
      </div>
      <div>
        <p class="text-4xl md:text-5xl font-bold font-montserrat">10.000+</p>
        <p class="text-sm md:text-base mt-1 opacity-90 font-roboto">Set Ready Stock</p>
      </div>
      <div>
        <p class="text-4xl md:text-5xl font-bold font-montserrat">1 - 3 Jam</p>
        <p class="text-sm md:text-base mt-1 opacity-90 font-roboto">Pengiriman Armada Sendiri</p>
      </div>
      <div>
        <p class="text-4xl md:text-5xl font-bold font-montserrat">SNI</p>
        <p class="text-sm md:text-base mt-1 opacity-90 font-roboto">Material Bersertifikat</p>
      </div>
    </div>
  </div>
</section>