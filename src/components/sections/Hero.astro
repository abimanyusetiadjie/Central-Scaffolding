---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
  deliveryEstimate?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya harga & sewa/beli scaffolding untuk proyek di ${city}. Mohon informasi stok dan biaya kirim.`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;
---

<!-- HERO SECTION (TEMA MERAH CENTRAL SCAFFOLDING) -->
<section class="relative h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Video Berjalan / Poster Fallback (Zero-JS Native Looping) -->
  <div class="absolute inset-0 w-full h-full z-0 overflow-hidden">
    <video
      autoplay
      muted
      loop
      playsinline
      poster="/assets/video/bg-hero-index-poster.webp"
      class="w-full h-full object-cover"
    >
      <source src="/assets/video/bg-hero.mp4" type="video/mp4" />
      <source src="/assets/video/bg-hero.webm" type="video/webm" />
      <!-- Fallback Gambar Statis jika browser tidak memutar video -->
      <picture class="w-full h-full">
        <source srcset="/assets/video/bg-hero-index-poster.webp" type="image/webp" />
        <img
          src="/assets/video/bg-hero-index-poster.jpg"
          alt={`Dokumentasi proyek pemasangan scaffolding pipa baja standar SNI oleh ${siteConfig.businessName} di ${city}`}
          class="w-full h-full object-cover"
          width="1280"
          height="720"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </video>
  </div>

  <!-- Overlay Hitam 60% -->
  <div class="absolute inset-0 bg-black/60 z-10"></div>

  <!-- Hero Content (Ringkas, Padat, Langsung Inti Produk & Pesan WA) -->
  <div class="relative z-20 text-center text-white px-4 max-w-4xl mx-auto pt-16">
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-montserrat font-bold mb-4 sm:mb-5 leading-tight animate-fade-in tracking-tight">
      Sewa &amp; Jual Scaffolding Standar SNI
    </h1>
    <p class="text-base sm:text-lg md:text-xl mb-7 opacity-90 leading-relaxed font-roboto max-w-2xl mx-auto">
      Pusat perancah pipa tebal SNI di {city}. Ready stok 10.000+ set, siap kirim 1-3 jam langsung ke proyek.
    </p>

    <!-- Dua Tombol Utama -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <!-- Tombol WhatsApp Hijau -->
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto bg-green-600 hover:bg-green-700 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all duration-300 transform hover:scale-105 hover:shadow-lg btn-hover inline-flex items-center justify-center gap-2"
        data-wa-source="hero_primary"
        data-wa-mode="SEWA & BELI"
        data-wa-city={city}
      >
        <i class="fab fa-whatsapp text-2xl"></i>
        <span>Chat WhatsApp</span>
      </a>

      <!-- Tombol Katalog Transparan Aksen Merah -->
      <a
        href="#products"
        class="w-full sm:w-auto bg-transparent border-2 border-white text-white hover:bg-white hover:text-red-600 px-8 py-4 rounded-lg font-semibold text-lg transition-all duration-300 transform hover:scale-105 inline-flex items-center justify-center gap-2"
        title="Lihat katalog produk scaffolding"
      >
        <i class="fas fa-book-open text-xl"></i>
        <span>Katalog Produk</span>
      </a>
    </div>

    <!-- Tautan Area Layanan Lokal -->
    <p class="mt-6 text-sm md:text-base opacity-90 font-roboto">
      Lihat layanan lokal:
      <a class="underline hover:text-red-300 transition-colors" href="/area/sewa-scaffolding-tangerang">Tangerang</a>
      •
      <a class="underline hover:text-red-300 transition-colors" href="/area/sewa-scaffolding-dki-jakarta">DKI Jakarta</a>
      •
      <a class="underline hover:text-red-300 transition-colors" href="/area/sewa-scaffolding-bsd-serpong">BSD &amp; Serpong</a>
      •
      <a class="underline hover:text-red-300 transition-colors" href="/area/sewa-scaffolding-surabaya">Surabaya</a>
    </p>
  </div>

  <!-- Scroll Down Indicator Bouncing Arrow -->
  <a class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 cursor-pointer" href="#stats" aria-label="Scroll ke statistik">
    <div class="animate-bounce">
      <i class="fas fa-chevron-down text-white text-2xl"></i>
    </div>
  </a>
</section>

<!-- STATS SECTION (CLEAN CRISP WHITE / STEEL SLATE — SEJUK & ELEGAN) (#stats) -->
<section class="py-10 sm:py-12 bg-slate-100 border-y border-slate-200" id="stats">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 sm:gap-6 text-center max-w-6xl mx-auto">
      <!-- Stat 1 -->
      <div class="bg-white p-4 sm:p-5 rounded-2xl border-2 border-slate-200/90 shadow-sm hover:shadow-lg hover:border-red-500 transition-all duration-300 transform hover:-translate-y-1.5 cursor-default group">
        <p class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-montserrat tracking-tight leading-none mb-1.5 text-red-600">
          1.000+
        </p>
        <p class="text-xs sm:text-sm text-slate-600 font-roboto font-semibold">
          Proyek Selesai
        </p>
      </div>

      <!-- Stat 2 -->
      <div class="bg-white p-4 sm:p-5 rounded-2xl border-2 border-slate-200/90 shadow-sm hover:shadow-lg hover:border-red-500 transition-all duration-300 transform hover:-translate-y-1.5 cursor-default group">
        <p class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-montserrat tracking-tight leading-none mb-1.5 text-red-600">
          10.000+
        </p>
        <p class="text-xs sm:text-sm text-slate-600 font-roboto font-semibold">
          Set Ready Stock
        </p>
      </div>

      <!-- Stat 3 -->
      <div class="bg-white p-4 sm:p-5 rounded-2xl border-2 border-slate-200/90 shadow-sm hover:shadow-lg hover:border-red-500 transition-all duration-300 transform hover:-translate-y-1.5 cursor-default group">
        <p class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-montserrat tracking-tight leading-none mb-1.5 text-red-600">
          1 - 3 Jam
        </p>
        <p class="text-xs sm:text-sm text-slate-600 font-roboto font-semibold">
          Pengiriman Cepat
        </p>
      </div>

      <!-- Stat 4 -->
      <div class="bg-white p-4 sm:p-5 rounded-2xl border-2 border-slate-200/90 shadow-sm hover:shadow-lg hover:border-red-500 transition-all duration-300 transform hover:-translate-y-1.5 cursor-default group">
        <p class="text-3xl sm:text-4xl md:text-5xl font-extrabold font-montserrat tracking-tight leading-none mb-1.5 text-red-600">
          SNI
        </p>
        <p class="text-xs sm:text-sm text-slate-600 font-roboto font-semibold">
          Pipa Tebal 1.8 - 2.0mm
        </p>
      </div>
    </div>
  </div>
</section>
