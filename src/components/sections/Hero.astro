---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
  deliveryEstimate?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const isDefaultHome = city.includes('Jabodetabek');
const heroSubtitle = isDefaultHome
  ? 'Ready stok 10.000+ set pipa tebal 1.8–2.0 mm. Fokus kirim cepat Tangerang & Jabodetabek (1–3 jam) serta cabang Surabaya.'
  : `Ready stok 10.000+ set pipa tebal 1.8–2.0 mm untuk proyek di ${city}. Siap kirim cepat langsung dari gudang & depo resmi.`;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya harga & sewa/beli scaffolding untuk proyek di ${city}. Mohon informasi stok dan biaya kirim.`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;
---

<!-- HERO SECTION (TEMA MERAH CENTRAL SCAFFOLDING) -->
<section class="relative min-h-[540px] sm:h-screen flex items-center justify-center overflow-hidden py-20 sm:py-0">
  <!-- Background Video Berjalan / Poster Fallback (Zero-JS Native Looping) -->
  <div class="absolute inset-0 w-full h-full z-0 overflow-hidden">
    <video
      autoplay
      muted
      loop
      playsinline
      poster="/assets/video/bg-hero-index-poster.webp"
      class="w-full h-full object-cover"
    >
      <source src="/assets/video/bg-hero.mp4" type="video/mp4" />
      <source src="/assets/video/bg-hero.webm" type="video/webm" />
      <!-- Fallback Gambar Statis jika browser tidak memutar video -->
      <picture class="w-full h-full">
        <source srcset="/assets/video/bg-hero-index-poster.webp" type="image/webp" />
        <img
          src="/assets/video/bg-hero-index-poster.jpg"
          alt={`Dokumentasi proyek pemasangan scaffolding pipa baja standar SNI oleh ${siteConfig.businessName} di ${city}`}
          class="w-full h-full object-cover"
          width="1280"
          height="720"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </video>
  </div>

  <!-- Overlay Hitam 65% -->
  <div class="absolute inset-0 bg-black/65 z-10"></div>

  <!-- Hero Content (Ringkas, Padat, Langsung Inti Produk & Pesan WA) -->
  <div class="relative z-20 text-center text-white px-4 max-w-4xl mx-auto pt-8 sm:pt-16">
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-montserrat font-bold mb-3 sm:mb-5 leading-tight animate-fade-in tracking-tight drop-shadow-md">
      Sewa &amp; Jual Scaffolding Standar SNI
    </h1>
    <p class="text-sm sm:text-lg md:text-xl mb-8 sm:mb-10 opacity-95 leading-relaxed font-roboto max-w-2xl mx-auto drop-shadow">
      {heroSubtitle}
    </p>

    <!-- Dua Tombol Utama (Kompak Sejajar dengan Jarak Lega) -->
    <div class="flex flex-row gap-2.5 sm:gap-4 justify-center items-center max-w-sm sm:max-w-none mx-auto mb-6 sm:mb-8">
      <!-- Tombol WhatsApp Hijau -->
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 sm:flex-initial w-auto bg-green-600 hover:bg-green-700 text-white px-4 py-2.5 sm:px-7 sm:py-3.5 rounded-lg sm:rounded-xl font-bold text-xs sm:text-base transition-all duration-300 transform hover:scale-105 hover:shadow-lg inline-flex items-center justify-center gap-1.5 sm:gap-2 shadow-md whitespace-nowrap"
        data-wa-source="hero_primary"
        data-wa-mode="SEWA & BELI"
        data-wa-city={city}
      >
        <i class="fab fa-whatsapp text-base sm:text-xl"></i>
        <span>Chat WhatsApp</span>
      </a>

      <!-- Tombol Katalog Transparan Aksen Putih -->
      <a
        href="#products"
        class="flex-1 sm:flex-initial w-auto bg-black/30 backdrop-blur-xs border border-white sm:border-2 text-white hover:bg-white hover:text-red-600 px-4 py-2.5 sm:px-7 sm:py-3.5 rounded-lg sm:rounded-xl font-bold text-xs sm:text-base transition-all duration-300 transform hover:scale-105 inline-flex items-center justify-center gap-1.5 sm:gap-2 shadow-md whitespace-nowrap"
        title="Lihat katalog produk scaffolding"
      >
        <i class="fas fa-book-open text-xs sm:text-base"></i>
        <span>Katalog Produk</span>
      </a>
    </div>

    <!-- Tautan Area Layanan Lokal (Center 2 Baris: Label di Atas, Kota di Bawah) -->
    <div class="text-xs sm:text-sm md:text-base text-white/95 font-roboto drop-shadow">
      <span class="block text-center text-white/80 text-[11px] sm:text-xs uppercase tracking-wider font-montserrat font-bold mb-1 sm:mb-1.5">
        Area Utama:
      </span>
      <div class="flex flex-wrap justify-center items-center gap-x-2 gap-y-1">
        <a class="underline underline-offset-4 font-medium hover:text-red-300 transition-colors" href="/area/sewa-scaffolding-tangerang">Tangerang</a>
        <span class="opacity-60">•</span>
        <a class="underline underline-offset-4 font-medium hover:text-red-300 transition-colors" href="/area/sewa-scaffolding-dki-jakarta">DKI Jakarta</a>
        <span class="opacity-60">•</span>
        <a class="underline underline-offset-4 font-medium hover:text-red-300 transition-colors" href="/area/sewa-scaffolding-bsd-serpong">BSD &amp; Serpong</a>
        <span class="opacity-60">•</span>
        <a class="underline underline-offset-4 font-medium hover:text-red-300 transition-colors" href="/area/sewa-scaffolding-surabaya">Cabang Surabaya</a>
      </div>
    </div>
  </div>

  <!-- Scroll Down Indicator Bouncing Arrow -->
  <a class="hidden sm:block absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 cursor-pointer" href="#stats" aria-label="Scroll ke statistik">
    <div class="animate-bounce">
      <i class="fas fa-chevron-down text-white text-2xl"></i>
    </div>
  </a>
</section>

<!-- STATS SECTION (4 ANGKA SINGKAT & PADAT) (#stats) -->
<section class="py-6 sm:py-10 bg-slate-100 border-y border-slate-200" id="stats">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 sm:gap-5 text-center max-w-6xl mx-auto">
      <!-- Stat 1 -->
      <div class="bg-white p-3 sm:p-5 rounded-xl border border-slate-200/90 shadow-xs hover:border-red-500 transition-all">
        <p class="text-2xl sm:text-4xl font-extrabold font-montserrat tracking-tight leading-none mb-1 text-red-600">
          1.000+
        </p>
        <p class="text-[11px] sm:text-sm text-slate-600 font-roboto font-semibold">
          Proyek Selesai
        </p>
      </div>

      <!-- Stat 2 -->
      <div class="bg-white p-3 sm:p-5 rounded-xl border border-slate-200/90 shadow-xs hover:border-red-500 transition-all">
        <p class="text-2xl sm:text-4xl font-extrabold font-montserrat tracking-tight leading-none mb-1 text-red-600">
          10.000+
        </p>
        <p class="text-[11px] sm:text-sm text-slate-600 font-roboto font-semibold">
          Set Ready Stock
        </p>
      </div>

      <!-- Stat 3 -->
      <div class="bg-white p-3 sm:p-5 rounded-xl border border-slate-200/90 shadow-xs hover:border-red-500 transition-all">
        <p class="text-2xl sm:text-4xl font-extrabold font-montserrat tracking-tight leading-none mb-1 text-red-600">
          1 - 3 Jam
        </p>
        <p class="text-[11px] sm:text-sm text-slate-600 font-roboto font-semibold">
          Kirim Jabodetabek
        </p>
      </div>

      <!-- Stat 4 -->
      <div class="bg-white p-3 sm:p-5 rounded-xl border border-slate-200/90 shadow-xs hover:border-red-500 transition-all">
        <p class="text-2xl sm:text-4xl font-extrabold font-montserrat tracking-tight leading-none mb-1 text-red-600">
          SNI
        </p>
        <p class="text-[11px] sm:text-sm text-slate-600 font-roboto font-semibold">
          Pipa Tebal 1.8 - 2.0mm
        </p>
      </div>
    </div>
  </div>
</section>
