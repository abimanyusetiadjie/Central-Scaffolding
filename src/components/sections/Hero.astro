---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
  deliveryEstimate?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya harga & sewa/beli scaffolding untuk proyek di ${city}. Mohon informasi stok dan biaya kirim.`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;
---

<!-- HERO SECTION (SAMA PERSIS DENGAN PT SNI) -->
<section class="relative h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Image / Video Poster -->
  <img
    src="/assets/video/bg-hero-index-poster.webp"
    alt="Scaffolding Background Construction"
    class="absolute top-0 left-0 w-full h-full object-cover z-0"
    loading="eager"
  />

  <!-- Overlay Hitam 60% Khas PT SNI -->
  <div class="absolute inset-0 bg-black/60 z-10"></div>

  <!-- Hero Content -->
  <div class="relative z-20 text-center text-white px-4 max-w-4xl mx-auto pt-16">
    <h1 class="text-4xl sm:text-5xl md:text-7xl font-montserrat font-bold mb-6 leading-tight animate-fade-in tracking-tight">
      Jasa Sewa Scaffolding Terpercaya di Indonesia
    </h1>
    <p class="text-lg sm:text-xl md:text-2xl mb-8 opacity-90 leading-relaxed font-roboto">
      Solusi jasa sewa &amp; jual scaffolding (perancah) untuk proyek rumah, ruko, gudang &amp; gedung bertingkat di {city}. Material bersertifikat SNI, stok {siteConfig.stats.readyStockSets}, siap kirim {siteConfig.stats.deliverySla}.
    </p>

    <!-- Dua Tombol Utama Khas PT SNI -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <!-- Tombol WhatsApp Oranye -->
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto bg-orange-600 hover:bg-orange-700 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all duration-300 transform hover:scale-105 hover:shadow-lg btn-hover inline-flex items-center justify-center gap-2"
        data-wa-source="hero_primary"
        data-wa-mode="SEWA & BELI"
        data-wa-city={city}
      >
        <i class="fab fa-whatsapp text-2xl"></i>
        <span>WhatsApp</span>
      </a>

      <!-- Tombol Katalog Transparan -->
      <a
        href="#products"
        class="w-full sm:w-auto bg-transparent border-2 border-white text-white hover:bg-white hover:text-orange-600 px-8 py-4 rounded-lg font-semibold text-lg transition-all duration-300 transform hover:scale-105 inline-flex items-center justify-center gap-2"
        title="Lihat katalog produk scaffolding"
      >
        <i class="fas fa-book-open text-xl"></i>
        <span>Katalog</span>
      </a>
    </div>

    <!-- Tautan Area Layanan Lokal -->
    <p class="mt-6 text-sm md:text-base opacity-90 font-roboto">
      Lihat layanan lokal:
      <a class="underline hover:text-orange-300 transition-colors" href="/area/tangerang">Tangerang</a>
      •
      <a class="underline hover:text-orange-300 transition-colors" href="/area/jakarta-barat">Jakarta Barat</a>
      •
      <a class="underline hover:text-orange-300 transition-colors" href="/area/jakarta-selatan">Jakarta Selatan</a>
      •
      <a class="underline hover:text-orange-300 transition-colors" href="/area/bsd-serpong">BSD Serpong</a>
    </p>
  </div>

  <!-- Scroll Down Indicator Bouncing Arrow -->
  <a class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 cursor-pointer" href="#stats" aria-label="Scroll ke statistik">
    <div class="animate-bounce">
      <i class="fas fa-chevron-down text-white text-2xl"></i>
    </div>
  </a>
</section>

<!-- STATS SECTION ORANYE KHAS PT SNI (#stats) -->
<section class="py-10 bg-orange-600" id="stats">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center text-white">
      <div>
        <p class="text-4xl md:text-5xl font-bold font-montserrat">
          {siteConfig.stats.projectsCompleted}
        </p>
        <p class="text-sm md:text-base mt-1 opacity-90 font-roboto">
          Proyek Selesai
        </p>
      </div>
      <div>
        <p class="text-4xl md:text-5xl font-bold font-montserrat">
          {siteConfig.stats.readyStockSets}
        </p>
        <p class="text-sm md:text-base mt-1 opacity-90 font-roboto">
          Set Ready Stock
        </p>
      </div>
      <div>
        <p class="text-4xl md:text-5xl font-bold font-montserrat">
          {siteConfig.stats.deliverySla}
        </p>
        <p class="text-sm md:text-base mt-1 opacity-90 font-roboto">
          Pengiriman Cepat
        </p>
      </div>
      <div>
        <p class="text-4xl md:text-5xl font-bold font-montserrat">
          SNI
        </p>
        <p class="text-sm md:text-base mt-1 opacity-90 font-roboto">
          Material Bersertifikat
        </p>
      </div>
    </div>
  </div>
</section>
