---
import { siteConfig } from '../../data/siteConfig';
import { Truck, MessageCircle, Phone, CheckCircle2, ShieldCheck, Calculator } from 'lucide-react';

export interface Props {
  city?: string;
  coveredDistricts?: string[];
  deliveryEstimate?: string;
  whatsappNumber?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  coveredDistricts = [
    'Cipondoh',
    'Karawaci',
    'Ciledug',
    'BSD Serpong',
    'Cikupa',
    'Balaraja',
    'Jakarta Barat',
  ],
  deliveryEstimate = '1 - 3 Jam (Armada Sendiri)',
  whatsappNumber = siteConfig.whatsappNumber,
} = Astro.props;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya mau tanya sewa/beli scaffolding untuk lokasi proyek di ${city}. Apakah siap kirim hari ini?`
);
const waUrl = `https://wa.me/${whatsappNumber}?text=${waMessage}`;
---

<!-- HERO BANNER KHAS ELEMENTOR PRO INDONESIA -->
<section
  id="beranda"
  aria-labelledby="hero-title"
  class="relative bg-[#0d2344] text-white py-16 sm:py-20 lg:py-24 overflow-hidden"
  style={`background-image: linear-gradient(to bottom, rgba(13, 35, 68, 0.90), rgba(13, 35, 68, 0.95)), url('${siteConfig.images.heroTruck}'); background-size: cover; background-position: center;`}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center gap-6">
    <!-- Amber Gold Elementor Top Pill -->
    <div class="inline-flex items-center gap-2 bg-amber-400/20 border border-amber-400/40 text-amber-300 px-4 py-1.5 rounded-full text-xs sm:text-sm font-bold uppercase tracking-wider backdrop-blur-xs">
      <span>⭐ PUSAT SEWA &amp; JUAL SCAFFOLDING TERPERCAYA DI {city.toUpperCase()}</span>
    </div>

    <!-- Main Title Khas Landing Page WordPress (Besar, Jelas, Percaya Diri) -->
    <h1
      id="hero-title"
      class="text-3xl sm:text-5xl lg:text-5xl font-black text-white leading-tight tracking-tight max-w-4xl"
    >
      Sewa &amp; Jual Scaffolding Murah, Berkualitas &amp; Siap Kirim Hari Ini ke Proyek Anda
    </h1>

    <!-- Subtitle Ramah Pemborong & Mandor -->
    <p class="text-base sm:text-xl text-slate-200 leading-relaxed font-normal max-w-3xl">
      Stok <strong>10.000+ set pipa baja SNI tebal {siteConfig.stats.pipeThickness}</strong>. Melayani sewa harian, mingguan, bulanan, dan jual baru / rekondisi Grade A. Pengiriman cepat armada sendiri langsung ke lokasi proyek. <span class="text-amber-300 font-bold underline underline-offset-4">Bisa Bayar di Tempat (COD)</span> setelah barang dicek mandor.
    </p>

    <!-- Area Pengiriman Cepat -->
    {coveredDistricts && coveredDistricts.length > 0 && (
      <div class="inline-flex flex-wrap items-center justify-center gap-2 text-xs sm:text-sm text-slate-300 bg-white/10 px-4 py-2 rounded-lg backdrop-blur-xs">
        <span class="font-bold text-amber-300">Siap Kirim Cepat Ke:</span>
        <span>{coveredDistricts.slice(0, 6).join(' • ')} &amp; sekitarnya (Tiba dalam {deliveryEstimate})</span>
      </div>
    )}

    <!-- Tombol Kapsul Raksasa Khas Elementor -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2 w-full sm:w-auto">
      <a
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-[#25D366] hover:bg-[#20bd5a] text-white font-black text-base sm:text-lg px-8 py-4 rounded-full shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-0.5 active:scale-95"
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-source="hero_cta"
        data-wa-mode="SEWA & BELI"
        data-wa-city={city}
      >
        <MessageCircle className="w-6 h-6 fill-current shrink-0" />
        <span>CHAT WHATSAPP SEKARANG (FAST RESPON)</span>
      </a>

      <a
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-white hover:bg-slate-100 text-slate-900 font-black text-base sm:text-lg px-7 py-4 rounded-full shadow-md transition-all"
        href={`tel:${siteConfig.phone}`}
      >
        <Phone className="w-5 h-5 text-[#0284c7] shrink-0" />
        <span>TELEPON: {siteConfig.phoneDisplay}</span>
      </a>
    </div>
  </div>
</section>

<!-- 4 TRUST BAR RIBBON KHAS ELEMENTOR (TERLETAK TEPAT DI BAWAH HERO) -->
<section class="bg-white border-b border-slate-200 py-6 px-4 shadow-xs relative z-10" id="keunggulan">
  <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="flex items-center gap-3.5 p-2">
      <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 border border-emerald-100">
        <CheckCircle2 className="w-6 h-6" />
      </div>
      <div>
        <h2 class="text-sm sm:text-base font-extrabold text-slate-900">Bisa Bayar di Tempat (COD)</h2>
        <p class="text-xs text-slate-500 mt-0.5">Barang sampai dicek mandor, baru pelunasan</p>
      </div>
    </div>

    <div class="flex items-center gap-3.5 p-2">
      <div class="w-12 h-12 rounded-full bg-blue-50 text-[#0284c7] flex items-center justify-center shrink-0 border border-blue-100">
        <Truck className="w-6 h-6" />
      </div>
      <div>
        <h2 class="text-sm sm:text-base font-extrabold text-slate-900">Kirim Cepat Armada Sendiri</h2>
        <p class="text-xs text-slate-500 mt-0.5">Tiba dalam 1-3 jam langsung ke proyek</p>
      </div>
    </div>

    <div class="flex items-center gap-3.5 p-2">
      <div class="w-12 h-12 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 border border-amber-100">
        <ShieldCheck className="w-6 h-6" />
      </div>
      <div>
        <h2 class="text-sm sm:text-base font-extrabold text-slate-900">Pipa Standar SNI 07-0065</h2>
        <p class="text-xs text-slate-500 mt-0.5">Tebal 1.8mm–2.0mm &amp; garansi tukar unit</p>
      </div>
    </div>

    <div class="flex items-center gap-3.5 p-2">
      <div class="w-12 h-12 rounded-full bg-purple-50 text-purple-600 flex items-center justify-center shrink-0 border border-purple-100">
        <Calculator className="w-6 h-6" />
      </div>
      <div>
        <h2 class="text-sm sm:text-base font-extrabold text-slate-900">Gratis Konsultasi Hitung Set</h2>
        <p class="text-xs text-slate-500 mt-0.5">Bantu hitung kebutuhan luas &amp; tinggi proyek</p>
      </div>
    </div>
  </div>
</section>