---
import locations from '../../data/locations.json';

export interface Props {
  city?: string;
}

const { city = 'Tangerang & Jabodetabek' } = Astro.props;
---

<!-- ==============================================
     LAYANAN LOKAL (PERSIS SEPERTI DI PT SNI)
=============================================== -->
<section class="py-20 bg-white" id="layanan-lokal">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-montserrat font-bold text-red-600 mb-4">
        Sewa Scaffolding
        <span class="text-gray-800">
          Terdekat di Kota Anda
        </span>
      </h2>
      <p class="text-lg md:text-xl text-gray-600 max-w-4xl mx-auto font-roboto">
        Fokus layanan utama kami di {city} dan seluruh wilayah penyangga (Tangerang, Jakarta Barat, Jakarta Selatan, BSD Serpong, Cipondoh, Karawaci, Cikupa Balaraja, Depok, dan Bekasi) untuk kebutuhan sewa scaffolding, rental scaffolding, dan sewa steger proyek konstruksi. Tim siap survei lokasi dan pengiriman cepat.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {locations.map((loc) => (
        <a
          href={`/area/${loc.slug}`}
          class="block border border-gray-200 rounded-xl p-6 shadow-sm hover:shadow-md hover:border-red-400 transition-all bg-white group"
        >
          <h3 class="text-xl font-montserrat font-bold text-gray-800 mb-2 group-hover:text-red-600 transition-colors">
            Sewa Scaffolding {loc.cityName}
          </h3>
          <p class="text-gray-600 text-sm font-roboto leading-relaxed">
            Rental scaffolding untuk proyek rumah tinggal, ruko, gudang, dan gedung bertingkat di wilayah {loc.cityName}.
          </p>
        </a>
      ))}
    </div>
  </div>
</section>
