---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

const galleryItems = [
  {
    id: 'DOK-01',
    title: 'Stok Gudang Ready',
    description: 'Ribuan set main frame & silangan tersusun rapi siap muat.',
    badge: '10.000+ Set Ready',
    webp: '/assets/img/warehouse/stok-gudang.webp',
    image: '/assets/img/warehouse/stok-gudang.jpg',
    alt: `Stok gudang scaffolding main frame dan cross brace siap kirim di ${city}`,
  },
  {
    id: 'DOK-02',
    title: 'Armada Pengiriman',
    description: 'Pikap & truk mandiri siap antar 1-3 jam ke proyek Anda.',
    badge: 'Kirim Cepat Hari Ini',
    webp: '/assets/img/warehouse/armada-pengiriman.webp',
    image: '/assets/img/warehouse/armada-pengiriman.jpg',
    alt: `Armada pikap dan truk pengiriman scaffolding ${siteConfig.businessName} siap kirim ke ${city}`,
  },
  {
    id: 'DOK-03',
    title: 'Uji Pipa SNI (Sigmat)',
    description: 'Pipa baja tebal 1.8mm - 2.0mm dipastikan presisi & aman beban.',
    badge: 'Pipa SNI 1.8 - 2.0mm',
    webp: '/assets/img/warehouse/uji-ketebalan-pipa.webp',
    image: '/assets/img/warehouse/uji-ketebalan-pipa.jpg',
    alt: 'Pengecekan ketebalan pipa scaffolding standar SNI 1.8mm - 2.0mm dan sambungan joint pin presisi',
  },
  {
    id: 'DOK-04',
    title: 'Proyek Lapangan Nyata',
    description: 'Pemasangan di proyek ruko, perumahan, dan gedung bertingkat.',
    badge: 'Proyek Jabodetabek',
    webp: '/assets/img/project-royal-residence.webp',
    image: '/assets/img/project-royal-residence.jpg',
    alt: `Dokumentasi pemasangan scaffolding main frame pada proyek konstruksi bangunan di ${city}`,
  },
];
---

<!-- ==============================================
     DOKUMENTASI FISIK GUDANG & ARMADA (BENTO GRID INDUSTRIAL)
=============================================== -->
<section class="py-14 bg-white border-b border-slate-200" id="galeri-gudang">
  <div class="container mx-auto px-4">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-none bg-red-50 border border-red-200 text-red-600 text-xs font-montserrat font-bold uppercase tracking-wider mb-2.5">
        <i class="fas fa-camera text-sm"></i>
        <span>Bukti Fisik Gudang &amp; Armada</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-montserrat font-bold text-gray-900 mb-3">
        Dokumentasi Gudang &amp; <span class="text-red-600">Armada Pengiriman</span>
      </h2>
      <p class="text-sm sm:text-base text-gray-600 max-w-xl mx-auto font-roboto">
        Stok fisik ribuan set pipa baja standar SNI 07-0065 dan armada pengiriman langsung dari gudang pusat di {city}.
      </p>
    </div>

    <!-- Hint Geser di Layar HP (Animasi Otomatis Aktif) -->
    <div class="flex items-center justify-between text-xs text-slate-500 font-roboto sm:hidden mb-2.5 px-1">
      <span class="flex items-center gap-1.5 font-medium text-slate-700">
        <span class="w-2 h-2 rounded-full bg-red-600 animate-ping"></span>
        <span>Geser otomatis kesamping (atau swipe manual)</span>
      </span>
      <span class="text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-mono font-bold">1 - 4 Foto</span>
    </div>

    <!-- Bento Grid Industrial: Auto-Slide Geser Sendiri di Mobile, 2 Kolom Tablet, 4 Kolom Desktop -->
    <div
      id="warehouse-mobile-gallery"
      class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 -mx-4 px-4 no-scrollbar sm:grid sm:grid-cols-2 lg:grid-cols-4 sm:gap-6 sm:overflow-visible sm:pb-0 sm:mx-0 sm:px-0 max-w-7xl mx-auto scroll-smooth"
    >
      {galleryItems.map((item) => (
        <article class="w-[82vw] max-w-[290px] shrink-0 snap-center sm:w-auto sm:max-w-none sm:shrink group bg-white rounded-none overflow-hidden border-2 border-slate-200 hover:border-red-600 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between">
          <!-- Frame Foto Konsisten Aspect Ratio 4:3, Sudut rounded-none -->
          <div class="relative aspect-[4/3] w-full bg-slate-100 rounded-none overflow-hidden">
            <picture class="block w-full h-full">
              <source srcset={item.webp} type="image/webp" />
              <img
                src={item.image}
                alt={item.alt}
                width="800"
                height="600"
                class="w-full h-full object-cover rounded-none group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                decoding="async"
              />
            </picture>

            <!-- Badge Kategori Pojok Kiri Atas -->
            <div class="absolute top-2.5 left-2.5 bg-red-600 text-white text-[10px] sm:text-[11px] font-montserrat font-bold px-2 py-0.5 rounded-none shadow">
              {item.badge}
            </div>

            <!-- Kode Blueprint Pojok Kanan Bawah -->
            <div class="absolute bottom-2 right-2 bg-slate-900/85 text-white text-[10px] font-mono font-bold px-2 py-0.5 rounded-none tracking-wider">
              {item.id}
            </div>
          </div>

          <!-- Keterangan Singkat Tanpa Bertele-tele -->
          <div class="p-4 bg-white flex-grow flex flex-col justify-between border-t-2 border-slate-200">
            <div>
              <h3 class="font-montserrat font-bold text-gray-900 text-sm sm:text-base mb-1 group-hover:text-red-600 transition-colors">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm text-gray-600 font-roboto leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  function initGalleryAutoScroll() {
    const gallery = document.getElementById('warehouse-mobile-gallery');
    if (!gallery) return;

    let isInteracting = false;
    let resumeTimeout;

    function autoSlide() {
      // Hanya berjalan di layar mobile (< 640px) saat pengguna tidak sedang menyentuh layar
      if (window.innerWidth >= 640 || isInteracting) return;

      const maxScroll = gallery.scrollWidth - gallery.clientWidth;
      if (gallery.scrollLeft >= maxScroll - 20) {
        gallery.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        // Geser selebar satu kartu
        gallery.scrollBy({ left: 280, behavior: 'smooth' });
      }
    }

    // Geser otomatis setiap 2.8 detik
    const timer = setInterval(autoSlide, 2800);

    // Jeda saat disentuh atau kursor masuk, lanjutkan kembali setelah jeda
    gallery.addEventListener('touchstart', () => {
      isInteracting = true;
      clearTimeout(resumeTimeout);
    }, { passive: true });

    gallery.addEventListener('touchend', () => {
      clearTimeout(resumeTimeout);
      resumeTimeout = setTimeout(() => {
        isInteracting = false;
      }, 3500);
    }, { passive: true });

    gallery.addEventListener('mouseenter', () => { isInteracting = true; });
    gallery.addEventListener('mouseleave', () => { isInteracting = false; });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGalleryAutoScroll);
  } else {
    initGalleryAutoScroll();
  }
</script>
