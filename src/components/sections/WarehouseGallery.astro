---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

const galleryItems = [
  {
    id: 'DOK-01',
    title: 'Gudang & Armada Toko',
    description: 'Pusat stok fisik & armada truk siaga antar 1–3 jam.',
    badge: 'Armada Siaga',
    webp: '/assets/img/warehouse/gudang-toko-central-scaffolding-2026.webp?v=20261031',
    image: '/assets/img/warehouse/gudang-toko-central-scaffolding-2026.jpg?v=20261031',
    alt: `Gudang fisik dan armada truk pengiriman scaffolding ${siteConfig.businessName} siap kirim ke ${city}`,
  },
  {
    id: 'DOK-02',
    title: 'Stok Baja Ready',
    description: '10.000+ set main frame & silangan tersusun rapi.',
    badge: '10.000+ Set Ready',
    webp: '/assets/img/warehouse/stok-gudang.webp',
    image: '/assets/img/warehouse/stok-gudang.jpg',
    alt: `Stok gudang scaffolding main frame dan cross brace siap kirim di ${city}`,
  },
  {
    id: 'DOK-03',
    title: 'Komponen & Joint Pin',
    description: 'Pipa baja tebal 1.8–2.0 mm & sambungan presisi standar SNI.',
    badge: 'Standar SNI',
    webp: '/assets/img/warehouse/uji-ketebalan-pipa.webp',
    image: '/assets/img/warehouse/uji-ketebalan-pipa.jpg',
    alt: 'Pengecekan komponen joint pin dan klem scaffolding standar SNI pipa tebal 1.8mm - 2.0mm',
  },
  {
    id: 'DOK-04',
    title: 'Instalasi Proyek Nyata',
    description: 'Terpasang kokoh pada proyek cor & gedung Jabodetabek.',
    badge: 'Terbukti di Proyek',
    webp: '/assets/img/projects/project-cluster-mozia-bsd.webp?v=20261031',
    image: '/assets/img/projects/project-cluster-mozia-bsd.webp?v=20261031',
    alt: `Dokumentasi pemasangan scaffolding main frame pada proyek perumahan nyata di ${city}`,
  },
];
---

<!-- ==============================================
     BUKTI FISIK GUDANG & ARMADA (RINGKAS 2X2 MOBILE, 4 KOLOM DESKTOP)
=============================================== -->
<section class="py-9 sm:py-14 bg-white border-b border-slate-200" id="galeri-gudang">
  <div class="container mx-auto px-4">
    <div class="text-center mb-6 sm:mb-9">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-red-50 border border-red-200 text-red-700 text-xs font-montserrat font-bold uppercase tracking-wider mb-2">
        <i class="fas fa-camera text-xs"></i>
        <span>Bukti Fisik Gudang &amp; Armada</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-montserrat font-bold text-slate-900">
        Dokumentasi Gudang &amp; <span class="text-red-600">Armada Sendiri</span>
      </h2>
    </div>

    <!-- Grid 2x2 Padat di Mobile, 4 Kolom di Desktop -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5 max-w-7xl mx-auto">
      {galleryItems.map((item) => (
        <article class="group bg-white overflow-hidden border border-slate-200 hover:border-red-600 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between">
          <!-- Frame Foto Aspect Ratio 4:3 -->
          <div class="relative aspect-[4/3] w-full bg-slate-100 overflow-hidden">
            <picture class="block w-full h-full">
              <source srcset={item.webp} type="image/webp" />
              <img
                src={item.image}
                alt={item.alt}
                width="600"
                height="450"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                decoding="async"
              />
            </picture>

            <!-- Badge Pojok Kiri Atas -->
            <div class="absolute top-2 left-2 bg-red-600/95 text-white text-[11px] font-montserrat font-bold px-2 py-0.5 rounded shadow-sm">
              {item.badge}
            </div>

            <!-- Kode Blueprint Pojok Kanan Bawah -->
            <div class="block absolute bottom-2 right-2 bg-slate-900/90 text-white text-[10px] font-mono font-bold px-2 py-0.5 rounded tracking-wider shadow-sm">
              {item.id}
            </div>
          </div>

          <!-- Keterangan Singkat & Padat -->
          <div class="p-3 sm:p-4 bg-white flex-grow border-t border-slate-100">
            <h3 class="font-montserrat font-bold text-slate-900 text-xs sm:text-base mb-1 group-hover:text-red-600 transition-colors leading-snug">
              {item.title}
            </h3>
            <p class="text-xs text-slate-600 font-roboto leading-snug">
              {item.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
