---
import { siteConfig } from '../../data/siteConfig';

export interface Props {
  city?: string;
}

const { city = siteConfig.warehouseAddress.city } = Astro.props;

const galleryItems = [
  {
    id: 'DOK-01',
    title: 'Stok Gudang Scaffolding Ready',
    description: 'Ribuan set main frame, cross brace, dan catwalk tersusun rapi di gudang siap muat.',
    badge: '10.000+ Set Ready',
    webp: '/assets/img/warehouse/stok-gudang.webp',
    image: '/assets/img/warehouse/stok-gudang.jpg',
    alt: `Stok gudang scaffolding main frame dan cross brace siap kirim di ${city}`,
  },
  {
    id: 'DOK-02',
    title: 'Armada Pikap & Truk Pengiriman',
    description: 'Armada mandiri siap berangkat mengantar scaffolding 1-3 jam ke lokasi proyek Anda.',
    badge: 'Kirim Cepat Hari Ini',
    webp: '/assets/img/warehouse/armada-pengiriman.webp',
    image: '/assets/img/warehouse/armada-pengiriman.jpg',
    alt: `Armada pikap dan truk pengiriman scaffolding ${siteConfig.businessName} siap kirim ke ${city}`,
  },
  {
    id: 'DOK-03',
    title: 'Pengecekan Ketebalan Pipa (Sigmat)',
    description: 'Pipa baja standar SNI 07-0065 tebal 1.8mm - 2.0mm dipastikan presisi & aman menahan beban.',
    badge: 'Pipa SNI 1.8 - 2.0mm',
    webp: '/assets/img/warehouse/uji-ketebalan-pipa.webp',
    image: '/assets/img/warehouse/uji-ketebalan-pipa.jpg',
    alt: 'Pengecekan ketebalan pipa scaffolding standar SNI 1.8mm - 2.0mm dan sambungan joint pin presisi',
  },
  {
    id: 'DOK-04',
    title: 'Pemasangan di Lokasi Proyek Nyata',
    description: 'Dokumentasi instalasi scaffolding untuk proyek ruko, perumahan, dan gedung bertingkat.',
    badge: 'Proyek Jabodetabek',
    webp: '/assets/img/project-royal-residence.webp',
    image: '/assets/img/project-royal-residence.jpg',
    alt: `Dokumentasi pemasangan scaffolding main frame pada proyek konstruksi bangunan di ${city}`,
  },
];
---

<!-- ==============================================
     DOKUMENTASI FISIK GUDANG & ARMADA (BENTO GRID INDUSTRIAL)
=============================================== -->
<section class="py-16 bg-white border-b border-slate-200" id="galeri-gudang">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-none bg-red-50 border border-red-200 text-red-600 text-xs font-montserrat font-bold uppercase tracking-wider mb-3">
        <i class="fas fa-camera text-sm"></i>
        <span>Bukti Fisik Toko &amp; Gudang</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-montserrat font-bold text-gray-900 mb-4">
        Dokumentasi Gudang &amp; <span class="text-red-600">Armada Pengiriman</span>
      </h2>
      <p class="text-base sm:text-lg text-gray-600 max-w-3xl mx-auto font-roboto">
        Bukan makelar atau calo online. Kunjungi langsung fisik toko dan gudang kami di {city} untuk mengecek stok ribuan set dan ketebalan pipa besi standar SNI.
      </p>
    </div>

    <!-- Bento Grid Industrial 4 Kolom Desktop, 2 Kolom Tablet, 1 Kolom Mobile -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
      {galleryItems.map((item) => (
        <article class="group bg-white rounded-none overflow-hidden border-2 border-slate-200 hover:border-red-600 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between">
          <!-- Frame Foto Konsisten Aspect Ratio 4:3, Sudut rounded-none -->
          <div class="relative aspect-[4/3] w-full bg-slate-100 rounded-none overflow-hidden">
            <picture class="block w-full h-full">
              <source srcset={item.webp} type="image/webp" />
              <img
                src={item.image}
                alt={item.alt}
                width="800"
                height="600"
                class="w-full h-full object-cover rounded-none group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                decoding="async"
              />
            </picture>

            <!-- Badge Kategori Pojok Kiri Atas -->
            <div class="absolute top-3 left-3 bg-red-600 text-white text-[11px] font-montserrat font-bold px-2.5 py-1 rounded-none shadow">
              {item.badge}
            </div>

            <!-- Kode Blueprint Pojok Kanan Bawah -->
            <div class="absolute bottom-2 right-2 bg-slate-900/85 text-white text-[10px] font-mono font-bold px-2 py-0.5 rounded-none tracking-wider">
              {item.id}
            </div>
          </div>

          <!-- Keterangan Singkat -->
          <div class="p-5 bg-white flex-grow flex flex-col justify-between border-t-2 border-slate-200">
            <div>
              <h3 class="font-montserrat font-bold text-gray-900 text-base mb-2 group-hover:text-red-600 transition-colors">
                {item.title}
              </h3>
              <p class="text-sm text-gray-600 font-roboto leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
