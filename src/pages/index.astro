---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/sections/Hero.astro';
import LayananLokal from '../components/sections/LayananLokal.astro';
import AboutUs from '../components/sections/AboutUs.astro';
import ProductsSection from '../components/sections/ProductsSection.astro';
import ProjectsShowcase from '../components/sections/ProjectsShowcase.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactBranches from '../components/sections/ContactBranches.astro';
import { siteConfig } from '../data/siteConfig';

const defaultCity = `${siteConfig.warehouseAddress.city} & Jabodetabek`;
const defaultDistricts = [
  'Cipondoh',
  'Karawaci',
  'Ciledug',
  'BSD & Serpong',
  'Cikupa & Balaraja',
  'Jakarta Barat',
  'Jakarta Selatan',
];
const defaultDeliveryEstimate = `${siteConfig.stats.deliverySla} (Armada Gudang Cipondoh)`;
const homeTitle = `Sewa & Jual Scaffolding Terpercaya Tangerang & Jabodetabek | Central Scaffolding`;
const homeDescription = `Pusat sewa (rental) dan jual beli scaffolding pipa tebal standar SNI 07-0065 di Tangerang & Jabodetabek. Stok gudang 10.000+ set siap kirim 1-3 jam oleh Central Scaffolding.`;
---

<MainLayout
  city={defaultCity}
  coveredDistricts={defaultDistricts}
  title={homeTitle}
  description={homeDescription}
>
  <!-- 1. Hero Section + Stats (#stats) -->
  <Hero
    city={defaultCity}
    coveredDistricts={defaultDistricts}
    deliveryEstimate={defaultDeliveryEstimate}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 2. Layanan Lokal (#layanan-lokal) -->
  <LayananLokal city={defaultCity} />

  <!-- 3. Tentang Kami (#about) -->
  <AboutUs city={defaultCity} />

  <!-- 4. Produk Scaffolding Kami (#products) -->
  <ProductsSection
    city={defaultCity}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 5. Proyek Terbaru (#projects) -->
  <ProjectsShowcase
    city={defaultCity}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 6. FAQ (#faq) -->
  <FaqSection city={defaultCity} />

  <!-- 7. Kontak & Cabang (#contact) -->
  <ContactBranches
    city={defaultCity}
    whatsappNumber={siteConfig.whatsappNumber}
  />
</MainLayout>
