---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/sections/Hero.astro';
import WarehouseGallery from '../components/sections/WarehouseGallery.astro';
import ProductsSection from '../components/sections/ProductsSection.astro';
import ProjectsShowcase from '../components/sections/ProjectsShowcase.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactBranches from '../components/sections/ContactBranches.astro';
import { siteConfig } from '../data/siteConfig';

const defaultCity = `${siteConfig.warehouseAddress.city} & Jabodetabek`;
const defaultDistricts = [
  'Cipondoh',
  'Karawaci',
  'Ciledug',
  'BSD & Serpong',
  'Cikupa & Balaraja',
  'Jakarta Barat',
  'Jakarta Selatan',
];
const defaultDeliveryEstimate = `${siteConfig.stats.deliverySla} (Armada Gudang Tangerang)`;
const homeTitle = `Central Scaffolding: Pusat Sewa Scaffolding, Beli & Jual Scaffolding SNI`;
const homeDescription = `Cari scaffolding proyek? Central Scaffolding melayani sewa scaffolding (rental harian/bulanan) & beli scaffolding baru maupun second standar SNI. Ready stok 10.000+ set (Main Frame 1.90m & 1.70m), kirim cepat 1–3 jam di Tangerang, Jakarta, BSD & se-Jabodetabek. Bisa bayar COD.`;
---

<MainLayout
  city={defaultCity}
  coveredDistricts={defaultDistricts}
  title={homeTitle}
  description={homeDescription}
>
  <!-- 1. Hero Section + Stats (#stats) -->
  <Hero
    city={defaultCity}
    coveredDistricts={defaultDistricts}
    deliveryEstimate={defaultDeliveryEstimate}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 2. Galeri Dokumentasi Gudang & Armada (Slot Foto Fisik) -->
  <WarehouseGallery city={defaultCity} />

  <!-- 3. Produk Scaffolding Kami (Katalog Visual & Tabel Spek Ringkas) -->
  <ProductsSection
    city={defaultCity}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 4. Proyek Terbaru (Portofolio Foto Lapangan) -->
  <ProjectsShowcase
    city={defaultCity}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 6. FAQ (Pertanyaan Umum) -->
  <FaqSection city={defaultCity} />

  <!-- 7. Kontak & Cabang (#contact: Google Maps Asli Tangerang) -->
  <ContactBranches
    city={defaultCity}
    whatsappNumber={siteConfig.whatsappNumber}
  />
</MainLayout>
