---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/sections/Hero.astro';
import WarehouseGallery from '../components/sections/WarehouseGallery.astro';
import ProductsSection from '../components/sections/ProductsSection.astro';
import AboutUs from '../components/sections/AboutUs.astro';
import LayananLokal from '../components/sections/LayananLokal.astro';
import ProjectsShowcase from '../components/sections/ProjectsShowcase.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactBranches from '../components/sections/ContactBranches.astro';
import { siteConfig } from '../data/siteConfig';

const defaultCity = `${siteConfig.warehouseAddress.city} & Jabodetabek`;
const defaultDistricts = [
  'Cipondoh',
  'Karawaci',
  'Ciledug',
  'BSD & Serpong',
  'Cikupa & Balaraja',
  'Jakarta Barat',
  'Jakarta Selatan',
];
const defaultDeliveryEstimate = `${siteConfig.stats.deliverySla} (Armada Gudang Cipondoh)`;
const homeTitle = `Sewa & Jual Scaffolding Standar SNI — Tangerang, Jabodetabek & Seluruh Indonesia | Central Scaffolding`;
const homeDescription = `Pusat sewa (rental) dan jual beli scaffolding pipa tebal 1.8–2.0 mm standar SNI di Tangerang, Jabodetabek, serta pengiriman ke seluruh Indonesia. Ready stok 10.000+ set siap kirim 1–3 jam.`;
---

<MainLayout
  city={defaultCity}
  coveredDistricts={defaultDistricts}
  title={homeTitle}
  description={homeDescription}
>
  <!-- 1. Hero Section + Stats (#stats) -->
  <Hero
    city={defaultCity}
    coveredDistricts={defaultDistricts}
    deliveryEstimate={defaultDeliveryEstimate}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 2. Galeri Dokumentasi Gudang & Armada (Slot Foto Fisik) -->
  <WarehouseGallery city={defaultCity} />

  <!-- 3. Produk Scaffolding Kami (Katalog Visual & Tabel Spek Ringkas) -->
  <ProductsSection
    city={defaultCity}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 4. Tentang Kami (Split Layout: Foto Utama + 4 Garansi Ringkas) -->
  <AboutUs city={defaultCity} />

  <!-- 5. Area Layanan (Kartu Ringkas + Estimasi Jam Kirim) -->
  <LayananLokal city={defaultCity} />

  <!-- 6. Proyek Terbaru (Portofolio Foto Lapangan) -->
  <ProjectsShowcase
    city={defaultCity}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 7. FAQ (Pertanyaan Umum) -->
  <FaqSection city={defaultCity} />

  <!-- 8. Kontak & Cabang (#contact: Google Maps Asli Tangerang) -->
  <ContactBranches
    city={defaultCity}
    whatsappNumber={siteConfig.whatsappNumber}
  />
</MainLayout>
