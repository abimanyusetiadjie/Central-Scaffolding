---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import LayananLokal from '../../components/sections/LayananLokal.astro';
import AboutUs from '../../components/sections/AboutUs.astro';
import ProductsSection from '../../components/sections/ProductsSection.astro';
import ProjectsShowcase from '../../components/sections/ProjectsShowcase.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import ContactBranches from '../../components/sections/ContactBranches.astro';
import locations from '../../data/locations.json';
import { siteConfig, type TargetLocation } from '../../data/siteConfig';

export interface Props {
  locationData: TargetLocation;
}

export async function getStaticPaths() {
  return (locations as TargetLocation[]).map((loc) => ({
    params: { slug: loc.slug },
    props: { locationData: loc },
  }));
}

const { locationData } = Astro.props;
---

<MainLayout
  city={locationData.cityName}
  coveredDistricts={locationData.coveredDistricts}
  description={locationData.metaDescription}
  title={locationData.metaTitle}
>
  <!-- 1. Hero Section + Stats (#stats) -->
  <Hero
    city={locationData.cityName}
    coveredDistricts={locationData.coveredDistricts}
    deliveryEstimate={locationData.deliveryEstimate}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 2. Layanan Lokal (#layanan-lokal) -->
  <LayananLokal city={locationData.cityName} />

  <!-- 3. Tentang Kami (#about) -->
  <AboutUs city={locationData.cityName} />

  <!-- 4. Produk Scaffolding Kami (#products) -->
  <ProductsSection
    city={locationData.cityName}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 5. Proyek Terbaru (#projects) -->
  <ProjectsShowcase
    city={locationData.cityName}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 6. FAQ (#faq) -->
  <FaqSection city={locationData.cityName} />

  <!-- 7. Kontak & Cabang (#contact) -->
  <ContactBranches
    city={locationData.cityName}
    whatsappNumber={siteConfig.whatsappNumber}
  />
</MainLayout>
