---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import WarehouseGallery from '../../components/sections/WarehouseGallery.astro';
import ProductsSection from '../../components/sections/ProductsSection.astro';
import ProjectsShowcase from '../../components/sections/ProjectsShowcase.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import ContactBranches from '../../components/sections/ContactBranches.astro';
import locations from '../../data/locations.json';
import { siteConfig, type TargetLocation } from '../../data/siteConfig';

export interface Props {
  locationData: TargetLocation;
}

export async function getStaticPaths() {
  return (locations as TargetLocation[]).map((loc) => ({
    params: { slug: loc.slug },
    props: { locationData: loc },
  }));
}

const { locationData } = Astro.props;
const otherLocations = (locations as TargetLocation[]).filter(
  (loc) => loc.slug !== locationData.slug
);
---

<MainLayout
  city={locationData.cityName}
  coveredDistricts={locationData.coveredDistricts}
  description={locationData.metaDescription}
  title={locationData.metaTitle}
  breadcrumbLabel={`Sewa & Beli Scaffolding ${locationData.cityName}`}
>
  <!-- 1. Hero Section + Stats (#stats) -->
  <Hero
    city={locationData.cityName}
    coveredDistricts={locationData.coveredDistricts}
    deliveryEstimate={locationData.deliveryEstimate}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 1B. Konten Lokal Unik Khusus Wilayah (Anti-Duplikasi & Local SEO) -->
  {locationData.localOverview && (
    <section class="py-8 sm:py-12 bg-white border-b border-slate-200">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-7 items-start">
          <div class="lg:col-span-7 space-y-3">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-red-50 border border-red-200 text-red-700 text-xs font-montserrat font-bold uppercase tracking-wider">
              <i class="fas fa-truck-fast text-xs"></i>
              <span>Pengiriman Khusus {locationData.cityName} ({locationData.deliveryEstimate})</span>
            </div>
            <h2 class="text-xl sm:text-3xl font-montserrat font-bold text-slate-900 leading-snug">
              Layanan Pengiriman Scaffolding <span class="text-red-600">{locationData.cityName}</span>
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 font-roboto leading-relaxed">
              {locationData.localOverview}
            </p>
            {locationData.routeAccess && (
              <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-3.5 text-xs sm:text-sm font-roboto text-slate-700">
                <strong class="text-slate-900 font-montserrat block mb-1">
                  <i class="fas fa-route text-red-600 mr-1.5"></i>Akses Jalur Armada ke {locationData.cityName}:
                </strong>
                <span>{locationData.routeAccess}</span>
              </div>
            )}
            <p class="text-xs text-slate-500 font-roboto pt-1">
              Dikelola langsung oleh <a href="/" class="text-red-600 font-semibold hover:underline">Central Scaffolding</a> — baca juga <a href="/panduan-scaffolding/" class="text-red-600 font-semibold hover:underline">panduan ukuran &amp; hitung kebutuhan set scaffolding</a> sebelum memesan.
            </p>
          </div>

          <div class="lg:col-span-5 bg-slate-50 rounded-2xl border border-slate-200 p-4 sm:p-5 space-y-4">
            {locationData.projectHighlights && locationData.projectHighlights.length > 0 && (
              <div>
                <h3 class="text-xs sm:text-sm font-montserrat font-bold text-slate-900 uppercase tracking-wide mb-2.5">
                  Kebutuhan Proyek Populer di {locationData.cityName}
                </h3>
                <ul class="space-y-2 text-xs sm:text-sm text-slate-700 font-roboto">
                  {locationData.projectHighlights.map((point) => (
                    <li class="flex items-start gap-2">
                      <i class="fas fa-check-circle text-emerald-600 mt-0.5 shrink-0"></i>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="pt-3 border-t border-slate-200/80">
              <p class="text-[11px] font-montserrat font-bold text-slate-500 uppercase tracking-wider mb-2">
                Area Lainnya yang Dilayani:
              </p>
              <div class="flex flex-wrap gap-1.5">
                {otherLocations.map((loc) => (
                  <a
                    href={`/area/${loc.slug}/`}
                    class="text-[11px] font-medium text-slate-700 bg-white hover:bg-red-50 hover:text-red-700 border border-slate-200 hover:border-red-300 px-2.5 py-1 rounded-md transition-colors"
                  >
                    {loc.cityName}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 2. Galeri Dokumentasi Gudang & Armada (Slot Foto Fisik) -->
  <WarehouseGallery city={locationData.cityName} />

  <!-- 3. Produk Scaffolding Kami (Katalog Visual & Tabel Spek Ringkas) -->
  <ProductsSection
    city={locationData.cityName}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 4. Proyek Terbaru (Portofolio Foto Lapangan) -->
  <ProjectsShowcase
    city={locationData.cityName}
    whatsappNumber={siteConfig.whatsappNumber}
  />

  <!-- 6. FAQ (Pertanyaan Umum) -->
  <FaqSection city={locationData.cityName} />

  <!-- 7. Kontak & Cabang (#contact: Google Maps Asli Tangerang) -->
  <ContactBranches
    city={locationData.cityName}
    whatsappNumber={siteConfig.whatsappNumber}
  />
</MainLayout>
