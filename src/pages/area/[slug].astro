---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import LayananLokal from '../../components/sections/LayananLokal.astro';
import AboutUs from '../../components/sections/AboutUs.astro';
import ServiceSplit from '../../components/sections/ServiceSplit.astro';
import CatalogFilter from '../../components/islands/CatalogFilter';
import PackageSelector from '../../components/islands/PackageSelector';
import ProjectsShowcase from '../../components/sections/ProjectsShowcase.astro';
import OrderSteps from '../../components/sections/OrderSteps.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import WarehouseProof from '../../components/sections/WarehouseProof.astro';
import locations from '../../data/locations.json';
import { siteConfig, type TargetLocation } from '../../data/siteConfig';

export interface Props {
  locationData: TargetLocation;
}

export async function getStaticPaths() {
  return (locations as TargetLocation[]).map((loc) => ({
    params: { slug: loc.slug },
    props: { locationData: loc },
  }));
}

const { locationData } = Astro.props;
---

<MainLayout
  city={locationData.cityName}
  coveredDistricts={locationData.coveredDistricts}
  description={locationData.metaDescription}
  title={locationData.metaTitle}
>
  <Hero
    city={locationData.cityName}
    coveredDistricts={locationData.coveredDistricts}
    deliveryEstimate={locationData.deliveryEstimate}
    whatsappNumber={siteConfig.whatsappNumber}
  />
  <LayananLokal city={locationData.cityName} />
  <AboutUs city={locationData.cityName} />
  <ServiceSplit city={locationData.cityName} />
  <CatalogFilter
    client:visible
    city={locationData.cityName}
    whatsappNumber={siteConfig.whatsappNumber}
  />
  <PackageSelector
    client:visible
    defaultLocation={locationData.cityName}
    whatsappNumber={siteConfig.whatsappNumber}
  />
  <ProjectsShowcase city={locationData.cityName} />
  <OrderSteps city={locationData.cityName} />
  <FaqSection city={locationData.cityName} />
  <WarehouseProof city={locationData.cityName} />
</MainLayout>