---
import MainLayout from '../layouts/MainLayout.astro';
import { siteConfig } from '../data/siteConfig';
import locations from '../data/locations.json';

const pageTitle = `Tentang Central Scaffolding — Profil & Standar SNI Tangerang`;
const pageDescription = `Profil resmi Central Scaffolding di Jl. KH. Hasyim Ashari No. 7, Tangerang. Supplier tangan pertama sewa & jual scaffolding SNI pipa tebal 1.8–2.0 mm, ready 10.000+ set.`;

const waMessage = encodeURIComponent(
  `Halo Admin ${siteConfig.businessName}, saya baru membaca profil perusahaan Anda dan ingin konsultasi kebutuhan sewa / beli scaffolding untuk proyek kami.`
);
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${waMessage}`;
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  city="Tangerang & Jabodetabek"
  breadcrumbLabel="Tentang Central Scaffolding"
  includeFaq={false}
  preloadHero={false}
>
  <!-- Header Halaman Profil -->
  <section class="pt-24 sm:pt-28 pb-10 sm:pb-14 bg-gradient-to-b from-slate-900 to-slate-800 text-white">
    <div class="container mx-auto px-4 max-w-5xl">
      <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-xs font-montserrat text-slate-300">
        <a href="/" class="hover:text-red-400 transition-colors font-semibold">Central Scaffolding</a>
        <span aria-hidden="true" class="text-slate-500">›</span>
        <span class="text-red-400 font-semibold">Tentang Kami</span>
      </nav>

      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-red-600/20 border border-red-500/40 text-red-300 text-xs font-montserrat font-bold uppercase tracking-wider mb-3">
        <i class="fas fa-building text-xs"></i>
        <span>Profil Resmi Perusahaan</span>
      </div>

      <h1 class="text-2xl sm:text-4xl md:text-5xl font-montserrat font-extrabold leading-tight mb-4">
        Tentang <span class="text-red-500">Central Scaffolding</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-200 font-roboto leading-relaxed max-w-3xl">
        <strong>Central Scaffolding</strong> adalah pusat penyewaan (rental) dan penjualan perlengkapan perancah besi (<em>scaffolding</em> / steger) tangan pertama yang berpusat di Kota Tangerang, melayani proyek konstruksi di seluruh wilayah Tangerang, DKI Jakarta, BSD Serpong, Bekasi, Depok, hingga Bogor.
      </p>
    </div>
  </section>

  <!-- Ringkasan Fakta & Identitas Resmi -->
  <section class="py-10 sm:py-14 bg-white">
    <div class="container mx-auto px-4 max-w-5xl space-y-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start">
        <div class="lg:col-span-7 space-y-4 font-roboto text-sm sm:text-base text-slate-700 leading-relaxed">
          <h2 class="text-xl sm:text-2xl font-montserrat font-bold text-slate-900">
            Supplier Tangan Pertama untuk Proyek Skala Kecil hingga Gedung Bertingkat
          </h2>
          <p>
            Di lapangan konstruksi, keterlambatan material atau kualitas pipa perancah yang tipis bukan sekadar kendala biaya, melainkan risiko keselamatan kerja (K3). Oleh karena itu, <a href="/" class="text-red-600 font-semibold hover:underline">Central Scaffolding</a> membangun rantai pasok mandiri — mulai dari stok gudang <strong>10.000+ set siap muat</strong>, pengecekan ketebalan pipa rutin, hingga armada pengiriman milik sendiri.
          </p>
          <p>
            Seluruh rangka <strong>Main Frame 1,90m</strong>, <strong>Main Frame 1,70m</strong>, dan <strong>Ladder Frame 0,90m</strong> yang disewakan maupun dijual (kondisi baru dan second rekondisi) menggunakan pipa baja tebal <strong>1.8 mm – 2.0 mm</strong> sesuai acuan standar SNI konstruksi.
          </p>
          <p>
            Kami juga memisahkan fungsi antara <strong>Toko &amp; Kantor Pemasaran Resmi</strong> (lokasi publik untuk konsultasi, cek fisik sampel pipa, dan penerbitan invoice) dengan <strong>Gudang Pusat &amp; Pool Logistik</strong> (lokasi terpisah khusus area bongkar muat armada truk dan pikap demi kelancaran antrean serta keselamatan kerja).
          </p>
        </div>

        <!-- Kartu Identitas Resmi (NAP Konsisten) -->
        <aside class="lg:col-span-5 bg-slate-50 rounded-2xl border border-slate-200 p-5 sm:p-6 space-y-4 shadow-sm">
          <h2 class="text-base sm:text-lg font-montserrat font-bold text-slate-900 pb-2.5 border-b border-slate-200">
            Identitas Resmi Central Scaffolding
          </h2>
          <dl class="space-y-3 text-xs sm:text-sm font-roboto">
            <div>
              <dt class="text-slate-500 font-semibold text-xs uppercase tracking-wider">Nama Usaha</dt>
              <dd class="text-slate-900 font-bold mt-0.5">{siteConfig.businessName}</dd>
            </div>
            <div>
              <dt class="text-slate-500 font-semibold text-xs uppercase tracking-wider">Toko &amp; Kantor Pemasaran</dt>
              <dd class="text-slate-800 mt-0.5 leading-relaxed">
                {siteConfig.storeAddress.street}, {siteConfig.storeAddress.district}, Kota {siteConfig.storeAddress.city}, {siteConfig.storeAddress.province} {siteConfig.storeAddress.postalCode}
              </dd>
            </div>
            <div>
              <dt class="text-slate-500 font-semibold text-xs uppercase tracking-wider">WhatsApp &amp; Telepon Resmi</dt>
              <dd class="mt-0.5">
                <a href={waUrl} target="_blank" rel="noopener noreferrer" class="text-emerald-700 font-bold hover:underline">
                  {siteConfig.whatsappDisplay}
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-slate-500 font-semibold text-xs uppercase tracking-wider">Jam Operasional</dt>
              <dd class="text-slate-800 mt-0.5">{siteConfig.operationalHours}</dd>
            </div>
            <div>
              <dt class="text-slate-500 font-semibold text-xs uppercase tracking-wider">Kanal Resmi Lainnya</dt>
              <dd class="mt-1.5 flex flex-wrap gap-2">
                <a
                  href={siteConfig.storeAddress.gmapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-md bg-white border border-slate-200 text-slate-700 hover:border-red-400 hover:text-red-600 transition-colors"
                >
                  <i class="fas fa-map-marker-alt text-red-600"></i>
                  <span>Google Maps</span>
                </a>
                <a
                  href={siteConfig.social.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-md bg-white border border-slate-200 text-slate-700 hover:border-red-400 hover:text-red-600 transition-colors"
                >
                  <i class="fab fa-instagram text-red-600"></i>
                  <span>Instagram</span>
                </a>
                <a
                  href={siteConfig.social.tokopedia}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-md bg-white border border-slate-200 text-slate-700 hover:border-emerald-500 hover:text-emerald-700 transition-colors"
                >
                  <i class="fas fa-store text-emerald-600"></i>
                  <span>Tokopedia</span>
                </a>
              </dd>
            </div>
          </dl>
        </aside>
      </div>

      <!-- 4 Pilar Komitmen Operasional -->
      <div class="pt-4 border-t border-slate-200">
        <h2 class="text-xl sm:text-2xl font-montserrat font-bold text-slate-900 mb-5">
          Komitmen Standar Mutu &amp; Pelayanan Kami
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <p class="text-red-600 font-montserrat font-extrabold text-xl mb-1">10.000+ Set</p>
            <h3 class="font-montserrat font-bold text-slate-900 text-sm mb-1">Stok Gudang Mandiri</h3>
            <p class="text-xs text-slate-600 font-roboto leading-relaxed">Siap memenuhi kebutuhan renovasi rumah hingga proyek gedung bertingkat dan kawasan industri.</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <p class="text-red-600 font-montserrat font-extrabold text-xl mb-1">1.8 – 2.0 mm</p>
            <h3 class="font-montserrat font-bold text-slate-900 text-sm mb-1">Pipa Tebal Standar SNI</h3>
            <p class="text-xs text-slate-600 font-roboto leading-relaxed">Las presisi, lurus, dan lolos pemeriksaan fisik sebelum naik ke armada pengiriman.</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <p class="text-red-600 font-montserrat font-extrabold text-xl mb-1">1 – 3 Jam</p>
            <h3 class="font-montserrat font-bold text-slate-900 text-sm mb-1">Pengiriman Armada Sendiri</h3>
            <p class="text-xs text-slate-600 font-roboto leading-relaxed">Armada pikap &amp; truk siaga kirim hari yang sama langsung ke lokasi proyek Jabodetabek.</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <p class="text-red-600 font-montserrat font-extrabold text-xl mb-1">100% COD</p>
            <h3 class="font-montserrat font-bold text-slate-900 text-sm mb-1">Transaksi Aman &amp; Transparan</h3>
            <p class="text-xs text-slate-600 font-roboto leading-relaxed">Barang diperiksa langsung oleh mandor di lokasi proyek, sesuai baru bayar.</p>
          </div>
        </div>
      </div>

      <!-- Area Layanan & CTA -->
      <div class="bg-slate-900 text-white rounded-2xl p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-5">
        <div>
          <h2 class="text-lg sm:text-2xl font-montserrat font-bold mb-1.5">
            Siap Memulai Proyek Bersama Central Scaffolding?
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 font-roboto max-w-xl">
            Konsultasikan kebutuhan set scaffolding Anda secara gratis atau pelajari <a href="/panduan-scaffolding/" class="text-red-400 underline hover:text-red-300">panduan ukuran &amp; cara hitung set</a>.
          </p>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {locations.map((loc) => (
              <a
                href={`/area/${loc.slug}/`}
                class="text-[11px] bg-white/10 hover:bg-red-600 text-slate-200 hover:text-white px-2.5 py-1 rounded-md transition-colors font-roboto"
              >
                {loc.cityName}
              </a>
            ))}
          </div>
        </div>
        <div class="flex flex-wrap gap-2.5 shrink-0">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-3 rounded-xl font-montserrat font-bold text-sm transition-all shadow-md"
          >
            <i class="fab fa-whatsapp text-lg"></i>
            <span>Hubungi WhatsApp</span>
          </a>
          <a
            href="/#products"
            class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white border border-white/25 px-5 py-3 rounded-xl font-montserrat font-bold text-sm transition-all"
          >
            <span>Lihat Katalog</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
