---
import { siteConfig } from '../data/siteConfig';
import SchemaLD from '../components/seo/SchemaLD.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  city?: string;
  coveredDistricts?: string[];
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  city = siteConfig.warehouseAddress.city,
  coveredDistricts = [],
  title = `Sewa & Jual Scaffolding ${city} (Bisa COD) | Ready 10.000+ Set SNI — ${siteConfig.businessName}`,
  description = `Pusat sewa (rental) dan jual beli scaffolding baru & second rekondisi di ${city}. Ready stok ${siteConfig.stats.readyStockSets}, pipa tebal ${siteConfig.stats.pipeThickness} standar SNI, kirim cepat 1-3 jam armada sendiri, bisa bayar COD.`,
  canonicalUrl = Astro.url?.href || siteConfig.siteUrl,
  ogImage = `${siteConfig.siteUrl}/og-banner.jpg`,
} = Astro.props;

const cityLower = city.toLowerCase();
const geoRegion = cityLower.includes('jakarta')
  ? 'ID-JK'
  : cityLower.includes('surabaya')
  ? 'ID-JI'
  : 'ID-BT';

const districtKeywords = coveredDistricts.length > 0 ? `, ${coveredDistricts.join(', ')}` : '';
const seoKeywords = `sewa scaffolding ${city}, jual scaffolding ${city}, rental scaffolding ${city}, sewa steger besi ${city}, harga sewa scaffolding per set, jual scaffolding baru dan bekas, main frame 190, main frame 170, central scaffolding${districtKeywords}`;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#dc2626" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload Hero LCP Image for Instant Mobile Rendering (Core Web Vitals) -->
    <link
      rel="preload"
      as="image"
      href="/assets/video/bg-hero-index-poster.webp?v=20261031"
      type="image/webp"
      fetchpriority="high"
    />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seoKeywords} />
    <meta name="author" content={siteConfig.businessName} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Geo Meta Tags for Local SEO -->
    <meta name="geo.region" content={geoRegion} />
    <meta name="geo.placename" content={city} />
    <meta
      name="geo.position"
      content={`${siteConfig.warehouseAddress.coordinates.latitude};${siteConfig.warehouseAddress.coordinates.longitude}`}
    />
    <meta
      name="ICBM"
      content={`${siteConfig.warehouseAddress.coordinates.latitude}, ${siteConfig.warehouseAddress.coordinates.longitude}`}
    />

    <!-- OpenGraph / Facebook / WhatsApp Preview -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={siteConfig.businessName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${siteConfig.businessName} - Sewa & Jual Beli Scaffolding Standar SNI - Stok Gudang Siap Kirim`}
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts: Montserrat & Roboto (Exact PT SNI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Roboto:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- FontAwesome 6 (Exact PT SNI) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- JSON-LD Structured Data -->
    <SchemaLD city={city} url={canonicalUrl} />
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased selection:bg-red-600 selection:text-white min-h-screen flex flex-col overflow-x-hidden w-full">
    <Navbar city={city} coveredDistricts={coveredDistricts} />
    <main id="main-content" class="flex-grow overflow-x-hidden w-full">
      <slot />
    </main>
    <Footer city={city} />

    <script>
      import { initWhatsAppTracking } from '../utils/analytics';
      initWhatsAppTracking();
    </script>
  </body>
</html>
